        },
    }),
    "audit-corpus-covers-nothing": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_sweep": _CORPUS_SWEEP,
