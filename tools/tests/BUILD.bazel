        "$(rootpath //tools/tests/macro_fixtures:harnesses.expected)",
        "--lines",
        "$(rootpath //tools/tests/macro_fixtures:ex04_files_names)",
        "backup/toy_twice.c,main.c,toy_extra.c,toy_twice.c",
        "--lines",
        "$(rootpath //tools/tests/macro_fixtures:ex06_bin_sources.txt)",
        "unknown",
        "--lines",
        "$(rootpath //tools/tests/macro_fixtures:ex10_bin_sources.txt)",
        "-",
        "--lines",
        "$(rootpath //tools/tests/macro_fixtures:ex19_bin_sources.txt)",
        "toy19.c",
        "--lines",
