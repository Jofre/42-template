# ---------------------------------------------------------------- leak policy
# malloc = True on ex01/ex04 wires the valgrind layer, and it is not decoration.
# Every exercise in this module that hands a caller ownership of a malloc'd node
# carries it -- ex00 creates the node, ex05/ex16 build on ft_create_elem the same
# way ex01 and ex04 do, ex06/ex12 release nodes -- so these two were the only
# holes in an otherwise deliberate policy, with no comment recording a reason.
# That is indistinguishable from an oversight, so treat it as one and close it.
#
# What it buys, concretely: an OUTPUT-IDENTICAL leak. Hoist the ft_create_elem
# call out of the empty/non-empty branch, forget to delete the one still inside
# the empty branch, and you allocate twice and link one -- the orphan is not in
# the list, so nothing that walks the list can see it. Measured on exactly that
# mutant: tests/ex01/expected.txt 7/7 PASS, tests/ex04/expected.txt 7/7 PASS, the
# 400k diff OK and the 200k diff_asan OK for both exercises. Only valgrind says
# "16 bytes in 1 blocks are definitely lost". It has to be valgrind: the ASan
# arms cannot substitute, because tools/rust_diff.sh, tools/asan_run.sh and
# tools/asan_check.sh all export detect_leaks=0 ON PURPOSE, each with a comment
# saying leaks are the valgrind layer's finding and not theirs.
#
# ex04 invites the bug harder than ex01: its empty-list case is naturally an
# early-return branch, which is precisely where a hoisted allocation gets
# stranded. Both fixtures free every node they reach, so a correct
# implementation exits 0 under --error-exitcode -- verified before landing this.
#
# ex01 is also the EARLIEST point in the piscine where the student hands
# ownership of heap memory to a caller, so it is the earliest place where "the
# list prints correctly, therefore my memory is correct" can be shown to be
# false. Landing only one of the two would leave the module's policy half
# consistent, which is worse than either extreme.
c_function(
    num = "01",
    fn = "ft_list_push_front",
    test = "test_list_push_front.c",
    allowed = ["ft_create_elem"],
    deps = [":ft_create_elem"],
    malloc = True,
    hdrs = ["deliverable/ex01/ft_list.h"],
    clues = "clues.tsv",
)

