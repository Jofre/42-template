# targets, the per-exercise :ex04 included). Name them, outside the sandbox:
#   bazel test //c-piscine-reloaded/c-piscine-reloaded:ex04_output \
#       //c-piscine-reloaded/c-piscine-reloaded:ex04_files --spawn_strategy=local
#
# oracle = True: whether each printed line is one of this machine's hardware
# addresses is asked of //oracle (shell01_hwaddr), as in Shell 01 ex04 -- the
# text pattern a check could use instead is a piece of a common answer.
shell_exercise(
    num = "04",
    mode = "check",
    deliverable = "MAC.sh",
    oracle = True,
    tags = ["manual", "env", "no-sandbox"],
)

