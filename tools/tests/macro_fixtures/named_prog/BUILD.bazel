load("//tools:defs.bzl", "c_library", "c_make", "c_levels", "c_program", "corpus_memory", "hand_test", "stderr_ignored", "subject", "unit")
load("//tools:names_file.bzl", "names_file")
load("//tools/tests:analysed.bzl", "analysed")

# Its programs are the data of //tools/tests:macro_fixtures_test.
package(default_visibility = ["//tools/tests:__pkg__"])

# A TOY PROGRAM WHOSE SUBJECT IS DIVIDED INTO NAMED UNITS: its subject()
# contract a project of one unit, toy_root, turned in at the root of
# deliverable/ -- sources in srcs/, its header in includes/, a Makefile that
# says where they are -- the shape every Common Core subject asks for, and
# BSQ's: no "Turn-in directory" line, so no exNN/ folder. Every call names
# the unit (unit = "toy_root"). Invented, like the rest of ../ (see its
# BUILD file), every file under deliverable/ a stub.
#
# What //tools/tests:macro_fixtures_test checks here, on every run:
#
#   * the package loads: c_levels()' audit passed on every test below, each
#     named toy_root_<what> and tagged unit=toy_root, the hand-written replay
#     of a generated corpus included -- which corpus_memory() gave its memory
#     twins from the stem toy_root, the unit's own name, read from the
#     contract (no allowed line: malloc allowed);
#   * a c_library() call on the unit, which is a project, is refused, and
#     :contract_problems holds the message, which names it a project;
#   * the tests and suites emitted are the ones layers.expected lists, each
#     named toy_root_<what> -- c_program's, c_make's, which the audit
#     requires of a unit whose files name a Makefile, the corpus and its
#     twins, and c_levels()' own -- with one suite for the unit, :toy_root;
#     every test carries the contract's grader, "both", as BSQ's and a
#     Common Core project's do (" by:both");
#   * toy_root_bin is a REAL program. The Makefile's recipe names
#     srcs/main.c, and main.c includes toy_root.h, which only `-I includes`
#     finds: so the build staged the subfolders (the whole turn-in tree),
#     took the source from `make -Bn`, and took the include directory from
#     it too (is_program). Without any one of the three it is a stand-in;
#   * the files layer lists the tree by path from the root, never by a
#     basename (:toy_root_files_names), and the Makefile's -I reaches the
#     compile layers, and only that way (:toy_root_bin_includes.txt);
#   * nothing waits on the program's output test, toy_root_output: its one
#     case turns its valgrind arm off, and the corpus waits on no case, so
#     subject()'s finalizer writes an empty list for it
#     (:waiting_toy_root_output, "-" in --lines).
#
# Measured by hand on 2026-10-23 with
#
#     bazel test $(bazel query 'tests(//tools/tests/macro_fixtures/named_prog:*)')
#
# (tagged manual, as every fixture test is): 15 tests, 2 red --
# toy_root_build, its Makefile's recipe only echoing, so it builds no
# toy_root (toy_root_build_exit and _build_rules SKIPping on that), and
# toy_root_diff, the toy printing nothing the reference does, while
# its ASan and memcheck twins are green: the toy neither crashes nor leaks.
# Every other test is green. Re-measure after changing a macro or a runner.
subject(
    grader = "both",
    group = False,
    units = {
        "toy_root": unit(
            page = 1,
            files = ["Makefile"],
            optional = ["**/*.c", "**/*.h"],
            allowed = None,
        ),
    },
)

# Its contract names no allowed functions, so the program may allocate and
# its case would get a valgrind arm (c_program reads that from the
# contract): the case turns it off.
c_program(
    unit = "toy_root",
    name = "toy_root",
    makefile = True,
    no_allocfail = "a toy that proves a root turn-in builds; it allocates nothing",
    cases = [{
        "name": "run",
        "expected": "empty.txt",
        "valgrind": False,
    }],
)

c_make(
    unit = "toy_root",
    artifact = "toy_root",
    not_checked = {
        "recipe": "the toy subject says nothing about how its program compiles",
        "wildcards": "the toy subject does not bind the Norm",
    },
)

# A GENERATED CORPUS, on the program, and its replays under the memory
# checkers, as ../levels' are: the plain replay is hand-written, named
# after the unit it tests, and corpus_memory() gives it its twins. The
# stem is the unit's own name, as a project of one program names its
# corpus: corpus_memory() takes <unit> as it takes <unit>_<what>.
hand_test(
    name = "toy_root_diff",
    layer = "diff",
    srcs = ["//tools:argv_check.sh"],  # one of _CORPUS_RUNNERS
    args = [
        "--bin",
        "$(location :toy_root_bin)",
        "--oracle",
        "$(location //oracle:oracle)",
        "--fn",
        "c06_print_params",
    ] + stderr_ignored("the toy subject asks nothing of it"),
    data = [
        ":toy_root_bin",
        "//oracle:oracle",
    ],
)

corpus_memory(
    stem = "toy_root",
    runner = "//tools:argv_check.sh",
    args = [
        "--oracle",
        "$(location //oracle:oracle)",
        "--fn",
        "c06_print_params",
    ],
    data = ["//oracle:oracle"],
    bin = ":toy_root_bin",
    asan_bin = ":toy_root_bin_asan",
)

# A REFUSAL, WATCHED, as ../'s are (see A REFUSAL, WATCHED in its BUILD
# file): c_library on the project, which has no functions, collects what it
# would have failed the load with, emits nothing, and :contract_problems
# holds it. It calls the unit a project, never an exercise.
_REFUSED = {"library-project": []}

c_library(
    unit = "toy_root",
    refusals = _REFUSED["library-project"],
)

c_levels()

names_file(
    name = "contract_problems",
    names = sorted([
        "named_prog-refused-%s: %s" % (k, " | ".join(v) or "OK")
        for k, v in _REFUSED.items()
    ]),
)

# What c_levels() and the macros emitted, as data: ../named_lib's :layers,
# which says what each word is.
names_file(
    name = "layers",
    names = sorted([
        "%s %s @%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s by:%s kind:%s" % (
            r["name"],
            r["srcs"][0].split(":")[-1],
            [t for t in ["lvl_basic", "lvl_strict", "lvl_robust", "lvl_complete"] if t in r["tags"]][0][4:],
            # The word after the flag (args is a tuple here: no .index).
            "".join([" fn:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--oracle-fn"]),
            "".join([" count:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--count"]),
            "".join([
                " bin:" + r["args"][i + 1][len("$(location "):-1] + "".join([
                    " built:" + h.split("/")[-1]
                    for h in existing_rule(r["args"][i + 1][len("$(location :"):-1])["harness"]
                ]) + "".join([
                    " reader:" + r["args"][j + 1][:-1].split("/")[-1]
                    for j in range(len(r["args"]) - 1)
                    if r["args"][j] == "--harness-src"
                ])
                for i in range(len(r["args"]) - 1)
                if r["args"][i] == "--student-bin" and not r["args"][i + 1].endswith(("_diffbin)", "_diffbin_asan)"))
            ]),
            " any-of" if "--expected-alt" in r["args"] else "",
            " survive" if "--survive" in r["args"] else "",
            " stray" if "--stray" in r["args"] else "",
            " outside" if "--outside" in r["args"] else "",
            " reading" if [i for i in range(len(r["args"]) - 1) if r["args"][i] == "--exit-source" and r["args"][i + 1] == "reading"] else "",
            " argv-file" if "--argv-file" in r["args"] else "",
            " cwd" if "--run-as" in r["args"] else "",
            " ran" if "--show-run" in r["args"] else "",
            " case" if "--case" in r["args"] else "",
            " clues" if "--clues" in r["args"] else "",
            " stable" if "--stable" in r["args"] else "",
            " sanitized" if "--sanitized" in r["args"] else "",
            " sanitize" if "--sanitize" in r["args"] or "--gate-sanitize" in r["args"] else "",
            " memcheck" if "--sample" in r["args"] else "",
            " gated" if "--gate-expected" in r["args"] else "",
            " gate-stdin" if "--gate-stdin" in r["args"] else "",
            "".join([" gate-label:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--gate-label"]),
            "".join([" suite:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--suite"]),
            (" raised:" + (r["env"] or {})["RL_RAISED"]) if "RL_RAISED" in (r["env"] or {}) else "",
            (" make-includes" if "--inc-file" in r["args"] else "") +
            "".join([
                " " + t
                for t in r["tags"]
                if t.startswith("unit=") or (t[:2] == "ex" and t[2:].isdigit())
            ]),
            (r["env"] or {}).get("RL_GRADER", "none"),
            (r["env"] or {}).get("RL_UNIT_KIND", "none"),
        )
        for r in existing_rules().values()
        if r["kind"] == "sh_test"
    ] + [
        "%s suite %s" % (r["name"], " ".join(r["tags"]))
        for r in existing_rules().values()
        if r["kind"] == "test_suite"
    ]),
)

exports_files(["layers.expected"])

# EVERY TOY ANALYSED: each manual target above, its test_suite included,
# as a dependency of this target, which //tools/tests:macro_fixtures_test
# depends on, so a toy naming a label no package declares, or one a macro
# no longer accepts, fails that test's build instead of waiting for
# someone to name it by hand. It builds nothing of them
# (tools/tests/analysed.bzl). The last call of the file, so that it sees
# every test above it. c_levels()' own :manual suite is named by hand: its
# finalizer declares it once the file has been read, and existing_rules()
# here cannot see it yet.
analysed(
    name = "toys_analysed",
    testonly = True,
    deps = sorted([":" + r for r, a in existing_rules().items() if "manual" in (a.get("tags") or [])] + [":manual"]),
)
