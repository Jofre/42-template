# THE SUBJECT CONTRACT (tools/subject.bzl), from each exercise's header box.
subject(
    grader = "both",
    group = False,
    exercises = {
        "00": exercise(page = 8, dir = "ex00/", files = ["ft_strcpy.c"], allowed = []),
        "01": exercise(page = 9, dir = "ex01/", files = ["ft_strncpy.c"], allowed = []),
        "02": exercise(page = 10, dir = "ex02/", files = ["ft_str_is_alpha.c"], allowed = []),
        "03": exercise(page = 11, dir = "ex03/", files = ["ft_str_is_numeric.c"], allowed = []),
        "04": exercise(page = 12, dir = "ex04/", files = ["ft_str_is_lowercase.c"], allowed = []),
        "05": exercise(page = 13, dir = "ex05/", files = ["ft_str_is_uppercase.c"], allowed = []),
        "06": exercise(page = 14, dir = "ex06/", files = ["ft_str_is_printable.c"], allowed = []),
        "07": exercise(page = 15, dir = "ex07/", files = ["ft_strupcase.c"], allowed = []),
        "08": exercise(page = 16, dir = "ex08/", files = ["ft_strlowcase.c"], allowed = []),
        "09": exercise(page = 17, dir = "ex09/", files = ["ft_strcapitalize.c"], allowed = []),
        "10": exercise(page = 18, dir = "ex10/", files = ["ft_strlcpy.c"], allowed = []),
        "11": exercise(page = 19, dir = "ex11/", files = ["ft_putstr_non_printable.c"], allowed = ["write"]),
        "12": exercise(page = 20, dir = "ex12/", files = ["ft_print_memory.c"], allowed = ["write"]),
    },
)

c_function(num = "00", fn = "ft_strcpy", test = "test_strcpy.c", labeled = True, clues = "clues.tsv")

# ft_strcpy WRITES dest: it copies src plus the terminating NUL and must not
# store past strlen(src). This runs it under ASan on an EXACTLY strlen(src)+1
# heap dest (and NUL-terminated exact-size heap src), so an off-by-one copy,
# pad, or terminate — or a stray src over-read — overflows and is caught here
# (output diffing can't see it, since the copied text can still be right).
c_mem_check(num = "00", fn = "ft_strcpy", probe = "mem_strcpy.c")

# Live differential fuzz against the Rust reference (//oracle): 400k seeded
# inputs, exact-byte compare. Cross-checked vs libc strcpy. The dest buffer is
# prefilled with 0xff so a missing terminator diverges instead of hiding behind
# calloc zeros.
c_diff(num = "00", fn = "ft_strcpy", harness = "diff_strcpy.c", oracle_fn = "c02_strcpy", diff_clues = "diff_clues.txt")

c_function(num = "01", fn = "ft_strncpy", test = "test_strncpy.c", labeled = True, escaped_values = True, clues = "clues.tsv")

c_diff(num = "01", fn = "ft_strncpy", harness = "diff_strncpy.c", oracle_fn = "c02_strncpy", diff_clues = "diff_clues.txt")

# ft_strncpy / ft_strlcpy carry an n/size SAFETY bound on dest: they write a
# fixed window and must never store past it. ft_print_memory reads a fixed
# `size` window. These run the function under ASan on EXACTLY-sized heap buffers
# — a stray read/write past the bound is caught here (output diffing can't see
# it, since the returned value/printed text can still be right).
c_mem_check(num = "01", fn = "ft_strncpy", probe = "mem_strncpy.c")

# The is_* predicates run over the WHOLE string (empty string -> 1). Each is
# cross-checked vs the matching libc classifier (isalpha/isdigit/islower/isupper/
# isprint) on unsigned-char bytes; generators bias toward all-pass, one-bad, and
# high-byte inputs so both outcomes are exercised.
c_function(num = "02", fn = "ft_str_is_alpha", test = "test_str_is_alpha.c", labeled = True, clues = "clues.tsv")

# perf_length: every string in the corpus is short, so a loop that measures
# the string again on every step is linear in how many strings there are; the
# length series grows one string of letters (the answer is 1, and every byte
# is read to find it) and reports what doubling it does to one call. It
# starts at 20000, where a linear scan is long enough to time. Reported, never
# gated (finding 044).
c_diff(
    num = "02",
    fn = "ft_str_is_alpha",
    harness = "diff_str_is_alpha.c",
    oracle_fn = "c02_str_is_alpha",
    diff_clues = "diff_clues.txt",
    perf_length = {"oracle_fn": "c02_str_is_alpha_len", "harness": "len_str_is_alpha.c", "base": 20000},
)

c_function(num = "03", fn = "ft_str_is_numeric", test = "test_str_is_numeric.c", labeled = True, clues = "clues.tsv")

c_diff(num = "03", fn = "ft_str_is_numeric", harness = "diff_str_is_numeric.c", oracle_fn = "c02_str_is_numeric", diff_clues = "diff_clues.txt")

c_function(num = "04", fn = "ft_str_is_lowercase", test = "test_str_is_lowercase.c", labeled = True, clues = "clues.tsv")

c_diff(num = "04", fn = "ft_str_is_lowercase", harness = "diff_str_is_lowercase.c", oracle_fn = "c02_str_is_lowercase", diff_clues = "diff_clues.txt")

c_function(num = "05", fn = "ft_str_is_uppercase", test = "test_str_is_uppercase.c", labeled = True, clues = "clues.tsv")

