    fn = "ft_strcmp",
    oracle_fn = "c03_strcmp",
    harness = "diff_strcmp.c",
    unit_expr = "length($1)/2",
    unit_name = "byte",
    # A number, not a reference implementation: it says where you stand without
    # saying how to get there.
    budget = 6,
    syscall_budget = 0,
)

