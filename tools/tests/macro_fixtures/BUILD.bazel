# HOW EACH GUARDED-ARGV PROGRAM IS BUILT: one line per one, "name" and
# "makefile", "missing-makefile" or "srcs", with "+srcs" after a Makefile
# when the sources a stub Makefile leaves to be built are there too
# (makefile = "once_written"). Read by //tools/tests:macro_fixtures_test.
names_file(
    name = "argvguard_builds",
    names = sorted([
        "%s %s%s" % (
            r["name"],
            "makefile" if r.get("makefile") else ("missing-makefile" if r.get("missing_makefile") else "srcs"),
