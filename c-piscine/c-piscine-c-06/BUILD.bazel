# LOAD-BEARING SCENARIO ROWS — do not tidy away "the weird empty argument".
# A row can see the bug this module is really about — printing the newline
# BETWEEN parameters instead of AFTER each one — only if the LAST line that row
# makes the program print is empty. Having an empty argument somewhere is not
# enough: it has to end up last in the printed order. By that test ex01 has
# exactly ONE qualifying row in tests/ex01/scenarios.tsv, ["a","b",""] (its
# other empty-argument row, ["","a b c","end"], prints "end" last and sees
# nothing) — remove it and the exercise keeps reporting all-PASS while that
# check silently stops existing, which is the worst failure a suite can have:
# green locally, KO at the Moulinette, nothing in the table to look at.
# tests/ex02/scenarios.tsv has two, ["","a b c","end"] and ["","x","y"], both
# only because reversing them puts the empty string last.
#
# Why only those rows: argv_table.sh joins a run's stdout LINES with " | "
# (tools/argv_table.sh:164, an awk record walk), and awk counts a trailing
# incomplete line as a record, so a missing FINAL newline is invisible in the
# joined cell unless the last line is empty — which happens only when the last
# parameter printed is the empty string. The two byte streams, joined:
#
#     printf 'a\nb\n\n'  ->  "a | b | "   correct, args a b ""
#     printf 'a\nb\n'    ->  "a | b"      separator bug, same args   (caught)
#     printf 'x\ny\nz\n' ->  "x | y | z"  correct, args x y z
#     printf 'x\ny\nz'   ->  "x | y | z"  separator bug, same args   (invisible)
#
# ex01 prints in argv order, so its empty argument has to come LAST; ex02
# reverses, so its empty argument has to come FIRST. ex03 sorts, and "" sorts
# ahead of everything else, so the only shape that works there is a row of
# nothing BUT empty arguments: ["",""] sorts to "", "" and joins to " | " for a
# correct program against "" for the bug. One empty argument on its own is not
# enough — "\n" and "" both join to the empty cell. The invariant to preserve
# when editing any of these three scenario files is one and the same: keep at
# least one row whose last PRINTED line is empty.
#
# An EXTRA trailing newline needs none of this — it adds an empty record and
# every row sees it. Only the MISSING one is invisible.

# No valgrind arm on any exercise here: these programs are allowed write() and
# nothing else, so none of them can allocate — see the `allowed` rule written out
# in c-piscine/c-piscine-c-00/BUILD.bazel.

# ---------------------------------------------------------------------------
# THE DIFFERENTIAL LAYER, against //oracle's c06 reference.
#
# WHAT IT ADDS OVER THE TABLE ABOVE, which is the only question worth asking of
# a second layer on the same exercise:
#
#   * The table's rows are arguments a person typed. The corpus generates the
#     ones nobody types: an argument that is a single newline, one that ends in
#     one, a pair differing only past the shorter one's end, five arguments
#     drawn from a four-letter alphabet so that ties and near-ties are common.
#   * It compares with `cmp`, on the exact bytes. The table joins a run's stdout
#     LINES with " | ", and the long comment above works out that this makes a
#     MISSING FINAL NEWLINE invisible unless the last printed line happens to be
#     empty -- which is why three scenario files carry a load-bearing row that
#     must not be tidied away. Nothing here depends on that: a byte comparison
#     sees the missing newline in every case, and reports it by name.
#   * ex03's real content is the ORDER, and "ASCII order" is unsigned. The
#     table has no argument with a byte above 0x7f in it, so a comparison
#     written on signed `char` -- which puts 0xff BELOW every letter -- passes
#     it. Measured against a deliberately signed reference: 53 of 200.
#
# `--expect-reordering` on ex02 and ex03: the runner refuses to report OK on a
# corpus in which no case's expected output differs from its arguments in the
# order given, because such a corpus is passed by a program that reverses and
# sorts nothing at all.
#
# lvl_tags("diff") rather than a literal pair: _test(), which derives the level
# ladder from the layer tag for every macro-emitted test, is private to
# defs.bzl and these are hand-written sh_tests. The public lvl_tags() reads the
# same _LAYER_LEVEL, so `diff` moving level moves these with it -- which it
# could not do while the answer was copied into thirteen tag lists.
[
    sh_test(
        name = "ex%s_argv_diff" % num,
        size = "small",
        srcs = ["//tools:argv_check.sh"],
        args = [
            "--bin",
            "$(location :ex%s_bin)" % num,
            "--oracle",
            "$(location //oracle:oracle)",
            "--fn",
            fn,
            "--count",
            "200",
        ] + extra,
        data = [
            ":ex%s_bin" % num,
            "//oracle:oracle",
            "//tools:argv_check.sh",
        ],
        tags = lvl_tags("diff", level = level),
    )
    for num, fn, extra, level in [
        ("01", "c06_print_params", [], None),
        ("02", "c06_rev_params", ["--expect-reordering"], None),
        # ex03 STAYS AT 3 while the layer moved to 2, and it is the only
        # differential in the repo that does.
        #
        # `diff` moved down because a differential catches the signed-char class
        # that every hand-written fixture in this repo is blind to. This corpus
        # catches that class in ex03 too -- and it is also the one place where
        # the disagreement rests on an INTERPRETATION rather than on a sentence.
        # The subject says "sorted in ASCII order" (p.11); ASCII is 0x00-0x7f
        # and says nothing about 0x80-0xff, and the paragraph above measured
        # that ALL 53 of the disagreements a signed comparison produces need a
        # byte >= 0x80. So a student who read "ASCII" literally and compared
        # signed is not wrong by the subject, and gating them at `strict` would
        # fail correct work against a rule this repo inferred.
        #
        # Left where a differential used to sit, it still runs, still reports,
        # and still teaches -- it simply does not gate on a sentence the subject
        # never wrote. That is what the per-test level is for.
        ("03", "c06_sort_params", ["--expect-reordering"], 3),
    ]
]


