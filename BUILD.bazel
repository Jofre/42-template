# Shared test/build tooling lives in //tools (see //tools:defs.bzl).
# This module's exercises are under c-piscine/c-piscine-c-*/BUILD.bazel.

# The files //tools:conventions reads that belong to no module and no package of
# their own: the devcontainer (its setup script, and the Dockerfile whose
# versions the pin checks compare), .bazelversion, the editor's tasks, the root
# BUILD file itself, the top-level docs and rc files, the CHANGELOG a publish
# adds a line to, what .github holds, and the Markdown in a course folder that
# is not a package (cursus/README.md, the exam guide). Everything else it scans
# arrives through a module's :conventions_srcs (emitted by c_levels) or through
# //tools, //tools/tests and //oracle. A glob stops at a package, so a project
# folder with a BUILD file of its own is its c_levels' to declare, not this
# one's.
filegroup(
    name = "conventions_srcs",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        ".bazelrc",
        ".gitignore",
        # Read by the check that a CR a fixture needs survives a commit.
        ".gitattributes",
        ".bazelrc.local.example",
        # The Bazel bazelisk runs, held to tools/pins.tsv.
        ".bazelversion",
        # The editor's tasks, which the rules for what a task runs read.
        ".vscode/tasks.json",
        # README.md links to it, and the rule that a page's links resolve
        # sees, under `bazel test`, only the files declared here and in the
        # other conventions_srcs.
        "LICENSE",
    ] + glob(
        [
            # The top-level Markdown: README.md, AGENTS.md, the CHANGELOG.md
            # a publish adds a line to, and, where the checkout has them, the
            # maintainer's TODO.md (whose TO VERIFY leads conventions holds to
            # a number each) and HISTORY.md, which the template ships without.
            "*.md",
            # The setup script, the Dockerfile whose versions and man pages
            # the pin checks compare, and devcontainer.json, which the rules
            # that read every file read.
            ".devcontainer/**",
            "docs/*.md",
        ],
        allow_empty = False,
    ) + glob(
        [
            "c-piscine/**/*.md",
            "c-piscine-reloaded/**/*.md",
            "cursus/**/*.md",
        ],
        exclude = [
            "**/deliverable/**",
            "**/generators/**",
        ],
        allow_empty = True,
    ) + glob(
        # GitHub's issue forms, pull request template and pages, which ship
        # with the template: its Markdown is read as every page is, and
        # every file by the rules that read them all (a private name, a CR).
        [".github/**"],
        allow_empty = True,
    ) + glob(
        # Every other rc file, which conventions checks for a shared path the
        # way it checks the two above. Never .bazelrc.local: it is per checkout,
        # gitignored, and holds the absolute paths setup.sh chose on purpose.
        [
            ".bazelrc.*",
            "*.bazelrc",
        ],
        allow_empty = True,
        exclude = [
            ".bazelrc.local",
            ".bazelrc.local.example",
        ],
    ),
    visibility = ["//tools/tests:__pkg__"],
)

# The dev container's first-run script, which //tools/tests:selftest runs in a
# toy checkout for the disk cache it gives the container, and the editor's
# tasks, whose default it runs in a toy checkout for the module it finds.
exports_files(
    [
        ".devcontainer/postcreate.sh",
        ".vscode/tasks.json",
    ],
    visibility = ["//tools/tests:__pkg__"],
)

# The page whose table says why a test sits above its layer's level ("Targets
# raised above their layer"), staged beside every test tools/defs.bzl's
# _RAISED lists, whose runner prints that row under a red
# (tools/runner_lib.sh, rl__raised).
exports_files(["docs/reference.md"])

# The page whose list of the shared libraries the fetched tools load from the
# box ("What the harness borrows from the box") //tools/tests:fetched_needed
# holds to the tools themselves.
exports_files(
    ["docs/environment.md"],
    visibility = ["//tools/tests:__pkg__"],
)
