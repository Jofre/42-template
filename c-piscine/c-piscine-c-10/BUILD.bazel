# allocfail: ex02_program_allocfail, at robust, replays cbytes with one of the
# program's malloc() calls refused per run, and ex02_ccarry_program_allocfail
# replays ccarry, a file larger than the other cases. Each asks only that it
# end by itself, within its time, with bounded output. The subject has no
# "handle errors" sentence, so allocfail_rule states the reading this rests
# on -- a reading, which is why it sits at robust, the repo's rigour (TODO.md
# §23, WP-92). No text or status is asserted.
c_program(
    num = "02",
    name = "ft_tail",
    makefile = "once_written",
    model = ["c10_run", "--prog", "ex02_bin", "tail"],
    allocfail = [
        "cbytes",
        "ccarry",
    ],
    allocfail_rule = "The subject has no sentence on errors of this kind. This target " +
                     "reads \"performs the same function as the system command tail\", " +
                     "with malloc allowed, as reaching a refused allocation too: a " +
                     "reading, and the repo's.",
    cases = [
        {
            "name": "cbytes",
            "args": ["-c", "20", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "cbytes.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "cbig",
            "args": ["-c", "100000", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "cbig.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "czero",
            "args": ["-c", "0", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "czero.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "cbin",
            "args": ["-c", "10", "$(location tests/ex02/fixtures/bin.dat)"],
            "fixtures": ["tests/ex02/fixtures/bin.dat"],
            "expected": "cbin.txt",
            "clues": "clues.tsv",
        },
        # Multiple FILEs: tail prints a "==> name <==" header per file, with a
        # blank line before the second and later headers.
        {
            "name": "cmulti",
            "args": [
                "-c",
                "15",
                "$(location tests/ex02/fixtures/multi_a.txt)",
                "$(location tests/ex02/fixtures/multi_b.txt)",
            ],
            "fixtures": [
                "tests/ex02/fixtures/multi_a.txt",
                "tests/ex02/fixtures/multi_b.txt",
            ],
            "expected": "cmulti.txt",
            "clues": "clues.tsv",
        },
        # A file larger than one read buffer (~148 KiB). This catches the
        # program that calls read() exactly ONCE and stops: it tails the wrong
        # bytes because it never saw the end of the file. It does NOT catch the
        # program that loops correctly but keeps no state -- see `ccarry`.
        {
            "name": "clarge",
            "args": ["-c", "20", "$(location tests/ex02/fixtures/big.txt)"],
            "fixtures": ["tests/ex02/fixtures/big.txt"],
            "expected": "clarge.txt",
            "clues": "clues.tsv",
        },
        # The count that cannot be answered out of ONE chunk.
        #
        # Why this case exists: `clarge` above is blind to the most natural way
        # to get ft_tail wrong -- loop over read() but, on each iteration, throw
        # away everything except the last N bytes of the chunk you just read.
        # That is arithmetic, not luck. big.txt is 151552 bytes = 37 * 4096, so
        # 1024/2048/4096 divide it exactly and the final chunk is a full buffer;
        # the awkward sizes leave remainders (6552 at 29000, 20480 at 65536)
        # that are still far larger than 20. Either way the last 20 bytes of the
        # file lie WHOLLY INSIDE the final chunk, so the state-less program and
        # the correct one print the same bytes. Verified: a model of exactly
        # that bug is byte-identical to clarge.txt at BUF = 1024, 4096, 8192,
        # 29000 and 65536.
        #
        # 40000 is above every one of those final-chunk sizes, so the answer
        # provably spans a read boundary: no single chunk contains it, and
        # `allowed` holds no lseek to go back for it, so the program can only
        # get it right if it kept something from the reads it had already done.
        # That is the question tests/ex02/clues.tsv asks of these cases, and until now
        # no layer could tell whether the student had answered it or dodged it.
        # (Deliberately not spelled out here: HOW to keep it. The fixture does
        # not reveal the method and neither should the harness -- AGENTS.md §0.)
        #
        # Known limit, so nobody mistakes this for a total test. The bug hides
        # again whenever the file's LAST chunk is on its own >= 40000 bytes,
        # i.e. whenever (151552 % BUF, or BUF when it divides) >= 40000. That
        # is not a "buffer bigger than half the file" rule -- the escaping
        # sizes are scattered, because they depend on the remainder. Brute
        # forced over every buffer size against this fixture: nothing below
        # 50518 bytes escapes, and every power-of-two buffer from 512 B to
        # 128 KiB is caught (their final chunks run 512..20480). So the case
        # covers the whole range a read loop is realistically written in;
        # closing the rest would need a bigger fixture and buy very little.
        # Keep this paragraph honest if the fixture or the count ever changes,
        # and re-derive it -- the numbers above are specific to both.
        #
        # ccarry.txt was cut from the fixture already in the tree with the tool
        # the exercise imitates: `tail -c 40000 tests/ex02/fixtures/big.txt`
        # (GNU coreutils 8.32), the same generator that reproduces all six
        # other fixtures in this exercise byte-for-byte, cmulti included.
        {
            "name": "ccarry",
            "args": ["-c", "40000", "$(location tests/ex02/fixtures/big.txt)"],
            "fixtures": ["tests/ex02/fixtures/big.txt"],
            "expected": "ccarry.txt",
            "clues": "clues.tsv",
        },
        # No file named: tail reads standard input, which is the one thing the
        # system tool does without a file, so every reading of "the same
        # function" includes it -- basic, like ft_cat's `stdin` (finding 116).
        {
            "name": "stdin",
            "args": ["-c", "20"],
            "stdin": "tests/ex02/fixtures/sample.txt",
            "expected": "cbytes.txt",
            "clues": "clues.tsv",
        },
        # The count attached to the option, `-c20`. strict: the subject names
        # -c and not how its count is written, so this is the reading above
        # (finding 117).
        {
            "name": "attached",
            "level": 2,
            "args": ["-c20", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "cbytes.txt",
            "clues": "clues.tsv",
        },
        # Error paths (findings 110, 115). basic: a name that will not open,
        # before two that do -- the two files' headers and bytes still reach
        # stdout, laid out as when every file opens, and nothing else does.
        # strict, the reading above: the message and status for that name
        # (errmsg, errstatus); and a directory (`.`, the directory the test
        # runs in) as the LAST of several names (dir, dirmsg).
        #
        # Last, because that is the only place the reading above has one
        # answer. What tail -c does after a directory is the filesystem's:
        # where lseek(SEEK_END) on a folder answers (ext4) it dies there and
        # reads no further name; where it does not (tmpfs, 9p, a merged
        # overlayfs folder) it goes on to the next one. Both measured with
        # coreutils 8.32, one folder apart (the model refuses the other
        # order). So neither stopping nor carrying on after a directory is
        # asked of anyone, at any level.
        {
            "name": "errfirst",
            "missing_file": "no_such_file_ex02",
            "invalid_input": True,
            "args": [
                "-c",
                "5",
                "no_such_file_ex02",
                "$(location tests/ex02/fixtures/multi_a.txt)",
                "$(location tests/ex02/fixtures/multi_b.txt)",
            ],
            "fixtures": [
                "tests/ex02/fixtures/multi_a.txt",
                "tests/ex02/fixtures/multi_b.txt",
            ],
            "expected": "errfirst.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "errmsg",
            "missing_file": "no_such_file_ex02",
            "invalid_input": True,
            "level": 2,
            "args": ["-c", "5", "no_such_file_ex02"],
            "stream": "stderr",
            "expected": "errmsg.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "errstatus",
            "missing_file": "no_such_file_ex02",
            "exit": 1,
            "exit_quote": "Create a program called ft_tail, which performs the same function as the system command tail.",
            "level": 2,
            "args": ["-c", "5", "no_such_file_ex02"],
            "expected": "errstatus.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "dir",
            "exit": 1,
            "exit_quote": "Create a program called ft_tail, which performs the same function as the system command tail.",
            "level": 2,
            "args": [
                "-c",
                "5",
                "$(location tests/ex02/fixtures/multi_a.txt)",
                ".",
            ],
            "fixtures": ["tests/ex02/fixtures/multi_a.txt"],
            "expected": "dir.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "dirmsg",
            "invalid_input": True,
            "level": 2,
            "args": [
                "-c",
                "5",
                "$(location tests/ex02/fixtures/multi_a.txt)",
                ".",
            ],
            "fixtures": ["tests/ex02/fixtures/multi_a.txt"],
            "stream": "stderr",
            "expected": "dirmsg.txt",
            "clues": "clues.tsv",
        },
    ],
)

c_make(
    num = "02",
    artifact = "ft_tail",
    rules = [
        "all",
        "clean",
        "fclean",
    ],
    symbols = ["main"],
    quotes = _MAKE_QUOTES,
    recipe = "any",
    recipe_strict = True,
    wildcards = True,
)

# STANDARD INPUT, and "without redirection": whether ft_hexdump reads
# standard input is left open. No case gives it any, and none requires or
# forbids it (tests/ex03/clues.tsv says so too). ft_cat and ft_tail read it
# at basic.
# allocfail: ex03_program_allocfail, at robust, replays dump with one of the
# program's malloc() calls refused per run: the same kind of reading as ex02's
# above, stated in allocfail_rule, the same three questions, the repo's rigour
# (TODO.md §23, WP-92).
c_program(
    num = "03",
    name = "ft_hexdump",
    makefile = "once_written",
    model = ["c10_run", "--prog", "ex03_bin", "hexdump"],
    allocfail = "dump",
    allocfail_rule = "The subject has no sentence on errors of this kind. This target " +
                     "reads \"performs the same function as the system's hexdump " +
                     "command-line tool\", with malloc allowed, as reaching a refused " +
                     "allocation too: a reading, and the repo's.",
    cases = [
        {
            "name": "dump",
            "args": ["$(location tests/ex03/fixtures/sample.bin)"],
            "fixtures": ["tests/ex03/fixtures/sample.bin"],
            "expected": "dump.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "dedup",
            "args": ["$(location tests/ex03/fixtures/dedup.bin)"],
            "fixtures": ["tests/ex03/fixtures/dedup.bin"],
            "expected": "dedup.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "empty",
            "args": ["$(location tests/ex03/fixtures/empty.bin)"],
            "fixtures": ["tests/ex03/fixtures/empty.bin"],
            "expected": "empty.txt",
            "clues": "clues.tsv",
        },
        # The subject requires handling the -C (canonical) option of hexdump.
        {
            "name": "canon",
            "args": ["-C", "$(location tests/ex03/fixtures/sample.bin)"],
            "fixtures": ["tests/ex03/fixtures/sample.bin"],
            "expected": "canon.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "canon_dedup",
            "args": ["-C", "$(location tests/ex03/fixtures/dedup.bin)"],
            "fixtures": ["tests/ex03/fixtures/dedup.bin"],
            "expected": "canon_dedup.txt",
            "clues": "clues.tsv",
        },
        # Bytes > 127 exercise the printable-vs-'.' character column and the
        # little-endian two-byte grouping on high bytes, in both modes.
        {
            "name": "high",
            "args": ["$(location tests/ex03/fixtures/high.bin)"],
            "fixtures": ["tests/ex03/fixtures/high.bin"],
            "expected": "high.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "canon_high",
            "args": ["-C", "$(location tests/ex03/fixtures/high.bin)"],
            "fixtures": ["tests/ex03/fixtures/high.bin"],
            "expected": "canon_high.txt",
            "clues": "clues.tsv",
        },
        # ---- the two line-boundary shapes the fixtures above never reach ----
        #
        # Every fixture above is 30, 69, 20 or 0 bytes long, so NONE of them is
        # a nonzero multiple of 16 and every non-empty one ends on a SHORT final
        # line. Two whole layout rules therefore went unmeasured, and a model
        # hexdump carrying either bug was measured 7/7 green on the cases above.
        #
        # full.bin is 32 bytes: the file ends exactly ON a line boundary, so
        # after the last full line there is nothing left to print. That is the
        # difference between "flush whatever is in the buffer" and "flush it
        # only IF there is anything in it" -- get it wrong and you emit one
        # extra, fully-padded line before the closing offset. empty.bin cannot
        # stand in for this: 0 bytes prints nothing at all, which students
        # short-circuit with an early return that never reaches the flush.
        #
        # dupend.bin is 32 identical bytes: the file ENDS inside a suppressed
        # run. hexdump prints the first line, one '*', and the closing offset --
        # it does NOT reprint the run's last line on the way out. dedup.bin
        # cannot show this, because its '*' run is followed by other data and
        # then a short final line, so the run always gets closed by a line that
        # differs from it.
        #
        # Both are dumped in both modes, because the two modes have separate
        # renderers in every implementation and a rule fixed in one is routinely
        # still broken in the other.
        #
        # All four expected files were produced by the tool the exercise
        # imitates -- `hexdump [-C] FIXTURE`, util-linux 2.37.2 -- which also
        # reproduces the seven fixtures above byte-for-byte, so it is the same
        # generator the rest of this exercise was already trusting.
        {
            "name": "full",
            "args": ["$(location tests/ex03/fixtures/full.bin)"],
            "fixtures": ["tests/ex03/fixtures/full.bin"],
            "expected": "full.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "canon_full",
            "args": ["-C", "$(location tests/ex03/fixtures/full.bin)"],
            "fixtures": ["tests/ex03/fixtures/full.bin"],
            "expected": "canon_full.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "dupend",
            "args": ["$(location tests/ex03/fixtures/dupend.bin)"],
            "fixtures": ["tests/ex03/fixtures/dupend.bin"],
            "expected": "dupend.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "canon_dupend",
            "args": ["-C", "$(location tests/ex03/fixtures/dupend.bin)"],
            "fixtures": ["tests/ex03/fixtures/dupend.bin"],
            "expected": "canon_dupend.txt",
            "clues": "clues.tsv",
        },
        # ---- several files: ONE stream (finding 109) ----
        #
        # hexdump reads the files it is given as one stream: the offsets carry
        # on, a line holds the end of one file and the start of the next, and
        # a run of identical lines collapses into one `*` across a boundary.
        # That is the same function as the tool's, which the subject asks for
        # in so many words, so these are basic. multi_a.bin (18 bytes) and
        # multi_b.bin (7) share their second line; run_a.bin (20 x 'Z') and
        # run_b.bin (44 x 'Z', "end\n") make one run of four identical lines
        # that neither file holds on its own, and multi_b.bin after them ends
        # the last line. Both formats, as above, for the same reason.
        {
            "name": "multi",
            "args": [
                "$(location tests/ex03/fixtures/multi_a.bin)",
                "$(location tests/ex03/fixtures/multi_b.bin)",
            ],
            "fixtures": [
                "tests/ex03/fixtures/multi_a.bin",
                "tests/ex03/fixtures/multi_b.bin",
            ],
            "expected": "multi.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "canon_multi",
            "args": [
                "-C",
                "$(location tests/ex03/fixtures/multi_a.bin)",
                "$(location tests/ex03/fixtures/multi_b.bin)",
            ],
            "fixtures": [
                "tests/ex03/fixtures/multi_a.bin",
                "tests/ex03/fixtures/multi_b.bin",
            ],
            "expected": "canon_multi.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "stream",
            "args": [
                "$(location tests/ex03/fixtures/run_a.bin)",
                "$(location tests/ex03/fixtures/run_b.bin)",
                "$(location tests/ex03/fixtures/multi_b.bin)",
            ],
            "fixtures": [
                "tests/ex03/fixtures/run_a.bin",
                "tests/ex03/fixtures/run_b.bin",
                "tests/ex03/fixtures/multi_b.bin",
            ],
            "expected": "stream.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "canon_stream",
            "args": [
                "-C",
                "$(location tests/ex03/fixtures/run_a.bin)",
                "$(location tests/ex03/fixtures/run_b.bin)",
                "$(location tests/ex03/fixtures/multi_b.bin)",
            ],
            "fixtures": [
                "tests/ex03/fixtures/run_a.bin",
                "tests/ex03/fixtures/run_b.bin",
                "tests/ex03/fixtures/multi_b.bin",
            ],
            "expected": "canon_stream.txt",
            "clues": "clues.tsv",
        },
        # ---- error paths (findings 110, 115) ----
        #
        # basic: a name that will not open, then one that does -- the good
        # file's dump still reaches stdout, and nothing else does. strict, the
        # reading above: the message and status for that name (errmsg,
        # errstatus), and what is printed when not one name opens (allfail).
        {
            "name": "errcont",
            "missing_file": "no_such_file_ex03",
            "invalid_input": True,
            "args": [
                "-C",
                "no_such_file_ex03",
                "$(location tests/ex03/fixtures/sample.bin)",
            ],
            "fixtures": ["tests/ex03/fixtures/sample.bin"],
            "expected": "canon.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "errmsg",
            "missing_file": "no_such_file_ex03",
            "invalid_input": True,
            "level": 2,
            "args": [
                "-C",
                "no_such_file_ex03",
                "$(location tests/ex03/fixtures/sample.bin)",
            ],
            "fixtures": ["tests/ex03/fixtures/sample.bin"],
            "stream": "stderr",
            "expected": "errmsg.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "errstatus",
            "missing_file": "no_such_file_ex03",
            "exit": 1,
            "exit_quote": "Create a program called ft_hexdump, which performs the same function as the system’s hexdump command-line tool, without redirection.",
            "level": 2,
            "args": [
                "-C",
                "no_such_file_ex03",
                "$(location tests/ex03/fixtures/sample.bin)",
            ],
            "fixtures": ["tests/ex03/fixtures/sample.bin"],
            "expected": "canon.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "allfail",
            "missing_file": "no_such_file_ex03",
            "invalid_input": True,
            "level": 2,
            "args": ["-C", "no_such_file_ex03"],
            "stream": "stderr",
            "expected": "allfail.txt",
            "clues": "clues.tsv",
        },
    ],
)

c_make(
    num = "03",
    artifact = "ft_hexdump",
    rules = [
        "all",
        "clean",
        "fclean",
    ],
    symbols = ["main"],
    quotes = _MAKE_QUOTES,
    recipe = "any",
    recipe_strict = True,
    wildcards = True,
