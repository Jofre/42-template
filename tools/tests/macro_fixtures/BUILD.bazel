# What a macro called BEFORE subject() fails with -- asked here, above the
# contract, on purpose; read with the other contract checks in
# :contract_problems below.
_BEFORE_SUBJECT = contract_problem("no_contract", {"macro": "c_function", "num": "00"})

# A toy project's subject contract, as every project opens with one
# (tools/subject.bzl): the macros take every turn-in path, file name and
# grader file from here. Only ex15 and ex18 name an "Allowed functions" line
# (every other toy has allowed = None), so only ex15 has a forbidden layer:
# ex18's every call is refused while loading (see A REFUSAL, WATCHED), so it
# emits nothing, and ex21's rush_common reads the missing line as no layer,
# as c_function does, never as "None" (an empty list, which fails any call).
# A toy turning in at the root of
# deliverable/, with its sources in srcs/ and includes/, is its own package,
# ./root: a root turn-in is a whole repository, so it is a project's only
# exercise. c_levels(), which this package does not call, has a toy module
# of its own, ./levels: what it finds, and the audit it runs on the whole.
subject(
    grader = "moulinette",
    group = False,
    exercises = {
        "00": exercise(page = 1, dir = "ex00/", files = ["toy_twice.c"], allowed = None),
        "01": exercise(page = 1, dir = "ex01/", files = ["toy_twice.c"], allowed = None),
        "02": exercise(page = 1, dir = "ex02/", files = ["toy_twice.c"], allowed = None),
        "03": exercise(page = 1, dir = "ex03/", files = ["toy_twice.c"], optional = ["toy.h"], allowed = None),
        "04": exercise(page = 1, dir = "ex04/", files = ["toy_twice.c"], allowed = None),
        "05": exercise(page = 1, dir = "ex05/", files = ["toy_twice.c"], allowed = None),
        "06": exercise(page = 1, dir = "ex06/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        "07": exercise(page = 1, dir = "ex07/", files = ["toy.h"], allowed = None),
        "08": exercise(page = 1, dir = "ex08/", files = ["Makefile"], allowed = None),
        "09": exercise(page = 1, dir = "ex09/", files = ["toy.sh"], allowed = None),
        "10": exercise(page = 1, dir = "ex10/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        "11": exercise(page = 1, dir = "ex11/", files = ["toy.c"], allowed = None),
        # Rush 01's shape: the .c files flat ("cc *.c"), a header anywhere.
        "12": exercise(page = 1, dir = "ex12/", files = [], optional = ["*.c", "**/*.h"], allowed = None),
        "13": exercise(page = 1, dir = "ex13/", files = [], optional = ["*.c", "**/*.h"], allowed = None),
        # C 09 ex01's shape: a Makefile alone, and the grader brings a file in
        # a subfolder of the turn-in.
        "14": exercise(
            page = 1,
            # A comment is not the contract: first_red read this line's
            # dir = None and took the root for this exercise's folder.
            dir = "ex14/",
            files = ["Makefile"],
            provided = {"tests/ex14/grader/srcs/toy.c": "srcs/toy.c"},
            allowed = None,
        ),
        # C 12's shape: the grader links a function of its own, compiled from
        # Rust (tools/grader_lib.bzl), which the harness calls. "None" allowed,
        # as C 12 ex02 says, so that it has a forbidden layer: that layer and
        # the symbols layer are told the grader brings toy_base (--provided).
        "15": exercise(
            page = 1,
            dir = "ex15/",
            files = ["toy_twice.c"],
            linked = {"toy_base": "//tools/tests/macro_fixtures:toy_grader"},
            allowed = [],
        ),
        # C 12's and C 13's other shape: a header the student turns in, whose
        # structure the subject prints (tests/layout/toy.h, and its names in
        # tests/layout/tag/toy.h). ex16 from ex01 on, where the grader links a
        # function of its own; ex17 as ex00, where it does not.
        "16": exercise(
            page = 1,
            dir = "ex16/",
            files = ["toy_twice.c", "toy.h"],
            linked = {"toy_base": "//tools/tests/macro_fixtures:toy_grader"},
            allowed = None,
        ),
        "17": exercise(page = 1, dir = "ex17/", files = ["toy_twice.c", "toy.h"], allowed = None),
        # A program that may open files: what c_program asks of its cases.
        "18": exercise(page = 1, dir = "ex18/", files = ["toy_reader.c"], allowed = ["open", "read", "write", "close"]),
        # BSQ's and Rush 02's shape: "Makefile and all the necessary files".
        "19": exercise(page = 1, dir = "ex19/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        # C 10's shape: the same file list, and a program built from its
        # sources directly, beside a c_make for the Makefile.
        "20": exercise(page = 1, dir = "ex20/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        # Rush 00's shape: two files every variant shares, a variant, and
        # any other .c a team writes for a bonus of its own.
        "21": exercise(page = 1, dir = "ex21/", files = ["main.c", "ft_putchar.c"], optional = ["rush03.c", "*.c"], allowed = None),
        # A Makefile the contract only allows: what c_make and c_program
        # refuse to build from (contract_problem("make_anchor"), and
        # c_program's refusal below; finding 124). Nothing is declared for it.
        "22": exercise(page = 1, dir = "ex22/", files = [], optional = ["Makefile", "**/*.c"], allowed = None),
        # A script turn-in that reads a file at a path its toy subject fixes,
        # the shape of Shell 01 ex07: shell_exercise's redirect.
        "23": exercise(page = 1, dir = "ex23/", files = ["toy.sh"], allowed = None),
        # A program built by its Makefile whose runs are an argument table
        # (C 06's shape, with a Makefile): c_argv_table's guarded replay is
        # built through the same Makefile.
        "24": exercise(page = 1, dir = "ex24/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        # Functions whose subject names malloc, and free: what c_function's
        # `malloc` may not turn off (contract_problem("function_malloc")).
        # No macro is called on them.
        "25": exercise(page = 1, dir = "ex25/", files = ["toy_dup.c"], allowed = ["malloc"]),
        "26": exercise(page = 1, dir = "ex26/", files = ["toy_drop.c"], allowed = ["free"]),
        # C 10's shape again, its program c_program(makefile =
        # "once_written"): the Makefile decides once it compiles anything,
        # and until then the folder's sources are the program.
        "27": exercise(page = 1, dir = "ex27/", files = ["Makefile"], optional = ["**/*.c", "**/*.h"], allowed = None),
        "28": exercise(page = 1, dir = "ex28/", files = ["Makefile"], optional = ["**/*.c", "**/*.h"], allowed = None),
        # ex27's shape again, run through an argument table (C 06's runs):
        # the guarded-argv replay builds what the graded program builds.
        "29": exercise(page = 1, dir = "ex29/", files = ["Makefile"], optional = ["**/*.c", "**/*.h"], allowed = None),
        # Three toy libraries (`functions`, a box per function), for what
        # c_library and the member macros refuse (A REFUSAL, WATCHED) and
        # what the audit holds a library to (contract_problem("audit")).
        # No call here emits anything: ./levels ex12 is the toy that does.
        # A library whose boxes differ: toy_b's allows malloc, toy_a's
        # nothing, and `allowed` is their union.
        "30": exercise(
            page = 1,
            dir = "ex30/",
            files = ["Makefile"],
            optional = ["toy_*.c"],
            allowed = ["malloc"],
            functions = {
                "toy_a": [],
                "toy_b": ["malloc"],
            },
        ),
        # Functions with no Makefile to build them into a library.
        "31": exercise(page = 1, dir = "ex31/", files = ["toy_a.c"], allowed = [], functions = {"toy_a": []}),
        # A function whose name makes its memcheck test another layer's.
        "32": exercise(page = 1, dir = "ex32/", files = ["Makefile"], optional = ["toy_*.c"], allowed = [], functions = {"toy_probe": []}),
    },
)

