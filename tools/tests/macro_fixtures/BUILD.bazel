# WHAT THE MACROS EMITTED, as data: one line per test, "name runner", with
# " gated" after a NOT TURNED IN test that SKIPs unless NO_SKIP=1, " staged"
# after a compile layer handed a header in a subfolder of the turn-in to
# stage and keep OFF its include path (--staged-hdr: the grader's path has no
# such folder on it), " make-includes" after one that compiles with the
# -I its Makefile passes (--inc-file), " built" after a files layer that
# reads which .c files the Makefile compiles (--built), " grader-lib" after
# one handed a library the grader links (--lib32, --lib: the contract's
# `linked`),
# " provided" after one told what the grader brings (--provided: a function,
# to the forbidden and symbols layers, from `linked` or `provided`; a file,
# to the files layer), " layout" after one handed the subject's structure
# (--layout, tests/layout/<h>), " layout-tag" after one handed its names
# (--layout-tag, tests/layout/tag/<h>), " strict" after an output or
# prototype test at strict and not basic (a c_function reading, a
# structure's exNN_layout_prototype twin), and last " by:" and the RL_GRADER
# its environment holds -- the contract's `grader`, which tools/defs.bzl's
# _test() hands every test and every runner words its costs from ("at the
# Moulinette", "at the defense"). A test without it would say "wherever this
# project is graded" while staying green, so the listing is where its absence
# goes red: this toy is graded by the Moulinette, ./root by both and ./levels
# at a defense. After it, on a named case's output test, " reads:" and the
# files its case_reads tag lists, which c_levels()' audit holds to a test that
# keeps a directory's files to //oracle: a tag that stopped being written
# would leave that audit nothing to check, and is red here instead. Read by
# //tools/tests:macro_fixtures_test against layers.expected beside this file, so a
# layer that stops being "not turned in" where nothing was turned in -- or
# starts being one where the files are there -- is a red test, not something
# a person has to notice in a status list. Built last, so every test above is
# in existing_rules().
names_file(
    name = "layers",
    names = sorted([
        "%s %s%s%s%s%s%s%s%s%s%s%s by:%s%s" % (
            r["name"],
            r["srcs"][0].split(":")[-1],
            # The programs a files layer fails a file named after (c_files'
            # --program: c_program's name, c_make's artifact).
            "".join([" program:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--program"]),
            " gated" if "--gated" in r["args"] else "",
            " staged" if "--staged-hdr" in r["args"] else "",
            " make-includes" if "--inc-file" in r["args"] else "",
            " built" if "--built" in r["args"] else "",
            " grader-lib" if "--lib32" in r["args"] or "--lib" in r["args"] else "",
            " provided" if "--provided" in r["args"] else "",
            " layout" if "--layout" in r["args"] else "",
            " layout-tag" if "--layout-tag" in r["args"] else "",
            " strict" if (r["srcs"][0].endswith(("diff_output.sh", "prototype_check.sh")) and
                          "lvl_strict" in r["tags"] and "lvl_basic" not in r["tags"]) else "",
            (r["env"] or {}).get("RL_GRADER", "none"),
            "".join([" reads:" + t[len("case_reads="):] for t in (r["tags"] or []) if t.startswith("case_reads=")]),
        )
        for r in existing_rules().values()
        if r["kind"] == "sh_test"
    ]),
)

exports_files(["layers.expected"])

# EVERY PROGRAM BUILT FROM A STUDENT'S FILES, and what it says about the
# signatures it calls: one line per student_binary, "name" and then
# "prototype_test=<test>" (or "=none") from its tag where it links a harness,
# "UNTAGGED" where it links one and has no tag, and "own program" where it
# links none. _student_bin writes the tag and c_levels()' audit reads it, and
# the audit's own arms above are fed dicts by hand; this is where a tag that
# stopped being written -- on an output fixture, a memory probe or any other
# harness -- goes red. Read by //tools/tests:macro_fixtures_test against
# harnesses.expected. Built last, with :layers.
#
# A guarded-argv build (c_argv_table) adds " builds as exNN_bin_asan" where
# it compiles what that program compiles -- its sources, headers, Makefile
# and the tree staged beside it -- and " BUILDS OTHER FILES" where it does
# not: it read the Makefile's tree from a glob of its own once, which could
# come to differ from the graded program's (review of W5-H).
names_file(
    name = "harnesses",
    names = sorted([
        "%s %s%s" % (
            r["name"],
            ([t for t in (r["tags"] or []) if t.startswith("prototype_test=")] or ["UNTAGGED"])[0] if r["harness"] else "own program",
            "" if not r["name"].endswith("_argvguard_bin_asan") else (
                " builds as " + r["name"].replace("_argvguard", "") if all([
                    (existing_rules().get(r["name"].replace("_argvguard", "")) or {}).get(a) == r.get(a)
                    for a in ["srcs", "hdrs", "makefile", "make_data", "missing_makefile"]
                ]) else " BUILDS OTHER FILES"
            ),
        )
        for r in existing_rules().values()
        if r["kind"] == "student_binary"
    ]),
)

exports_files(["harnesses.expected"])

# WHO READS A FILE THE CONTRACT DOES NOT NAME: one line per rule of this
# package, and per attribute of it, that mentions ex04's stray main.c or
# toy_extra.c -- a source, a header, a data file, an argument. None may: every
# layer compiles the contract's file set (tools/defs.bzl's _turnin_files),
# and ex04_files reports the two by name from a list of NAMES, which carries
# no label (names_file). Before, the norm, compile, forbidden, prototype,
# symbols, ilp32 and memory-probe layers all globbed the folder. Checked by
# //tools/tests:macro_fixtures_test (--lines, none). Built last, with :layers.
# The two files by their path, built from the contract's folder: a literal
# turn-in path in this file is //tools:conventions' to refuse, and
# turnin_file() refuses these two by design -- the contract does not let
# ex04 hold them.
_EX04_STRAYS = [turnin_dir("04") + "/" + n for n in ["main.c", "toy_extra.c"]]

names_file(
    name = "stray_reads",
    names = sorted([
        "%s %s" % (r["name"], a)
        for r in existing_rules().values()
        for a in sorted(r.keys())
        if a not in ["name", "generator_name", "generator_function", "generator_location"] and
           [f for f in _EX04_STRAYS if f in str(r[a])]
    ]),
)

