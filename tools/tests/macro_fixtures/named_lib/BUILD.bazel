load("//tools:defs.bzl", "c_cycles", "c_diff", "c_function", "c_levels", "c_library", "c_mem_check", "subject", "unit")
load("//tools:names_file.bzl", "names_file")
load("//tools/tests:analysed.bzl", "analysed")

# Its programs are the data of //tools/tests:macro_fixtures_test.
package(default_visibility = ["//tools/tests:__pkg__"])

# A TOY LIBRARY WHOSE SUBJECT IS DIVIDED INTO NAMED UNITS: a subject()
# contract of units (units = {...}). The library is the unit libtoy, turned
# in at the root of deliverable/, and each of its functions is a unit of its
# own, which every call names by itself (unit = "toy_len"). Invented, like
# the rest of ../ (see its BUILD file), every file under deliverable/ a stub.
#
# What //tools/tests:macro_fixtures_test checks here, on every run:
#
#   * the package loads: c_levels()' audit passed on every test below, each
#     named <unit>_<what> after the unit it tests and tagged with that unit
#     alone (" unit="), a function's with the function, none with an
#     exercise's exNN; and toy_cat's two raises are listed in
#     tools/defs_levels.bzl's _RAISED;
#   * the tests and suites emitted are the ones layers.expected lists:
#     the library's own, libtoy_*, and each function's, toy_len_*,
#     toy_dup_* and toy_cat_* -- runner, level, gates and arguments --
#     with one suite per unit (:libtoy, :toy_cat, :toy_dup, :toy_len)
#     selecting its unit= tag, and every output test that hands its runner
#     a waiting list handing it its unit's suite too (" suite:", --suite),
#     which a red's waiting block names;
#   * each function has exactly its own tests, read from the unit= tags the
#     macros gave them (unit_tests), and every gated layer of toy_len and
#     of toy_cat waits for that function's own output test, never the
#     library's (their waiting lists, --lines);
#   * each function's program runs its own main, from tests/<function>/
#     (is_program), and :unit_strays lists no test or program of a function
#     that reads another unit's files, runs another unit's program or waits
#     for another unit's output test.
#
# Measured by hand on 2026-10-22 with
#
#     bazel test $(bazel query 'tests(//tools/tests/macro_fixtures/named_lib:*)')
#
# (tagged manual, as every fixture test is): 45 tests, 7 red --
# libtoy_build, its stub Makefile building no libtoy.a;
# libtoy_declares_output, its toy_lib.h declaring nothing yet, as a stub's
# may; and toy_len_diff, toy_cat_diff,
# toy_cat_readings, toy_dup_diff and toy_dup_readings, the toys returning 0
# or NULL where each borrowed arm's reference does not. toy_len_perf and
# toy_cat_perf SKIP on those reds, both toy_cat allocfail tests SKIP (the
# toy reports failure with nothing injected), libtoy_build_exit and
# _build_rules SKIP on libtoy_build, and every other test is green.
# Re-measure after changing a macro or a runner.
subject(
    grader = "defense",
    group = False,
    units = {
        # A function per box, each box with its own External Functions
        # (`functions`).
        "libtoy": unit(
            page = 1,
            files = [
                "Makefile",
                "toy_lib.h",
            ],
            optional = ["toy_*.c"],
            allowed = ["malloc", "free"],
            functions = {
                "toy_cat": ["malloc", "free"],
                "toy_dup": ["malloc"],
                "toy_len": [],
            },
        ),
    },
)

# What is the whole library's, once: its targets are libtoy_*, and its own
# files are under tests/libtoy/. Its tests/libtoy/prototype.h includes the
# library's header, so the names it prints are a file of their own,
# prototype_names.h, which includes nothing.
c_library(
    unit = "libtoy",
    artifact = "libtoy.a",
    prototype_names = "prototype_names.h",
    globals = "Toy, p.1: \"No variable lives outside a function.\"",
    # One sentence per function: each red quotes its own function's.
    function_lists = {
        "toy_cat": "Toy, p.2, toy_cat's box: \"malloc, free\"",
        "toy_dup": "Toy, p.2, toy_dup's box: \"malloc\"",
        "toy_len": "Toy, p.2, toy_len's box: \"None\"",
    },
    restrict_rule = "Toy, p.1: \"No restrict in your own prototypes.\"",
    declares_reading = "Toy, p.1, Files to turn in: \"Makefile, toy_lib.h, toy_*.c\"",
    helpers_rule = "Toy, p.1: \"Each helper is static, in the file that uses it.\"",
    make = {
        "not_checked": {
            "recipe": "the toy subject says nothing about how its library compiles",
            "wildcards": "the toy subject does not bind the Norm",
        },
    },
)

# Every member macro on one function, each called by the function's own
# name: c_function, c_mem_check, c_diff (and the c_perf it hands the unit
# on to) and c_cycles. Every target is toy_len_*, every file under
# tests/toy_len/.
c_function(
    unit = "toy_len",
    test = "test_toy_len.c",
    clues = "clues.tsv",
)

c_mem_check(
    unit = "toy_len",
    probe = "mem_toy_len.c",
)

c_diff(
    unit = "toy_len",
    harness = "diff_toy_len.c",
    oracle_fn = "c05_iter_factorial",
    count = 40,
    asan_count = 30,
    perf_count = 40,
)

c_cycles(
    unit = "toy_len",
    oracle_fn = "c05_iter_factorial",
    harness = "diff_toy_len.c",
    count = 40,
)

# A function whose own box allows malloc, which keeps its leak layer
# (toy_dup_valgrind), and a reading with a reader of its own: its target
# runs toy_dup_readingsbin, built from diff_toy_dup_readings.c, and has no
# ASan twin.
c_function(
    unit = "toy_dup",
    test = "test_toy_dup.c",
    clues = "clues.tsv",
    malloc = True,
)

c_diff(
    unit = "toy_dup",
    harness = "diff_toy_dup.c",
    oracle_fn = "c05_iter_factorial",
    count = 40,
    asan_count = 30,
    perf = False,
    readings = {
        "count": 50,
        "harness": "diff_toy_dup_readings.c",
        "oracle_fn": "c05_rec_factorial",
    },
)

# A function with every per-function knob the others leave out: readings
# of its own (c_function's, a case raised to strict; c_diff's, a corpus
# raised to robust), the allocation-failure sweep and its leak twin, and
# c_diff's perf with a length series. Every gate is its own toy_cat_output.
c_function(
    unit = "toy_cat",
    test = "test_toy_cat.c",
    malloc = True,
    allocfail = "af_toy_cat.c",
    allocfail_rule = "the toy subject, p.1: \"Return NULL if the allocation fails.\"",
    allocfail_leaks = True,
    readings = [
        {
            "name": "open",
            "main": "test_toy_cat_open.c",
            "expected": "open.txt",
            "level": 2,
        },
    ],
)

c_diff(
    unit = "toy_cat",
    harness = "diff_toy_cat.c",
    oracle_fn = "c05_iter_factorial",
    count = 40,
    asan_count = 30,
    perf_count = 40,
    perf_length = {"oracle_fn": "c02_str_is_alpha_len", "harness": "len_toy_cat.c"},
    readings = {
        "count": 50,
        "level": 3,
        "oracle_fn": "c05_rec_factorial",
    },
)

c_levels()

# What c_levels() and the macros emitted, as data: ../levels' :layers, with
# three more words. Every unit= tag a test carries, and any exercise tag
# (exNN), which a test of a package of units must not carry; " suite:" and
# the suite an output test hands its runner (--suite), the one a red's
# waiting block tells the reader to run; and last, after " by:", " kind:"
# and the RL_UNIT_KIND its environment holds: the kind of the unit its name
# begins with, or "project" for a test of the whole project, which
# tools/defs_test.bzl's _test() hands every test of a contract of units and the
# runners word what they test by ("this library's own case"). A test
# without it would say "exercise" while staying green, so its absence goes
# red here, as "none".
names_file(
    name = "layers",
    names = sorted([
        "%s %s @%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s by:%s kind:%s" % (
            r["name"],
            r["srcs"][0].split(":")[-1],
            [t for t in ["lvl_basic", "lvl_strict", "lvl_robust", "lvl_complete"] if t in r["tags"]][0][4:],
            # The word after the flag (args is a tuple here: no .index).
            "".join([" fn:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--oracle-fn"]),
            "".join([" count:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--count"]),
            "".join([
                " bin:" + r["args"][i + 1][len("$(location "):-1] + "".join([
                    " built:" + h.split("/")[-1]
                    for h in existing_rule(r["args"][i + 1][len("$(location :"):-1])["harness"]
                ]) + "".join([
                    " reader:" + r["args"][j + 1][:-1].split("/")[-1]
                    for j in range(len(r["args"]) - 1)
                    if r["args"][j] == "--harness-src"
                ])
                for i in range(len(r["args"]) - 1)
                if r["args"][i] == "--student-bin" and not r["args"][i + 1].endswith(("_diffbin)", "_diffbin_asan)"))
            ]),
            " any-of" if "--expected-alt" in r["args"] else "",
            " survive" if "--survive" in r["args"] else "",
            " stray" if "--stray" in r["args"] else "",
            " outside" if "--outside" in r["args"] else "",
            " reading" if [i for i in range(len(r["args"]) - 1) if r["args"][i] == "--exit-source" and r["args"][i + 1] == "reading"] else "",
            " argv-file" if "--argv-file" in r["args"] else "",
            " cwd" if "--run-as" in r["args"] else "",
            " ran" if "--show-run" in r["args"] else "",
            " case" if "--case" in r["args"] else "",
            " clues" if "--clues" in r["args"] else "",
            " stable" if "--stable" in r["args"] else "",
            " sanitized" if "--sanitized" in r["args"] else "",
            " sanitize" if "--sanitize" in r["args"] or "--gate-sanitize" in r["args"] else "",
            " memcheck" if "--sample" in r["args"] else "",
            " gated" if "--gate-expected" in r["args"] else "",
            " gate-stdin" if "--gate-stdin" in r["args"] else "",
            "".join([" gate-label:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--gate-label"]),
            "".join([" suite:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--suite"]),
            (" raised:" + (r["env"] or {})["RL_RAISED"]) if "RL_RAISED" in (r["env"] or {}) else "",
            (" make-includes" if "--inc-file" in r["args"] else "") +
            "".join([
                " " + t
                for t in r["tags"]
                if t.startswith("unit=") or (t[:2] == "ex" and t[2:].isdigit())
            ]),
            (r["env"] or {}).get("RL_GRADER", "none"),
            (r["env"] or {}).get("RL_UNIT_KIND", "none"),
        )
        for r in existing_rules().values()
        if r["kind"] == "sh_test"
    ] + [
        "%s suite %s" % (r["name"], " ".join(r["tags"]))
        for r in existing_rules().values()
        if r["kind"] == "test_suite"
    ]),
)

# WHAT A FUNCTION'S TESTS POINT AT, beyond their names and tags (which
# :layers shows): every test of a function unit, and every program named
# after one, reads its files under tests/<function>/ alone, names no
# program of another unit and waits for no output test but its own. One
# line per word that does not -- "<target> <word>" -- and
# macro_fixtures_test wants none. The library's -I list
# (:libtoy_make_bin_includes.txt) is the whole library's, and every
# function's layers that compile the sources read it.
_UNITS = ["libtoy", "toy_cat", "toy_dup", "toy_len"]

names_file(
    name = "unit_strays",
    names = sorted([
        "%s %s" % (r["name"], x)
        for r in existing_rules().values()
        if r["kind"] == "sh_test"
        for m in [t[len("unit="):] for t in r["tags"] if t.startswith("unit=")]
        if m != "libtoy"
        for a in r["args"]
        if a.startswith("$(location ")
        for x in [a[len("$(location "):-1]]
        if x != ":libtoy_make_bin_includes.txt" and [
            u
            for u in _UNITS
            if u != m and (x.startswith(":%s_" % u) or x.startswith("tests/%s/" % u))
        ]
    ] + [
        "%s --gate-label %s" % (r["name"], r["args"][i + 1])
        for r in existing_rules().values()
        if r["kind"] == "sh_test"
        for m in [t[len("unit="):] for t in r["tags"] if t.startswith("unit=")]
        if m != "libtoy"
        for i in range(len(r["args"]) - 1)
        if r["args"][i] == "--gate-label" and not r["args"][i + 1].startswith(m + "_")
    ] + [
        "%s %s" % (r["name"], h)
        for r in existing_rules().values()
        if r["kind"] == "student_binary"
        for m in _UNITS
        if m != "libtoy" and r["name"].startswith(m + "_")
        for h in r["harness"]
        if [u for u in _UNITS if u != m and "tests/%s/" % u in h]
    ]),
)

exports_files(["layers.expected"])

# EVERY TOY ANALYSED: each manual target above, its test_suite included,
# as a dependency of this target, which //tools/tests:macro_fixtures_test
# depends on, so a toy naming a label no package declares, or one a macro
# no longer accepts, fails that test's build instead of waiting for
# someone to name it by hand. It builds nothing of them
# (tools/tests/analysed.bzl). The last call of the file, so that it sees
# every test above it. c_levels()' own :manual suite is named by hand: its
# finalizer declares it once the file has been read, and existing_rules()
# here cannot see it yet.
analysed(
    name = "toys_analysed",
    testonly = True,
    deps = sorted([":" + r for r, a in existing_rules().items() if "manual" in (a.get("tags") or [])] + [":manual"]),
)
