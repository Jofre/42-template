        )
        for r in existing_rules().values()
        if r["name"].endswith("_argvguard_bin_asan")
    ]),
)

# This file, for //tools/tests:conventions: a package with a turn-in, so its
# BUILD file is held to the same rules as a module's.
filegroup(
    name = "conventions_srcs",
    srcs = ["BUILD.bazel"] + glob([
        "grader/*.rs",
        # The toys' C, for the checks that read every C file of the harness:
        # a function a contract turns in, or the grader brings, is never
        # written outside the zone.
        "tests/**/*.c",
        "tests/**/*.h",
    ]),
)
