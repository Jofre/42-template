_RULES = existing_rules()

# EVERY TOY ANALYSED: each manual target above, its test_suite included, as
# a dependency of a target that is not manual, so a toy naming a label no
# package declares, or one a macro no longer accepts, fails the build
# instead of waiting for someone to name it by hand. testonly, since most of
# them are tests; it builds nothing of them (tools/tests/analysed.bzl).
analysed(
    name = "toys_analysed",
    testonly = True,
    deps = sorted([":" + r for r, a in _RULES.items() if "manual" in a.get("tags", [])]),
)

names_file(
    name = "knobs",
    names = [
        "%s: %s %s = %s" % (knob, rule, query, (
            "not declared" if rule not in _RULES else _RULES[rule]["kind"] if query == "kind" else (
                ",".join([
                    _RULES[rule]["args"][i + 1]
                    for i in range(len(_RULES[rule]["args"]) - 1)
                    if _RULES[rule]["args"][i] == query
                ]) or "absent"
            ) if query.startswith("--") else (
                "present" if query[1:] in _RULES[rule]["args"] else "absent"
            ) if query.startswith("?") else (
                ",".join(sorted([
                    str(v)
                    for v in (_RULES[rule].get(query.partition(":")[0]) or [])
                    if query.partition(":")[2] in str(v)
                ])) or "none"
            )
        ))
        for knob, rule, query in _PROBES
    ],
)

exports_files(["knobs.expected"])

# This file, for //tools/tests:conventions: a package with a turn-in, so its
# BUILD file is held to the same rules as a module's. And the toys' C, for
# the checks that read every C file outside the zone: a header that sends
# its reader to tools/diffio.h includes it.
filegroup(
    name = "conventions_srcs",
    srcs = ["BUILD.bazel"] + glob([
        "tests/**/*.c",
        "tests/**/*.h",
    ]),
)

# Its turn-in folders as the macros compute them, for first_red's reading of
# the contract above (see ../BUILD.bazel's :turnin_dirs).
names_file(
    name = "turnin_dirs",
    names = ["ex%s %s" % (n, turnin_dir(n)) for n in ["00", "01", "02", "03", "04", "05", "06", "07", "08", "09"]],
)

# Its mandatory part as the macros read it: none, for a contract that names
# none, which first_red --written must read as none.
names_file(
    name = "mandatory",
    names = mandatory_exercises(),
)
