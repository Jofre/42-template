# ---------------------------------------------------------------------------
# The whole comparison against the Rust reference (//oracle), one exec per
# number: the same corpora, every difference shown.
#
# TAGGED `manual` ON PURPOSE, so it never runs under `bazel test //...` and never
# gates a submission. Run it yourself once you have an implementation:
#
#     bazel test //c-piscine/c-piscine-rush-02:ex00_rush02_diff --test_output=all
#
# The subject fixes four outputs and no composition rule -- it never settles
# whether 101 is "one hundred one" or "one hundred and one", and bonus 1 allows
# "-", "," and "and" outright. So the reference implements ONE reading (the one
# the subject's own transcripts demonstrate) and a disagreement here is evidence
# to read, not a verdict. Gating on it would fail teams for answering a question
# the subject deliberately left to them -- the same reason rush-01 validates
# rather than byte-diffs. What no reading explains gates above, at strict.
#
# It exists because the subject's four examples cannot reach the interesting
# ground: every value past 4294967295, every carry across a scale boundary, and
# every group whose hundreds digit is zero live beyond them. The corpus sweeps
# every length up to 42 digits -- duodecillion (10^39), the key ref.dict adds
# to 42's numbers.dict, which stops at undecillion, reaches 10^42 - 1 -- and
# past them.
hand_test(
    name = "ex00_rush02_diff",
    layer = "diff",
    tags = ["manual"],
    size = "medium",
    srcs = ["//tools:rush02_check.sh"],
    args = [
        "--bin",
        "$(location :ex00_bin)",
        "--dict",
        "$(location tests/ex00/fixtures/ref.dict)",
        "--oracle",
        "$(location //oracle:oracle)",
        "--count",
        "200",
    ] +
    # A choice at every call (tools/defs.bzl's _RUNNER_CHOICES), and the Run
    # contract's: ignored, unless the subject requires something of it.
    stderr_ignored("Rush 02's subject names no message for standard error"),
    data = [
        ":ex00_bin",
        "//oracle:oracle",
        "//tools:exit_status",
        "//tools:runner_lib.sh",
        "tests/ex00/fixtures/ref.dict",
    ],
)

# The same runner over GENERATED dictionaries: a fresh one per case, with random
# values, random spacing either side of the colon, blank lines, entries shuffled,
# extra keys beyond the reference set, and one case in five missing a key the
# number needs so "Dict Error" is produced rather than hand-written.
