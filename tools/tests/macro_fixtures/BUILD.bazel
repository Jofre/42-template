    # (_case_gate_problems): run_check.sh's, and diff_output.sh's --gate-bin.
    # Rush 00's _main and _defense wait so for their variant's table. Green
    # where each gate is that test's run, standard input and labels included,
    "audit-output-gate-run": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_defense": dict(_FED_DEFENSE, args = _FED_DEFENSE["args"] + _FED_IN),
            "ex00_fed_main": dict(_FED_MAIN, args = _FED_MAIN["args"] + _FED_IN),
            "ex00_fed_output": _FED_OUTPUT,
        },
    }),
    # ...red where run_check.sh's gate reads another file, which a correct
    # program fails: the run would SKIP on every correct tree,
    "audit-output-gate-run-check-stdin": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_defense": dict(_FED_DEFENSE, args = _FED_DEFENSE["args"] + _FED_IN),
            "ex00_fed_main": dict(_FED_MAIN, args = _FED_MAIN["args"] + ["--gate-stdin", "$(location tests/ex00/in.txt)", "--gate-labeled"]),
            "ex00_fed_output": _FED_OUTPUT,
        },
    }),
    # ...red where diff_output.sh's --gate-bin gate does,
    "audit-output-gate-bin-stdin": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_defense": dict(_FED_DEFENSE, args = _FED_DEFENSE["args"] + ["--gate-stdin", "$(location tests/ex00/in.txt)", "--gate-labeled"]),
            "ex00_fed_main": dict(_FED_MAIN, args = _FED_MAIN["args"] + _FED_IN),
            "ex00_fed_output": _FED_OUTPUT,
        },
    }),
    # ...red where a gate compares the table without its labels,
    "audit-output-gate-unlabeled": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_defense": dict(_FED_DEFENSE, args = _FED_DEFENSE["args"] + _FED_IN),
            "ex00_fed_main": dict(_FED_MAIN, args = _FED_MAIN["args"] + _FED_IN[:2]),
            "ex00_fed_output": _FED_OUTPUT,
        },
    }),
    # ...and red where a survive case's gate, on its own program, does not
    # run its exercise's case either.
    "audit-output-gate-survive-stdin": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_output": _FED_OUTPUT,
            "ex00_fed_survive": {
                "args": ["--bin", "$(location :ex00_bin)", "--survive", "--gate-label", "ex00_fed_output"] +
                        _FED_GATE[2:] + ["--gate-stdin", "$(location tests/ex00/in.txt)", "--gate-labeled"],
                "srcs": ["//tools:diff_output.sh"],
                "tags": ["output", "ex00"] + LEVELS,
            },
        },
    }),
    # A GATED TEST OF A RUNNER THAT TAKES --gate-label NAMES ITS OUTPUT TEST
    # (_gate_label_problems). Deleting the pair from a hand-written BSQ or
    # rush target still built, and its SKIP line named no test. Red without
    # it, naming the test the gate resolves to,
    "audit-gate-label-missing": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_example_output": _GATE_EXAMPLE,
            "ex00_sweep": dict(_CORPUS_SWEEP, args = _CORPUS_PLAIN["args"] + _GATE[:-2] + ["--gate-arg", "$(location tests/ex00/example.map)"]),
            "ex00_sweep_diff_asan": dict(_CORPUS_ASAN, args = _CORPUS_ASAN["args"] + _GATE + ["--gate-arg", "$(location tests/ex00/example.map)"]),
        },
    }),
    # ...and red on a gate written out whole (run_check.sh) as well.
    "audit-gate-label-missing-whole": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_defense": dict(_FED_DEFENSE, args = _FED_DEFENSE["args"] + _FED_IN),
            "ex00_fed_main": dict(_FED_MAIN, args = [a for a in _FED_MAIN["args"] if a not in ("--gate-label", "ex00_fed_output")] + _FED_IN),
            "ex00_fed_output": _FED_OUTPUT,
        },
    }),
    # ...and red on diff_output.sh's own gate (--gate-expected, no
    # --gate-differ) as well: a defense test with a gate named no test in
    # its SKIP line either (V169).
    "audit-gate-label-missing-defense": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_fed_defense": dict(_FED_DEFENSE, args = [a for a in _FED_DEFENSE["args"] if a not in ("--gate-label", "ex00_fed_output")] + _FED_IN),
            "ex00_fed_main": dict(_FED_MAIN, args = _FED_MAIN["args"] + _FED_IN),
            "ex00_fed_output": _FED_OUTPUT,
        },
    }),
    # ...and red where its gate is --gate-differ alone, which resolves to no
    # output test and which no other audit names: the runner would refuse it
    # only when the test runs.
    "audit-gate-label-differ-only": "%d message(s): %s" % (len(_GATE_DIFFER_ONLY.split(" | ")), _GATE_DIFFER_ONLY),
    # ...and quiet where its gate resolves to no output test: the waiting
    # audit names the test, once.
    "audit-gate-label-unresolved": "%d message(s): %s" % (len(_GATE_LABEL_UNRESOLVED.split(" | ")), _GATE_LABEL_UNRESOLVED),
    # ...and red where the only test that matches its file feeds the map on
    # standard input, which a gate never does.
    "audit-gate-stdin-case": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_example_output": dict(_GATE_EXAMPLE, args = _GATE_EXAMPLE["args"][:4] + ["--waiting", "$(location :waiting_ex00_example_output)", "--stdin", "$(location tests/ex00/example.map)", "--"]),
            "ex00_sweep": dict(_CORPUS_SWEEP, args = _CORPUS_PLAIN["args"] + _GATE),
            "ex00_sweep_diff_asan": dict(_CORPUS_ASAN, args = _CORPUS_ASAN["args"] + _GATE),
        },
    }),
}

