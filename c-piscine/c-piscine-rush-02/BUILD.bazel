            "fixtures": ["tests/ex00/fixtures/tab.dict"],
            "expected": "dicterr.txt",
            "clues": "clues.tsv",
        },
        # Every line ended with CR LF. A program that trims the CR with the
        # spaces prints forty two, one that reads it as a byte that is not
        # printable prints Dict Error: both pass here, and dict_crlf_strict
        # takes one reading.
        {
            "name": "dict_crlf",
            "args": [
                "$(location tests/ex00/fixtures/crlf.dict)",
                "42",
            ],
            "fixtures": ["tests/ex00/fixtures/crlf.dict"],
            "any_of": [
                "dicterr.txt",
                "forty_two.txt",
            ],
            "clues": "clues.tsv",
        },
        {
            "name": "dict_crlf_strict",
            "level": 2,
            "invalid_input": True,
            "args": [
                "$(location tests/ex00/fixtures/crlf.dict)",
                "42",
            ],
            "fixtures": ["tests/ex00/fixtures/crlf.dict"],
            "expected": "dicterr.txt",
            "clues": "clues.tsv",
        },
        # Parses cleanly, but the key 5 is gone and nothing else can express
