# THE MAKEFILES' SENTENCES (c_make's quotes), the same four times. This
# subject lists the rules -- "a Makefile with the following rules: all, clean,
# fclean" -- and says nothing of what clean and fclean do, so what they do is
# this repo's convention, checked at robust (exNN_build_rules); that each is
# there is basic. Its line about cc says what the Moulinette does, so whether
# it binds the recipes is open, and exNN_build_recipe, strict, holds one
# reading. The Norm's "no *.c, no *.o" is not in the subject either:
# exNN_build_wildcards, strict.
_MAKE_QUOTES = {
    "cc": "C 10, p.2: \"Moulinette compiles with the following flags: -Wall -Wextra -Werror, using cc.\"",
    "wildcards": NORM_NO_WILDCARDS,
}

c_make(
    num = "00",
    artifact = "ft_display_file",
    # c-10's subject says only "a Makefile with the following rules: all,
    # clean, fclean" -- no `re`. Requiring one would red a correct Makefile
    # over a rule nobody asked for, at level basic, which gates submit.
    rules = [
        "all",
        "clean",
        "fclean",
    ],
    symbols = ["main"],
    quotes = _MAKE_QUOTES,
    recipe = "any",
    recipe_strict = True,
    wildcards = True,
)

