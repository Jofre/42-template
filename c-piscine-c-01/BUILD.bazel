c_function(num = "07", fn = "ft_rev_int_tab", test = "test_rev_int_tab.c", allowed = [], labeled = True, clues = "clues.tsv")

# ft_rev_int_tab / ft_sort_int_tab carry a `size` SAFETY bound: they reorder the
# array in place and must never read or write index == size. These run the
# function under ASan on exactly-sized heap buffers — a stray access past the
# bound is caught here (output diffing can't see an out-of-bounds read).
c_mem_check(num = "07", fn = "ft_rev_int_tab", probe = "mem_rev_int_tab.c")

c_diff(num = "07", fn = "ft_rev_int_tab", harness = "diff_rev_int_tab.c", oracle_fn = "c01_rev_int_tab", diff_clues = "diff_clues.txt")

