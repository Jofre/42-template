# ==== GROUP mem: ft_memset ft_bzero ft_memcpy ft_memmove ft_memchr ft_memcmp ft_calloc ====

# THE MEMORY FUNCTIONS OF PART 1. "Your version will have the same prototypes
# and behaviors as the originals, adhering strictly to their definitions in
# the man page." (p.8): each contract below is its man page's, quoted at the
# call. Every write target in a fixture starts dirty, every fixture shows the
# bytes around the n it was given, and each ends on a row past 4096 bytes.
# Each member's c_mem_check hands the function heap blocks that end where
# the bytes it may touch end, most of them starting where those bytes start
# too (its probe's header says which fault each call is aimed at);
# memory_graded puts its memcheck run at basic, so every probe survives a
# stub. Its c_diff replays a seeded corpus of whole blocks, each decoded into
# a heap block of exactly its length; its c_cycles counts instructions per
# byte of n, over the cases of up to 1000 bytes (the longer ones test
# capacity, which the diff layers judge), with no budget: none has been
# measured on correct answers yet.

# man memset: "fills the first n bytes of the memory area pointed to by s
# with the constant byte c" and "returns a pointer to the memory area s".
# That settles a c in 0..255 and no other: the fixture and the corpus hold
# only those, and a c outside it is the wide_c reading's (strict, its own
# fixture) and the corpus readings' (strict), whose own hints say what they
# expect.
c_function(
    num = "00",
    fn = "ft_memset",
    member = "ft_memset",
    test = "test_ft_memset.c",
    labeled = True,
    escaped_values = True,
    clues = "clues.tsv",
    readings = [{
        "name": "wide_c",
        "main": "test_ft_memset_wide_c.c",
        "expected": "expected_wide_c.txt",
        "labeled": True,
        "clues": "clues_wide_c.tsv",
        "level": 2,
    }],
)

