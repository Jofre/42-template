# A toy reader harness linked through //tools:diffio, the library every c_diff
# and c_perf reader links (tools/tests/diffio_probe.c says what it reads). The
# selftest runs it: every block malloc hands out in such a program starts
# holding 0xa5 (tools/dirty_malloc.c), which the library owes to its source
# file AND its -Wl,--wrap=malloc. An arm that compiled dirty_malloc.c with the
# flag by hand stayed green with either taken out of the library (finding
# 136's fix, the wave 6 review); built by Bazel through the library, the
# probe reads the unwritten field as NULL the moment the wrap is gone.
cc_binary(
    name = "diffio_probe",
    srcs = ["diffio_probe.c", "diffio_probe_toy.c"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    deps = ["//tools:diffio"],
)

# Tests for the TEST HARNESS itself.
#
# Every false green fixed on this branch had one shape: a layer reporting OK
# having checked nothing. They were found by reading each script and asking "can
# this exit 0 while broken?" — which is what this asks automatically, with
# known-bad inputs that MUST go red and known-good ones that must stay green.
# A runner that stops detecting its bug fails here instead of silently passing
# every exercise in the repo.
hand_test(
    name = "selftest",
    layer = "selftest",
    size = "small",
    # size stays "small" -- it says what this test COSTS, and Bazel schedules on
    # it. The timeout is raised separately because cost and worst-case wall clock
    # are different things here: every arm is a process, most of them compile a C
    # fixture, and every one of those compiles competes with whatever else the
    # suite is doing. Measured, when this was one process and the file a few
    # dozen arms: 1.6s idle, 9.6s alongside a module, 30s in a full `bazel test
    # //...`, and 69.2s in one -- which BLEW the 60s that size = "small" implies
    # and reported TIMEOUT. A timeout is indistinguishable from a real failure at
    # a glance, so the file that exists to prove the harness still works became
    # the harness looking broken, on the machines least able to tell the
    # difference: a loaded box, or a slow one.
    #
    # Do not "fix" this by trimming arms. The arms are the point, and the
    # expensive layers are already split into :selftest_slow for the separate
    # reason of what they cost per arm and pull in (see there).
    #
    # SHARDED, and given "long" (it is "eternal" now: see the last
    # paragraph), because one process running every arm in turn
    # stopped fitting any timeout on a loaded box. In four full-suite runs on
    # a 24-core machine running other suites too, it took 285.4s once and
    # TIMED OUT at 300-316s three times under "moderate"; under "long" it took
    # 850.7s and 820.8s, and :selftest_bash TIMED OUT at 900s, in two suites
    # run at once (load 55-60). At load 11 the whole file takes about 100s.
    # The time is the arms' own -- hundreds of short processes each, which a
    # loaded scheduler slows tenfold -- and trimming arms is not the answer.
    #
    # So each of eight shards runs the arms of some of the file's SECTIONS,
    # and all of its plain code (selftest.sh, "SHARDS", says what an arm may
    # rely on). They were dealt in turn, and one shard held the conventions
    # section, a run of conventions.sh per arm: 450 of the file's 750 seconds
    # of arms, that shard 466-590s against 120-150s for the others, and
    # :selftest_bash 714s of its 900 (finding 066). Dealt next by a count of
    # lines, they were even in count and not in time: on an idle machine at
    # 6e639729 the shards took 342-590s (:selftest) and 355-596s
    # (:selftest_bash), the slowest 1.38x and 1.29x the mean, and loaded
    # runs timed shards out at 900s (V138, V208). They are dealt by
    # measured seconds now (selftest_costs.tsv, "SHARD WEIGHTS"), no section
    # costs more than three quarters of a shard's share (conventions is twenty
    # sections), and the plain runs of the check happen only in the shard
    # whose arms read them. In three runs of that deal, at load 9-49 beside
    # other branches' builds, the slowest shard was 1.04-1.05x the mean
    # (:selftest 500-647s, :selftest_bash 573-728s of their 900).
    # Eight shards, not four: each runs all the plain code (20-45s) and an
    # eighth of the arms. Each shard has the whole timeout, its log is
    # bazel-testlogs/tools/tests/selftest/shard_N_of_8/test.log, and every
    # section's time is printed in it ("[section ...]"). A hand run still
    # runs every arm in one process: sh, or
    # `bazel run --test_sharding_strategy=disabled` (plain `bazel run`
    # refuses a sharded test).
    #
    # The output-table arms (wave 3) added about ninety arms of their own,
    # and diff_output.sh was brought back to the process count it had before
    # them (one scratch directory, the newline and binary facts read by the
    # awk that renders the table): 9 ms a run against 8 before and 16 in
    # between, measured on one passing case.
    #
    # "eternal" (3600s), not "long" (900s), since 2026-11-06, after
    # :selftest_bash timed out in the full suite. A shard's arms take
    # 430-585s with nothing else running, but a full `bazel test //...` runs
    # these sixteen shards beside every other target, and there the slowest
    # :selftest_bash shard went 678s, 848s, 901s on three successive branches
    # whose arms cost only seconds more alone: twice a TIMEOUT. The wall clock
    # under a full suite is the scheduler's, not the arms' cost, so the limit
    # is raised rather than the arms trimmed, as above. What that gives up:
    # this limit is now the only automatic bound on a shard. A cost that
    # creeps is seen only by selftest_costs, which is run by hand (below) and
    # compares sections on the run's own scale, so a rise shared by every
    # section does not show; and a hang is cut early only in an arm wrapped
    # in bounded (selftest.sh), where `timeout` exists. Any other hang holds
    # its shard for the full 3600s.
    shard_count = 8,
    timeout = "eternal",
    srcs = ["selftest.sh"],
    args = SELFTEST_ARGS,
    # Every runner the selftest drives has to be here, and the ones added most
    # recently were chosen by what a break COSTS rather than by what is easy to
    # fixture: argv_table.sh is the only runner that executes c-06 ex01-ex03 at
    # all, shell_test.sh is the only runner either shell module has, and
    # header_check.sh is the only c-08 layer that RUNS the header exercise (norm
    # and compile also see the header; neither runs the program). asan_check.sh
    # is not the repo's only sanitizer layer, but it alone chooses the
    # allocation: its probe hands the function a block sized to fit exactly,
    # so one step past the end lands in a redzone instead of on a neighbouring
    # byte the whole-program layers would let through. A silent break in any of
    # those greens a whole module with nothing else left checking it.
    #
    # stub_check.sh is not a test layer at all — no exercise runs it — and it is
    # here because it is the only runner whose failure is not a red test but a
    # PUBLISHED ANSWER. It checked `*/deliverable/*.c` and nothing else, so it
    # reported "OK — all 123 deliverable(s) are stubs" over a tree still holding
    # c-08's four finished header answers, and they shipped on the template
    # branch other people clone. Its arms are one green and one red per file
    # KIND, because the defect was a whole kind being out of scope rather than a
    # rule being wrong, and no arm on a neighbouring kind would have noticed.
    #
    # progname_test.sh earned its place the hard way: it had NO arm here, and
    # went on discarding the child's exit status for as long as that was true, so
    # a program that printed the right line and then segfaulted passed. It is the
    # only layer that runs c-06 ex00's binary at the basic level.
    #
    # Its arrival also demonstrated why want_red insists on exit 1 and treats
    # anything else as "nothing was checked". The first run of the new arms
    # reported exit 2 — because the runner was missing from this very list, and
    # `sh` exits 2 when it cannot open the script it was handed. Under a
    # tolerant "any non-zero counts as red" rule, three arms would have printed
    # "ok (red, as required)" having executed nothing at all.
    #
    # Note that argv_table.sh resolves its reporter as ./diff_output.sh relative
    # to its own path, so the two must stay in this list together — they land in
    # the same runfiles directory, which is what makes that lookup work.
    #
    # All fixtures are written at run time into a mktemp dir, so nothing here is
    # a checked-in input file: the test builds its own known-bad programs with
    # the pinned clang-12 and ld.bfd it is handed (--clang, --ld; never the
    # box's cc, TO VERIFY V28) and cleans up after itself. Cost is dominated by
    # those compiles, so it is sensitive to what else runs alongside — see the
    # timeout note above for the measured spread and why it is raised. Keeping
    # the expensive layers OUT is a separate decision from that timeout: valgrind
    # and anything needing //oracle's Rust build belong in :selftest_slow,
    # because their per-arm cost and dependencies would land on every run.
    data = SELFTEST_DATA,
)

# The SAME arms, replayed with a different shell interpreting every runner.
#
# This repo does not pin /bin/sh, and the reason it does not need to is that the
# runners are shell-agnostic. That is a claim about behaviour, so it is executed
# rather than asserted: `bazel test //tools/tests:selftest_bash` runs every
# arm with bash reading each runner instead of the system sh (dash here and on
# the campus box).
#
# //tools:conventions already refuses a bashism statically -- shellcheck's
# SC3xxx family, at warning level, because every runner declares #!/bin/sh. This
# is the half a linter cannot do. dash and bash disagree about things no static
# check reads: `echo` with backslash escapes, how `local` behaves, arithmetic
# corners. If a runner ever grows a dependency on one of them, this goes red and
# names the arm.
#
# It SKIPS, loudly, where bash is not installed -- and NO_SKIP=1 turns that skip
# into a failure, like every other gated thing here.
hand_test(
    name = "selftest_bash",
    layer = "selftest",
    size = "small",
    # The same arms as :selftest, so the same shards, the same timeout and the
    # same reasons.
    shard_count = 8,
    timeout = "eternal",
    srcs = ["selftest.sh"],
    args = SELFTEST_ARGS,
    data = SELFTEST_DATA,
    env = {"SELFTEST_SH": "bash"},
)

# bazel run //tools/tests:selftest_costs [-- --write]
#
# The two targets above are dealt by selftest_costs.tsv, whose rows the deal
# never checks against a run: a listed section that grows keeps its row
# (TO VERIFY V285). This reads the last run's shard logs back against the
# table, and with --write measures it again. Run by hand, by whoever keeps
# the selftest; "the shard deal" arms run it on a toy.
sh_binary(
    name = "selftest_costs",
    srcs = ["selftest_costs.sh"],
    data = ["selftest_costs.tsv"],
)

# The same question as :selftest, for the runners too expensive to ask it of on
# every build. Split rather than merged so that valgrind's 20-50x, zig's
# compiles and the //oracle build stay off the selftest people run most — a
# self-test nobody runs protects nothing. See the script's header for why
# valgrind_test.sh was the first one moved here: it is the only layer in the
# repo that can see a leak, so nothing else would notice if its output-matching
# regex stopped matching.
#
# medium (300s), not small: valgrind runs the program on a synthetic CPU at
# 20-50x native. Eight tiny programs still finish well inside that.
# Shared by the two slow targets below, for the reason SELFTEST_DATA above
# gives: the second run stops proving anything the moment its inputs differ
# from the first's.
SLOW_ARGS = [
        "--anchor",
        "$(rootpath //tools:diff_output.sh)",
        "--perf-run",
        "$(rootpath //tools:perf_run)",
        # The pinned valgrind, handed on to every arm. These arms exist to prove
        # the leak layer still detects a leak, so they have to exercise the same
