)

# The same arms, with BASH interpreting every runner.
#
# This was recorded as "not covered" and left there: a bash twin was judged to
# "double a slow test for two runners whose arms are the least shell-sensitive
# in the repo (they parse tool output)". Two things have changed. The cost is
# TWELVE SECONDS, not the minutes the word "slow" implies -- this target is
# `medium` because valgrind and zig are slow to START, not because its arms are
# long. And it is no longer only valgrind and perf: the ilp32 arms added since
# build their fixtures with heredocs and read a compiler's output, which is
# exactly the shape dash and bash disagree about.
#
# The skip guard is selftest_slow.sh's own, shared with selftest.sh: a machine
# without bash SKIPS rather than passing, and NO_SKIP=1 turns that into exit 2.
hand_test(
    name = "selftest_slow_bash",
    layer = "selftest",
    size = "medium",
    # As :selftest_slow.
    timeout = "long",
    srcs = ["selftest_slow.sh"],
    args = SLOW_ARGS,
    data = SLOW_DATA,
    env = {"SELFTEST_SH": "bash"},
)

# ---------------------------------------------------------------------------
# The style gate, GRADED. //tools:conventions is the same script run by hand
# over the real workspace; this is it under `bazel test`, so a broken convention
# reds on the next run instead of waiting for someone to remember the command.
#
# It had zero reverse dependencies for its whole life -- the checker that
# enforces "every SKIP honours NO_SKIP" was the one thing nothing checked.
#
# EVERY MODULE, by package: what //tools/tests:conventions reads, and the
# modules whose turn-in folders :macro_fixtures_test holds first_red to.
# Hand-written once, here; conventions.sh refuses to run when a module in
# tools/submit.sh's REMOTES table is missing from what it can see, so a module
# left out of this list fails loudly in both.
_MODULES = [
    # Piscine Reloaded: one project.
    "//c-piscine-reloaded/c-piscine-reloaded",
] + [
    "//c-piscine/c-piscine-%s" % m
    for m in [
        "bsq",
        "c-00",
        "c-01",
        "c-02",
        "c-03",
        "c-04",
        "c-05",
        "c-06",
        "c-07",
        "c-08",
        "c-09",
        "c-10",
        "c-11",
        "c-12",
        "c-13",
        "rush-00",
        "rush-01",
        "rush-02",
        "shell-00",
        "shell-01",
    ]
]

# The file list is the part that used to make this impossible, and none of it is
# hand-written per file: c_levels() emits a :conventions_srcs glob for every
# module, //tools and this package glob their own, and the root package covers
# the few files that belong to no package. What IS hand-written is the module
# list, _MODULES above -- and conventions.sh refuses to run when a module in
# tools/submit.sh's REMOTES table is missing from what it can see, so adding a
# module and forgetting this list fails loudly instead of quietly shrinking the
# gate.
#
# `medium`, not `small`: it runs shellcheck and buildifier over the whole repo
# and walks every module, which takes seconds on an idle machine and ran past
# small's 60 s on a loaded one -- a TIMEOUT that says nothing about the
# conventions it exists to report on.
hand_test(
    name = "conventions",
    layer = "selftest",
    size = "medium",
    # 96-132s in a full suite, near half of "medium"'s 300: a second suite on
    # the machine took it past (finding 066). One process walks the tree, so
    # the time is its own; a longer limit, not a smaller check.
    timeout = "long",
    srcs = ["//tools:conventions.sh"],
    args = [
        "--shellcheck",
        "$(rootpath @shellcheck_linux_x86_64//:shellcheck)",
        "--buildifier",
        "$(rootpath @buildifier_prebuilt//:buildifier)",
    ],
    data = [
        "//:conventions_srcs",
        "//tools:conventions_srcs",
        "//tools/cc_toolchain:conventions_srcs",
        "//oracle:conventions_srcs",
        ":conventions_srcs",
        # The toy exercises' package holds a turn-in too (deliverable/), so
        # its BUILD file is held to the rules a module's is.
        "//tools/tests/macro_fixtures:conventions_srcs",
        "//tools/tests/macro_fixtures/root:conventions_srcs",
        "//tools/tests/macro_fixtures/levels:conventions_srcs",
        "@buildifier_prebuilt//:buildifier",
        "@shellcheck_linux_x86_64//:shellcheck",
    ] + [m + ":conventions_srcs" for m in _MODULES],
)

# 42's own tests (tools/fortytwo/tests), under unittest on the hermetic Python.
# A py_test, so lvl_tags() gives it its layer and level, as it does
# //tools/cc_toolchain's rule. It reads the projects' contracts and the scripts
# whose facts 42 takes rather than copies (first_red.sh, submit.sh, defs.bzl,
# drives.sh), and runs no Bazel: the end-to-end runs are docs/testing.md's.
py_test(
    name = "fortytwo_test",
    size = "small",
    srcs = ["fortytwo_test.py"],
    data = [
        # docs/bazel.md, whose `42 ... --dry-run` lines test_docs.py runs.
        "//:conventions_srcs",
        "//tools:conventions_srcs",
        "//tools:fortytwo_tests",
    ] + [m + ":conventions_srcs" for m in _MODULES],
    tags = lvl_tags("selftest"),
    deps = ["//tools:fortytwo"],
)

# A macro's decisions, checked where they are made. shell_exercise decides at
# load time, from a glob, which files in a twin's tests/exNN/ no target reads,
# and no runner ever sees that decision, only its result; so selftest.sh cannot
# reach it. starlark_unit.bzl calls each such helper on inputs of its own, in
# both directions, and this test is red naming any case that disagreed.
starlark_unit(name = "starlark_unit")

# This package's own scripts, for the test above.
filegroup(
    name = "conventions_srcs",
    srcs = ["BUILD.bazel"] + glob(
        ["*.sh"],
        allow_empty = False,
    ) + glob(["*.bzl"]),
)

# The defs.bzl guards that fail() at loading -- an unknown case key, a
# malformed exit, c_header's exit below robust -- have no runner to hand a bad
# input to. starlark_selftest() calls each one on an input it must refuse and
# on one it must accept while this package loads, and fail()s the load when a
# guard answers wrong; the test it emits lists the arms.
starlark_selftest(name = "starlark_selftest")

# No deliverable can break the build graph: toy exercises in every broken state
# a student's tree can be in, built through the same macros every module uses
# (//tools/tests/macro_fixtures -- see its BUILD file). This test's data are
# the programs built from them, so a fixture package that stops loading, or a
# broken toy that fails the build instead of becoming a stand-in, is this test
# failing to build; its script checks that every broken program says why, in
# a stand-in of the right kind, that the ones that build are unaffected, that
# the output layer reads a stand-in as a build failure (or, over an exercise
# not started, as nothing to build) rather than as wrong output, and that the
# macros emitted every test as layers.expected lists it. Its ./root package is
# the toy turned in at the root of deliverable/, with srcs/ and includes/: its
# program is real only if the tree was staged and the Makefile's -I was taken,
# and the same -I list reaches its static layers. Its ./levels package is a
# toy module for c_levels(): exercises found from the contract, tests/,
# deliverable/ and generators/, a folder the subject has no exercise for
# reported, and the audit passed on every test; and its c_function reading
# runs a main of its own, not the exercise's. It also compares every
# contract check's message on a broken contract with what it must say, a case
# dict's and the audit's among them, and every program built from the toys'
# files against harnesses.expected: each harness names the test of the
# signatures it calls (_student_bin's `prototype`), so a tag that stopped
# being written is red here and not only a quieter audit.
