load("//tools:defs.bzl", "c_function", "c_levels", "c_make", "subject", "unit")
load("//tools:names_file.bzl", "names_file")
load("//tools/tests:analysed.bzl", "analysed")

# Its programs are the data of //tools/tests:macro_fixtures_test.
package(default_visibility = ["//tools/tests:__pkg__"])

# A TOY PROJECT IN TWO PARTS IN THE SAME FILES: a mandatory part, base, and
# a bonus, both turned in at the root of deliverable/ as one Makefile and
# one source and header, which both parts list. The bonus is built by the
# Makefile's bonus rule, into the same library a bare make builds, so only
# that rule can say whether the bonus is written. Invented, like the rest
# of ../ (see its BUILD file), every file under deliverable/ a stub. The
# stub's bonus rule has no prerequisite: a rule with one counts as doing
# something (stub_check.sh --goal), so a stub that shipped `bonus: all`
# would read as a bonus written as soon as the rest of its Makefile is.
#
# What //tools/tests:macro_fixtures_test checks here, on every run:
#
#   * the package loads: subject() takes two parts that list the same
#     files, the second with a goal, and c_levels()' audit passed on every
#     test below, each named after its part and tagged unit=<part>;
#   * the tests and suites emitted are the ones layers.expected lists: one
#     suite per part (:base, :bonus), a c_make for each, and
#     deliverable_files, which judges the tree against both parts' files at
#     once (" union");
#   * base_bin runs tests/base/test_toy_fmt.c and bonus_bin
#     tests/bonus/test_toy_fmt.c, each linking its own library target of the
#     one function both parts define (is_program).
#
# Measured by hand on 2026-10-24 with
#
#     bazel test $(bazel query 'tests(//tools/tests/macro_fixtures/named_units_same:*)')
#
# (tagged manual, as every fixture test is): 28 tests, 2 red --
# base_build and bonus_build, the stub Makefile building no libtoyfmt.a
# with make or with make bonus. base_build_exit and base_build_rules SKIP
# on base_build, bonus_build_exit on bonus_build, and every other test is
# green. Re-measure after changing a macro or a runner.
subject(
    grader = "both",
    group = False,
    units = {
        "base": unit(
            page = 1,
            files = ["Makefile", "toy_fmt.c", "toy_fmt.h"],
            allowed = None,
        ),
        "bonus": unit(
            page = 2,
            files = ["Makefile", "toy_fmt.c", "toy_fmt.h"],
            allowed = None,
            goal = "bonus",
            goal_quote = "Toy, p.2: \"Your bonus rule may build the same library as your mandatory part.\"",
        ),
    },
    mandatory = ["base"],
    mandatory_quote = "Toy, p.1: \"The bonus part is assessed only if the mandatory part is perfect.\"",
)

c_function(
    unit = "base",
    fn = "toy_fmt",
    test = "test_toy_fmt.c",
)

# The same function, from the same files: each part's programs link a
# library target of their own, named after the part.
c_function(
    unit = "bonus",
    fn = "toy_fmt",
    test = "test_toy_fmt.c",
)

c_make(
    unit = "base",
    artifact = "libtoyfmt.a",
    not_checked = {
        "recipe": "the toy subject says nothing about how its library compiles",
        "wildcards": "the toy subject does not bind the Norm",
    },
)

# The build of make bonus, judged by that build alone: the Makefile's other
# rules, a relink and its recipes are base's c_make's to judge.
c_make(
    unit = "bonus",
    artifact = "libtoyfmt.a",
    not_checked = {
        "recipe": "the toy subject says nothing about how its library compiles",
        "wildcards": "the toy subject does not bind the Norm",
    },
)

c_levels()

# What c_levels() and the macros emitted, as data: ../named_units_files'
# :layers, which says what each word is.
names_file(
    name = "layers",
    names = sorted([
        "%s %s @%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s by:%s kind:%s" % (
            r["name"],
            r["srcs"][0].split(":")[-1],
            [t for t in ["lvl_basic", "lvl_strict", "lvl_robust", "lvl_complete"] if t in r["tags"]][0][4:],
            # The word after the flag (args is a tuple here: no .index).
            "".join([" fn:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--oracle-fn"]),
            "".join([" count:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--count"]),
            "".join([
                " bin:" + r["args"][i + 1][len("$(location "):-1] + "".join([
                    " built:" + h.split("/")[-1]
                    for h in existing_rule(r["args"][i + 1][len("$(location :"):-1])["harness"]
                ]) + "".join([
                    " reader:" + r["args"][j + 1][:-1].split("/")[-1]
                    for j in range(len(r["args"]) - 1)
                    if r["args"][j] == "--harness-src"
                ])
                for i in range(len(r["args"]) - 1)
                if r["args"][i] == "--student-bin" and not r["args"][i + 1].endswith(("_diffbin)", "_diffbin_asan)"))
            ]),
            " any-of" if "--expected-alt" in r["args"] else "",
            " survive" if "--survive" in r["args"] else "",
            " stray" if "--stray" in r["args"] else "",
            " outside" if "--outside" in r["args"] else "",
            " reading" if [i for i in range(len(r["args"]) - 1) if r["args"][i] == "--exit-source" and r["args"][i + 1] == "reading"] else "",
            " argv-file" if "--argv-file" in r["args"] else "",
            " cwd" if "--run-as" in r["args"] else "",
            " ran" if "--show-run" in r["args"] else "",
            " case" if "--case" in r["args"] else "",
            " clues" if "--clues" in r["args"] else "",
            " stable" if "--stable" in r["args"] else "",
            " sanitized" if "--sanitized" in r["args"] else "",
            " sanitize" if "--sanitize" in r["args"] or "--gate-sanitize" in r["args"] else "",
            " memcheck" if "--sample" in r["args"] else "",
            " gated" if "--gate-expected" in r["args"] else "",
            " gate-stdin" if "--gate-stdin" in r["args"] else "",
            "".join([" gate-label:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--gate-label"]),
            "".join([" suite:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--suite"]),
            "".join([" sibling:" + r["args"][i + 1] for i in range(len(r["args"]) - 1) if r["args"][i] == "--sibling"]),
            " extras-elsewhere" if "--extras-elsewhere" in r["args"] else "",
            " union" if "--union" in r["args"] else "",
            (" raised:" + (r["env"] or {})["RL_RAISED"]) if "RL_RAISED" in (r["env"] or {}) else "",
            (" make-includes" if "--inc-file" in r["args"] else "") +
            "".join([
                " " + t
                for t in r["tags"]
                if t.startswith("unit=") or (t[:2] == "ex" and t[2:].isdigit())
            ]),
            (r["env"] or {}).get("RL_GRADER", "none"),
            (r["env"] or {}).get("RL_UNIT_KIND", "none"),
        )
        for r in existing_rules().values()
        if r["kind"] == "sh_test"
    ] + [
        "%s suite %s" % (r["name"], " ".join(r["tags"]))
        for r in existing_rules().values()
        if r["kind"] == "test_suite"
    ]),
)

exports_files(["layers.expected"])

# EVERY TOY ANALYSED: each manual target above, its test_suite included,
# as a dependency of this target, which //tools/tests:macro_fixtures_test
# depends on, so a toy naming a label no package declares, or one a macro
# no longer accepts, fails that test's build instead of waiting for
# someone to name it by hand. It builds nothing of them
# (tools/tests/analysed.bzl). The last call of the file, so that it sees
# every test above it. c_levels()' own :manual suite is named by hand: its
# finalizer declares it once the file has been read, and existing_rules()
# here cannot see it yet.
analysed(
    name = "toys_analysed",
    testonly = True,
    deps = sorted([":" + r for r, a in existing_rules().items() if "manual" in (a.get("tags") or [])] + [":manual"]),
)
