    # ...green with the example's own argument,
    "audit-gate-case-run": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_example_output": _GATE_EXAMPLE,
            "ex00_sweep": dict(_CORPUS_SWEEP, args = _CORPUS_PLAIN["args"] + _GATE + ["--gate-arg", "$(location tests/ex00/example.map)"]),
            "ex00_sweep_diff_asan": dict(_CORPUS_ASAN, args = _CORPUS_ASAN["args"] + _GATE + ["--gate-arg", "$(location tests/ex00/example.map)"]),
        },
    }),
    # A GATE THAT REPLAYS ITS CASE IS THAT CASE'S OUTPUT TEST
    # (_case_gate_problems). Rush 02's allocfail sweep forwarded standard
    # input alone, and its case runs the program beside numbers.dict: the
    # gate ran it from a folder with no dictionary, red on every correct
