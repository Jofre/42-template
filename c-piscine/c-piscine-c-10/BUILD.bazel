load("//tools:defs.bzl", "NORM_NO_WILDCARDS", "c_levels", "c_make", "c_program", "corpus_memory", "exercise", "hand_test", "subject")

# THE SUBJECT CONTRACT (tools/subject.bzl), from each exercise's header box.
#
# "Files to turn in: Makefile, and files needed for your program": the Makefile
# is named, the sources are the student's to name, so every .c and .h in the
# folder is allowed, in a subfolder too ("**/*.c": the Makefile says where its
# sources lie) -- but a .c the Makefile never compiles is no file the program
# needs, and is reported (make -Bn's list). Anything else FAILS (strict, the
# project's default): p.2 says "You cannot leave any additional file in your
# directory beyond those specified in the assignment", and a program grades
# it. That is what keeps a stray binary out: one left in deliverable/ by a
# hand-run of `cc -o` or `make` is what //tools:submit would push to
# Vogsphere.
#
# errno is not on any "Allowed functions" line: ex01-ex03 allow it in a
# sentence of their own, "You may use the variable errno". It is a variable
# the forbidden layer reads from nm all the same -- <errno.h> reads it through
# a call to __errno_location(), which that runner maps back to this name.
subject(
    grader = "both",
    group = False,
    exercises = {
        "00": exercise(
            page = 5,
            dir = "ex00/",
            files = ["Makefile"],
            optional = ["**/*.c", "**/*.h"],
            allowed = ["close", "open", "read", "write"],
        ),
        "01": exercise(
            page = 6,
            dir = "ex01/",
            files = ["Makefile"],
            optional = ["**/*.c", "**/*.h"],
            allowed = ["close", "open", "read", "write", "strerror", "basename"],
            variables = ["errno"],
        ),
        "02": exercise(
            page = 7,
            dir = "ex02/",
            files = ["Makefile"],
            optional = ["**/*.c", "**/*.h"],
            allowed = ["close", "open", "read", "write", "malloc", "free", "strerror", "basename"],
            variables = ["errno"],
        ),
        "03": exercise(
            page = 8,
            dir = "ex03/",
            files = ["Makefile"],
            optional = ["**/*.c", "**/*.h"],
            allowed = ["close", "open", "read", "write", "malloc", "free", "strerror", "basename"],
            variables = ["errno"],
        ),
    },
)

# THE EXIT STATUS, by the Run contract (docs/reference.md): the subject names
# none, so no case here compares one at basic. A case the subject answers
# with an error message it names is marked "invalid_input", and its status is
# judged at no level; every other case gets a robust twin, exNN_<case>_exit,
# which fails a non-zero return.
#
# WHAT "PERFORMS THE SAME FUNCTION AS THE SYSTEM'S" TOOL IS READ AS (ex01-ex03).
# What that sentence asks of the messages on stderr and of the exit status
# is a case the subject leaves open, so one reading of it is tested at
# strict, never at basic (the Run contract). Those cases carry "level": 2,
# and a status among them "exit" with this sentence in "exit_quote", which
# makes it a reading (docs/reference.md, "Writing a c_program case"); each
# one's row among docs/reference.md's raised targets states the reading it
# tests. basic keeps what every reading agrees on: on an error path, the good
# files' bytes still reach stdout, and nothing else does -- so a case there
# compares stdout alone.
#
# THE PROGRAM'S NAME in those messages is part of that reading, so it is
# judged at strict alone, where the hints ask about it. The tools themselves
# differ on it (GNU cat and tail, util-linux's hexdump), and the runner
# starts the program by a path ending in exNN_bin.
#
# WHERE THE EXPECTED FILES COME FROM. The ones the error paths, standard input
# and several-file cases added were made by //oracle's model of the four
# programs (`oracle c10_run --prog exNN_bin <tool> ARGS`), run from the
# workspace root on the paths Bazel passes. The model
# reproduces every older fixture here byte for byte too, and on every case
# below it agreed with GNU coreutils 8.32 and util-linux 2.37.2 run as a bare
# exNN_bin, on both streams and the status. None was typed, and none is cut
# by running a system tool at test time. Each c_program below names its
# command in `model`, and exNN_<case>_model re-runs it on the case and fails
# when the file, or the status a case names, is no longer its answer: a
# fixture edited by hand, or a model fixed after the file was made.
#
# EACH PROGRAM IS WHAT ITS MAKEFILE BUILDS, once the Makefile compiles
# anything: its sources and its -I, so a turn-in that keeps a header in
# includes/ and passes `-I includes` builds as make builds it, and a .c the
# Makefile never compiles is never linked (makefile = "once_written",
# tools/student_build.sh's UNTIL THE MAKEFILE IS WRITTEN). Until then -- no
# Makefile, or a stub that only echoes -- every .c of the folder is the
# program, so the output tests say what the program does before the
# Makefile is written; exNN_build says what the Makefile does.
c_program(
    num = "00",
    name = "ft_display_file",
    makefile = "once_written",
    # The method layer, at strict (ex00_fixed_array): no array of variable
    # length and no alloca, which the pinned gcc names. The subject bounds no
    # size here, so no size is judged.
    fixed_array = "p.5: \"The use of the malloc function is forbidden. You must complete this exercise by declaring a fixed-size array.\"",
    # Every expected file below is this command's answer for its case, and
    # ex00_<case>_model holds it there (WHERE THE EXPECTED FILES COME FROM).
    model = ["c10_run", "display_file"],
    # One clues.tsv, each row keyed to the cases it is about (the file
    # displayed, the arguments and errors, the empty file), so each reaches
    # only those cases.
    cases = [
        {
            "name": "show",
            "args": ["$(location tests/ex00/fixtures/sample.txt)"],
            "fixtures": ["tests/ex00/fixtures/sample.txt"],
            "expected": "show.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "noarg",
            "invalid_input": True,
            "args": [],
            "stream": "stderr",
            "expected": "noarg.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "toomany",
            "invalid_input": True,
            "args": ["a", "b"],
            "stream": "stderr",
            "expected": "toomany.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "cannot",
            "missing_file": "this_file_does_not_exist_42",
            "invalid_input": True,
            "args": ["this_file_does_not_exist_42"],
            "stream": "stderr",
            "expected": "cannot.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "blob",
            "args": ["$(location tests/ex00/fixtures/blob.bin)"],
            "fixtures": ["tests/ex00/fixtures/blob.bin"],
            "expected": "blob.txt",
            "clues": "clues.tsv",
        },
        # An EMPTY file is a valid one ("All files given as arguments will be
        # valid"), and it can be read: its content is nothing, and "Cannot read
        # file." is not what it gets -- on either stream (finding 110). A
        # directory is not here: every file given is valid, so a directory is
        # outside this subject at every level. Both cases make one run, so
        # both say it is no error, and its status gets one robust twin,
        # ex00_empty_exit (_emit_cases, ONE TWIN PER RUN).
        {
            "name": "empty",
            "invalid_input": False,
            "args": ["$(location tests/ex00/fixtures/empty.txt)"],
            "fixtures": ["tests/ex00/fixtures/empty.txt"],
            "expected": "empty.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "empty_stderr",
            "invalid_input": False,
            "args": ["$(location tests/ex00/fixtures/empty.txt)"],
            "fixtures": ["tests/ex00/fixtures/empty.txt"],
            "stream": "stderr",
            "expected": "empty.txt",
            "clues": "clues.tsv",
        },
    ],
