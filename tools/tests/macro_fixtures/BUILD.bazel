            "ex00_bsq_diff_asan": dict(_CORPUS_ASAN, args = _CORPUS_ASAN["args"][:2] + ["--fn", "maps"] + _CORPUS_ASAN["args"][2:]),
        },
    }),
    # A CORPUS GATE IS ONE OF THE PACKAGE'S OWN OUTPUT TESTS (_gate_problems).
    # BSQ's gate ran the program with no argument while the example's output
    # test hands it the map, so every corpus SKIPped on every correct program.
    "audit-gate-no-argument": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
