_UNIT_PACKAGES = _FIXTURE_PACKAGES + _MODULES

# THE CONTRACT READ AS TEXT, HELD TO THE CONTRACT THE MACROS READ. Outside
# Bazel, tools/units.awk is the only reader of a subject() call: first_red.sh
# reads through it from a log, and conventions.sh, answer_scan.sh and `42`
# from a checkout. In every package with a contract, this test holds that
# reading to what the macros computed from the same call: :units and
# :test_units, byte for byte, plus first_red's --turnin, --written and
# --graded readings, and units.awk's file lists against the package's
# subject.json. A drift names the wrong folder, files a red under another
# unit, lets --written-only push without a mandatory unit, or hands
# conventions and answer_scan a file the contract does not list. The
# selftest's "units parity" section proves each arm can go red.
# Medium (300 s), as macro_fixtures_test: it runs units.awk and first_red's
# modes some hundreds of times, and under load its time is spent waiting
# for CPU.
hand_test(
    name = "units_parity",
    layer = "selftest",
    size = "medium",
    srcs = ["units_parity_test.sh"],
    args = [
        "--units-awk",
        "$(rootpath //tools:units.awk)",
        "--first-red",
        "$(rootpath //tools:first_red.sh)",
    ] + [
        a
        for p in _UNIT_PACKAGES
        for a in ["--package", "$(rootpath %s:units)" % p]
    ] + [
        a
        for p in _LAYERED_FIXTURES
        for a in ["--layers", "$(rootpath %s:layers)" % p]
    ],
    data = [
        "//tools:units.awk",
        "//tools:first_red.sh",
        "//tools:stub_check.sh",
    ] + [p + ":units" for p in _UNIT_PACKAGES] +
    [p + ":test_units" for p in _UNIT_PACKAGES] +
    [p + ":subject" for p in _UNIT_PACKAGES] +
    [p + ":conventions_srcs" for p in _UNIT_PACKAGES] +
    [p + ":layers" for p in _LAYERED_FIXTURES],
)
