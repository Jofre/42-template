c_levels()

# ---------------------------------------------------------------------------
# THE DIFFERENTIAL LAYER, against //oracle's c10 reference.
#
# WHY, given that every exercise above already has fixtures. The subject's own
# sentence is the reason: "You must complete this exercise by declaring a
# fixed-size array." All four of these are a READ LOOP around a buffer, and a
# read loop is wrong at exactly the sizes nobody commits a fixture for. The
# corpus walks the boundaries around every buffer size people choose -- 4, 8,
# 16, 32, 64, 128, 256, 512, 1024, 4096, and the ~30 000 ex01's subject names --
# testing size-1, size and size+1 at each, and carries content a text fixture
# cannot: NUL bytes, runs of 0xff, a file with no trailing newline, and a file
# that is one enormous line.
#
# Measured against deliberately broken programs: a loop that reads ONCE fails 4
# of 60, and one that writes `strlen(buf)` instead of the byte count fails 22 of
# 60. Neither is visible in a committed text fixture.
#
# The reference itself was cross-checked against the system tools -- 340 cases
# through the real `hexdump -C`, `tail -c` and `cat`, zero mismatches -- and the
# runner was then driven with those same tools standing in for a correct
# student, so the escape, the file materialisation and the comparison are all
# proven end to end rather than assumed.
#
# ex03's corpus dumps one to three files per case as one stream, and ends with
# the shapes only a stream has: a run of identical lines crossing a boundary,
# a line made of the ends of three files.
#
# STANDARD ERROR is compared, and must be empty (--stderr-empty): every input
# the reference generates is a readable file, and the subjects give such a file
# no message. ex00: "Error messages must be displayed on their designated
# output", and of its three messages none is about a file that can be read;
# ex01-ex03: "performs the same function as the system's" tool, which is quiet
# on a readable file -- a reading, and this layer is strict. A message printed
# about an empty file, which basic's `empty_stderr` catches for ex00 alone,
# is caught here for all four.
#
# WHAT IS NOT HERE, and it is deliberate:
#
#   * error paths, and ft_tail with two or more files, which print `==> path
#     <==` headers. The path is chosen by the runner at run time, so a corpus
#     carrying one would be testing the runner. The named cases above hold
#     them, with fixed names: ex00's three messages, which its subject quotes;
#     and for ex01-ex03 the good files' bytes at basic and the messages and
#     statuses at strict (the reading at the top).
#   * the exit status of a corpus run: a readable file is no error, so this
#     layer would judge only the Run contract's convention, which the named
#     cases' robust twins already do.
#
# `--expect-transform` refuses a corpus whose output never differs from its
# input (which `cat` would pass); `--expect-substring '*'` refuses a hexdump
# corpus that never produces the squeeze line.
#
# hand_test(), so each gets what every macro-emitted test gets from _test():
# its exercise's tag, which puts it in :exNN (the old lvl_tags() gave none,
# and these were missing from their suite: finding 070), and the level ladder
# of its layer, read from _LAYER_LEVEL rather than written here.
#
# ONE TABLE for the plain replays and their memory twins below: c_levels()'
# audit holds each plain replay to twins of exactly its corpus, and a count
# written twice drifted once (ex03's went to 180 here and stayed 90 there).
C10_FILE_CORPORA = [
    ("00", "c10_display_file", "60", []),
    ("01", "c10_cat", "60", []),
    ("02", "c10_tail", "90", ["--expect-transform"]),
    # 180 files, cut into one to three per case: about as many runs as
    # when each case was one file.
    ("03", "c10_hexdump", "180", ["--expect-transform", "--expect-substring", "*"]),
]

[
    hand_test(
        name = "ex%s_file_diff" % num,
        layer = "diff",
        size = "medium",
        srcs = ["//tools:file_check.sh"],
        args = [
            "--bin",
            "$(location :ex%s_bin)" % num,
            "--oracle",
            "$(location //oracle:oracle)",
            "--fn",
            fn,
            "--count",
            count,
        ] + extra + ["--stderr-empty"],
        data = [
            ":ex%s_bin" % num,
            "//oracle:oracle",
            "//tools:file_check.sh",
            "//tools:exit_status",
            "//tools:runner_lib.sh",
        ],
    )
    for num, fn, count, extra in C10_FILE_CORPORA
]

# THE CORPUS UNDER THE MEMORY CHECKERS (finding 113): each file corpus on the
# ASan build (exNN_file_diff_asan, robust), judging memory and how each run
# ended, never the bytes; and for ex02 and ex03, whose subjects allow malloc
# (corpus_memory reads that from the contract), 25 cases under memcheck
# (exNN_file_valgrind, strict). The corpus is where the files past one buffer
# are (4096, 30000 bytes), and no fixed case's memory arm reads one. Measured
# on correct programs (2026-10-02): 3-4 s under ASan, 23-25 s under memcheck,
# each well inside "medium"'s 300 s.
[
    corpus_memory(
        stem = "ex%s_file" % num,
        runner = "//tools:file_check.sh",
        args = [
            "--oracle",
            "$(location //oracle:oracle)",
            "--fn",
            fn,
            "--count",
            count,
        ] + extra,
        data = ["//oracle:oracle"],
    )
    for num, fn, count, extra in C10_FILE_CORPORA
]
