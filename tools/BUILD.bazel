load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Measurement primitive for the performance layer: runs a command and reports
# wall time + peak RSS from wait4(). GNU `time -v` would do the same but is not
# installed here and is not guaranteed on the campus box; the shell's `times`
# reports no memory at all. See tools/perf_run.c.
cc_binary(
    name = "perf_run",
    srcs = ["perf_run.c", "runqueue.h"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    visibility = ["//visibility:public"],
)

# How a run ended, from waitpid(): "exit N" or "signal N". The shell's 128+N
# cannot tell `return (-1);` (255) from a death by signal 127, and every runner
# that judges how a student's program ended reads this instead. See
# tools/exit_status.c. defs.bzl's _test() adds it to the data of every test
# whose runner needs it (_EXIT_STATUS_RUNNERS); the runners refuse to run
# without it.
cc_binary(
    name = "exit_status",
    srcs = ["exit_status.c", "runqueue.h"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    visibility = ["//visibility:public"],
)

# A preload library: a turned-in script that opens one fixed path reads a
# fixture instead. Loaded into the run by shell_check.sh's ck_run where a
# shell_exercise call declares `redirect` (Shell 01 ex07 reads /etc/passwd,
# and a laptop's shows too few of the exercise's steps). See
# tools/path_redirect.c.
cc_binary(
    name = "path_redirect.so",
    srcs = ["path_redirect.c"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    linkopts = ["-ldl"],
    linkshared = True,
    visibility = ["//visibility:public"],
)

# Shared helpers for live-differential reader harnesses (see diffio.h). Included
# by the per-exercise diff_<fn>.c readers via the c_diff() macro. And every
# block malloc hands out in a program linking it starts holding 0xa5, never a
# zero (dirty_malloc.c says why, how much of a block, and why no memcheck layer
# may run such a program -- c_levels()' audit refuses one): the linkopt
# reaches each student_binary that links this library, as a cc_library's
# linkopts reach a cc_binary, and //tools/tests:diffio_probe holds it. alwayslink:
# the wrap renames malloc in the shared libraries on the link line too
# (libstdc++), so __wrap_malloc must be defined even in a program whose own
# code never calls malloc, or the link fails there.
cc_library(
    name = "diffio",
    srcs = ["dirty_malloc.c"],
    hdrs = ["diffio.h"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    includes = ["."],
    linkopts = ["-Wl,--wrap=malloc"],
    alwayslink = True,
    visibility = ["//visibility:public"],
)

# Makes stdout unbuffered in the harness's own output fixtures, so the rows a
# fixture printed before a crash reach diff_output.sh. alwayslink: nothing
# references the object by name, and without it the linker drops the
# constructor. Linked only through defs.bzl's _output_fixture_binary; the two
# runners that compile a fixture at test time get the source (exported below)
# through --harness-src. See the file for where it must never go.
cc_library(
    name = "unbuffered_stdout",
    srcs = ["unbuffered_stdout.c"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    alwayslink = True,
    visibility = ["//visibility:public"],
)

# Runner scripts used by the test macros in defs.bzl.
exports_files([
    # The same library as a source file, for header_check.sh and ilp32_test.sh,
    # which compile the fixture themselves.
    "unbuffered_stdout.c",
    # diffio's malloc, as a source file: the selftest builds a toy reader with
    # it, as //tools:diffio links it.
    "dirty_malloc.c",
    # Sourced by every runner that runs student code or prints clues: the time
    # budget, signal traps, byte rendering, excerpts, the clues.tsv rule and how
    # a run ended, written once. defs.bzl's _test() adds it to every test it
    # emits; a hand-written sh_test lists it in its own data.
    "runner_lib.sh",
    "norminette_test.sh",
    "compile_check.sh",
    "asan_check.sh",
    "diff_output.sh",
    "rust_diff.sh",
    # Triage filter: folds a wall of `bazel test` output into one next objective.
    # Not a layer -- it reads logs, it does not produce a verdict -- but it is
    # exported for //tools/tests:selftest, which covers it because a triage that
    # names the wrong exercise sends someone to the wrong file.
    "first_red.sh",
    # Read by first_red.sh, beside it: _SUFFIX_LAYER, _LAYER_LEVEL and _RAISED
    # say which layer a red target is and at which level it sits, so a red is
    # filed by the level c_levels()' audit gives it, never by a list of its own.
    "defs.bzl",
    # Grid VALIDATOR for c-piscine-rush-01 ex00. Not a diff: rush01's subject
    # asks for "the first solution you encounter", so 66 of the 438 solvable clue
    # vectors have several correct answers and a byte fixture would fail correct
    # programs. See the header of the script.
    "rush01_check.sh",
    "rush02_check.sh",
    # Differential runner for c-piscine-bsq. One exec per map, because bsq is a
    # PROGRAM: there is no function to link into a diff_*.c harness, so the
    # corpus is replayed by a shell loop rather than streamed through one
    # process. Unlike rush02_check.sh it GATES -- bsq's subject fixes the
    # answer, including which of several equally big squares to draw.
    "bsq_check.sh",
    # Differential runner for a program whose input is its ARGUMENTS, which is
    # all four of c-06's. One exec per case for bsq_check.sh's reason -- a
    # program that takes its input on the command line cannot be streamed --
    # and generic rather than per-module, because the corpus shape (a list of
    # arguments and the bytes they must produce) is not specific to c-06.
    "argv_check.sh",
    # Differential runner for a program whose input is FILES -- c-10's four.
    # Materialises each case's file contents into a scratch directory and runs
    # the binary on those paths, so the corpus can carry NUL bytes and 30 000
    # byte files that no committed fixture does.
    "file_check.sh",
    "oracle_check.sh",
    # A program case's expected file against the //oracle model it was made
    # from: c_program's `model`, which emits exNN[_case]_model. Runs nothing
    # of the student's. See its header.
    "model_check.sh",
    # Holds a project's named fixtures to the //oracle arm that writes them
    # (BSQ's bsq_fixtures, Rush 00's rush00_fixtures, Rush 02's
    # rush02_fixtures), so a fixture and the reference cannot drift.
    "oracle_fixtures.sh",
    # Runs every named case of a program with //oracle's reference in the
    # student's place (c_program's reference = True), so a case and the
    # expected file it names cannot drift apart.
    "reference_cases.sh",
    "perf_test.sh",
    "cycles_check.sh",
    "ref_compare.sh",
    "diffio.h",
    "files_test.sh",
    # A file 42 issues that the subject turns in is there: c_issued's runner,
    # which words its report from the registry beside it (resources.tsv).
    "issued_test.sh",
    "resources.tsv",
    "header_check.sh",
    # The Norm's two header rules the pinned norminette skips -- protection
    # from double inclusions, a tag's prefix inside a typedef -- which
    # c_levels() runs on every header a project turns in (exNN_norm_header).
    "header_norm.sh",
    # The method layer: what a subject says about HOW a turn-in is built,
    # which nothing it prints shows -- recursive or iterative (c_function's
    # `method`), a fixed-size array and its bound (c_program's
    # `fixed_array`) -- and the recorder the first links into the
    # exercise's own test program.
    "method_check.sh",
    "method_shim.c",
    "asan_run.sh",
    "prototype_check.sh",
    "argv_table.sh",
    "progname_test.sh",
    "valgrind_test.sh",
    "run_check.sh",
    "symbols_test.sh",
    "ilp32_test.sh",
    "forbidden_symbols.sh",
    "make_test.sh",
    # Not a test layer: it BUILDS. Every program built from a student's files
    # goes through it (tools/student_build.bzl), so their code never fails the
    # build: what does not build becomes a stand-in program that says why.
    # standin.sh is that contract, sourced by the builder and by every runner
    # that runs a built program. See both headers.
    "student_build.sh",
    "standin.sh",
    # The test a layer becomes when the files it checks were not turned in:
    # defs.bzl's _test(turnin = ...). See its header.
    "no_turnin.sh",
    # Exported for //tools/tests:selftest. Not a layer either -- it is the
    # maintainer's "has campus upgraded anything?" -- but its grading is
    # comparison logic, and comparison logic that stops comparing is what this
    # whole repo is careful about.
    "env_drift.sh",
    # Exported for //tools/tests:selftest. Not a layer: Bazel's --run_under,
    # which stands a program with one mistake in for the student's, to measure
    # which targets catch it. See its header.
    "probe_under.sh",
    "shell_test.sh",
    "shell_check.sh",
    "generate.sh",
    # Exported for //tools/tests:selftest, not for any module: stub_check is a
    # maintainer tool rather than a test layer, but it is the one whose failure
    # publishes an answer, so it is covered like a layer. prime.sh is here for
    # the same reason -- it is wired into the shell profile, so its failure mode
    # is every new terminal greeting the student with an error.
    "prime.sh",
    "stub_check.sh",
    # Writes the SUBJECT-PLACEHOLDER.pdf the template ships where each 42
    # subject was. Exported for //tools/tests:selftest, which checks the one
    # thing a PDF reader is strict about: every cross-reference offset.
    "placeholder_pdf.sh",
    # Finds an exercise's answer outside deliverable/ and generators/. The
