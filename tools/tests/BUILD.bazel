        # And the pinned ld.bfd with a library beside the libbfd it loads:
        # cycles_check.sh links its -O2 build with them (TO VERIFY V38).
        "--ld",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-ld.bfd)",
        "--ld-lib",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/lib/x86_64-linux-gnu/libbfd-2.38-system.so)",
