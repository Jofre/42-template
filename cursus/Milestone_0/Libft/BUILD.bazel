# ==== GROUP chars: ft_isalpha ft_isdigit ft_isalnum ft_isascii ft_isprint ft_toupper ft_tolower ====

# THE CHARACTER FUNCTIONS. Part 1 (p.8): "Your version will have the same
# prototypes and behaviors as the originals, adhering strictly to their
# definitions in the man page." man 3 isalpha says c "must have the value of
# an unsigned char or EOF", and man 3 toupper "If c is neither an unsigned
# char value nor EOF, the behavior of these functions is undefined.", so
# nothing outside EOF..255 is tested, at any level. And for the five
# classifiers p.8 fixes the return value, which the man page leaves at
# "nonzero":
#
#   "For the character classification functions (isalpha, isdigit, isalnum,
#    isascii, isprint), the return value must be:
#      • 1 if the character matches the tested class
#      • 0 if the character does not match"
#
# so a classifier that answers 1024 (as glibc's does) is red at basic: the
# subject's own words, not a reading. The classes are the "C" locale's, the
# one a program runs in until it calls setlocale().
#
# Each fixture is EXHAUSTIVE: all 257 values, EOF and 0..255, one row per
# range of codes (cut where a class of man ascii starts or ends), each row
# printing one result per code. The fixtures hold no string, so the
# high-byte row and the row past 4096 bytes of the string fixtures have no
# counterpart here; 0x80..0xff are four of the rows.
#
# no c_diff: SMALL-INPUT-SPACE (the fixture is the whole domain).
# no c_mem_check: NO-SURFACE (an int in, an int out: no buffer to bound).
# no c_cycles, no c_perf: BOUNDED-COST.
# No `readings`: p.8 and the man page leave no case of EOF..255 open.

c_function(
    num = "00",
    fn = "ft_isalpha",
    member = "ft_isalpha",
    test = "test_ft_isalpha.c",
    labeled = True,
    clues = "clues.tsv",
)

c_function(
    num = "00",
    fn = "ft_isdigit",
    member = "ft_isdigit",
