c_function(num = "07", fn = "ft_strupcase", test = "test_strupcase.c", allowed = [], labeled = True, clues = "clues.tsv")

# ft_strupcase edits its string IN PLACE up to the NUL. Under ASan on an EXACTLY
# strlen+1 heap buffer, any off-by-one that scans, writes, or re-terminates one
# slot past the NUL overflows and is caught here (the cased text can still look
# right to output diffing).
c_mem_check(num = "07", fn = "ft_strupcase", probe = "mem_strupcase.c")

c_diff(num = "07", fn = "ft_strupcase", harness = "diff_strupcase.c", oracle_fn = "c02_strupcase", diff_clues = "diff_clues.txt")

c_function(num = "08", fn = "ft_strlowcase", test = "test_strlowcase.c", allowed = [], labeled = True, clues = "clues.tsv")

# ft_strlowcase edits its string IN PLACE up to the NUL. Under ASan on an
