load("//tools:defs.bzl", "c_cycles", "c_diff", "c_function", "c_levels", "c_mem_check", "exercise", "subject")

# THE SUBJECT CONTRACT (tools/subject.bzl), from each exercise's header box.
subject(
    grader = "both",
    group = False,
    exercises = {
        "00": exercise(page = 8, dir = "ex00/", files = ["ft_strdup.c"], allowed = ["malloc"]),
        "01": exercise(page = 9, dir = "ex01/", files = ["ft_range.c"], allowed = ["malloc"]),
        "02": exercise(page = 10, dir = "ex02/", files = ["ft_ultimate_range.c"], allowed = ["malloc"]),
        "03": exercise(page = 11, dir = "ex03/", files = ["ft_strjoin.c"], allowed = ["malloc"]),
        "04": exercise(page = 12, dir = "ex04/", files = ["ft_convert_base.c", "ft_convert_base2.c"], allowed = ["malloc", "free"]),
        "05": exercise(page = 13, dir = "ex05/", files = ["ft_split.c"], allowed = ["malloc"]),
    },
)

# allocfail is ON here, and c-08 ex04 is no longer the only exercise with it.
#
# The rule it checks is not in this subject's own words, which is why it was
# left off until now: the subject says "Reproduce the behavior of the function
# strdup (man strdup)", so the contract is the man page's, and that page states
# the return -- NULL when there is not enough memory. c-08 ex04 spells the same
# rule out directly; here it arrives by the reference the subject makes.
#
# A weaker hook than a sentence in this subject, but a hook, and the layer sits
# at level 1 on the strength of it: a cited contract is not a requirement the
# harness invented, which is the only thing `basic` has to be protected from.
#
# This target is RED, and the audit that moved the level is why the level moved.
# ft_strdup calls malloc and dereferences the result with nothing in between, so
# it dies on SIGSEGV the first time an allocation is refused -- and at level 3
# it was red in `bazel test //...` while `bazel run //tools:submit`, which gates
# at `basic` in every fresh clone, pushed the module green. A layer that only reports
# to people who already run everything is not a gate.
#
# It earns its place because ignoring malloc's answer is not a style question:
# the line after it dereferences the pointer.
c_function(
    num = "00",
    fn = "ft_strdup",
    test = "test_strdup.c",
    malloc = True,
    allocfail = "af_ft_strdup.c",
    allocfail_rule = "man 3 strdup, where C 07, p.8 sends you (\"Reproduce the behavior of the function strdup (man strdup).\"): \"It returns NULL if insufficient memory was available\" (RETURN VALUE)",
    labeled = True,
    clues = "clues.tsv",
)

# Live differential fuzz against the Rust reference (//oracle): a seeded 400k
# inputs, exact-value compare. The reference emits the duplicated content; the
# harness allocates via ft_strdup and reprints it.
c_diff(num = "00", fn = "ft_strdup", harness = "diff_strdup.c", oracle_fn = "c07_strdup", diff_clues = "diff_clues.txt")

# ft_strdup must read no further than src's terminator and write no further
# than its own block. This runs it under ASan on an EXACT-SIZE heap src (no
# trailing slack): an over-read past the NUL, or an alloc too small for what is
# written into it, is caught here (stdout diffing can't see it).
c_mem_check(num = "00", fn = "ft_strdup", probe = "mem_strdup.c")

c_function(
    num = "01",
    fn = "ft_range",
    test = "test_range.c",
    malloc = True,
    labeled = True,
    clues = "clues.tsv",
)

c_diff(num = "01", fn = "ft_range", harness = "diff_range.c", oracle_fn = "c07_range", diff_clues = "diff_clues.txt")

# ft_range fills a block it allocated itself. This runs it under ASan so a fill
# that writes one int past that block is caught as a heap-buffer-overflow
# (stdout diffing can't see the stray write).
c_mem_check(num = "01", fn = "ft_range", probe = "mem_range.c")

# allocfail is ON here too, and on a stronger hook than ex00's: this subject
# names the error return in its own words. p.10 states two error channels as two
# separate bullets -- "The size of range should be returned (or -1 on error)"
# and "If the value of min is greater or equal to max's value, range will point
# to NULL and it should return 0". The logical condition owns the 0, so the only
# error left that can produce the -1 is a failed allocation, and nothing in this
# suite had ever made one fail. That branch was not weakly tested; it was dead
# code, which is the code most likely to be wrong because nothing has ever run
# it -- including the person who wrote it.
#
# A function that returns 0 there gives the answer the OTHER bullet asks for,
# and no other layer can see it -- the fixture, the differential, ASan and
# valgrind all run the success path. The probe says what the call returned
# (af_note), so the report names the value, never "a pointer".
c_function(
    num = "02",
    fn = "ft_ultimate_range",
    test = "test_ultimate_range.c",
    malloc = True,
    allocfail = "af_ft_ultimate_range.c",
    allocfail_rule = "C 07, p.10: \"The size of range should be returned (or -1 on error).\"",
    labeled = True,
    clues = "clues.tsv",
)

c_diff(
    num = "02",
    fn = "ft_ultimate_range",
    harness = "diff_ultimate_range.c",
    oracle_fn = "c07_ultimate_range",
    diff_clues = "diff_clues.txt",
)

# ft_ultimate_range fills a block it allocated itself and hands back through
# *range. This runs it under ASan so a fill that writes one int past that block
# is caught as a heap-buffer-overflow (stdout diffing can't see the stray write).
c_mem_check(num = "02", fn = "ft_ultimate_range", probe = "mem_ultimate_range.c")

c_function(
    num = "03",
    fn = "ft_strjoin",
    test = "test_strjoin.c",
    malloc = True,
    labeled = True,
    clues = "clues.tsv",
)

# ft_strjoin reads exactly `size` pointers from strs; it must never touch
# strs[size]. This runs it under ASan on a heap array sized to EXACTLY size,
# so a stray read one past the bound is caught (stdout diffing can't see it).
c_mem_check(num = "03", fn = "ft_strjoin", probe = "mem_strjoin.c")

c_diff(num = "03", fn = "ft_strjoin", harness = "diff_strjoin.c", oracle_fn = "c07_strjoin", diff_clues = "diff_clues.txt")

c_function(
    num = "04",
    fn = "ft_convert_base",
    test = "test_convert_base.c",
    # No srcs here on purpose. This is the one exercise in the module whose
    # subject asks for two files, and every macro now globs deliverable/ex04/*.c
    # instead of guessing one name -- so the file set is declared once, in the
    # subject() contract above, and checked against the directory rather than
    # copied into the build. Listing them here again is how c_cycles ended up compiling
    # only half the exercise.
    malloc = True,
    labeled = True,
    clues = "clues.tsv",
    # WHICH BASE IS INVALID: one rule, which the fixtures, the corpus and
    # every hint here follow. "nbr will follow the same rules as
    # ft_atoi_base" (C 07 p.12) puts base_from under C 04's list for reading
    # a number, which names whitespace, so a base_from holding whitespace is
    # invalid at basic (findings 077, 079). base_to is only written, and C
    # 04's list for writing a number names none, so whitespace in base_to,
    # and what the result's "no whitespaces" then asks, is a case the subject
    # leaves open. It is tested apart, in the base_to_space reading below (the
    # owner's, 2026-09-27), at strict, whose own hint states it; the strict
    # corpus never puts whitespace in base_to.
    readings = [
        {
            "name": "base_to_space",
            "main": "test_convert_base_to_space.c",
            "expected": "base_to_space.txt",
            "labeled": True,
            "clues": "clues_base_to_space.tsv",
            "level": 2,
        },
    ],
)

# c_diff names no sources at all: it links the :ft_convert_base cc_library built
# above, which now globs both files. Same for c_perf and c_argv_table elsewhere —
# only the macros that DECLARE a source list ever needed fixing.
#
# A READING, at strict, as C 04 ex04's and ex05's (its BUILD file says why):
# whether a base may hold a byte above 0x7f, or a control byte, is a case C
# 04's lists of invalid bases leave open. ex04_diff holds only the cases every
# reading agrees on; the ones they part on are held by ex04_readings, whose
# own legend states the reading it tests (V42), and by its ASan twin, which
# is handed no legend.
c_diff(
    num = "04",
    fn = "ft_convert_base",
    harness = "diff_convert_base.c",
    oracle_fn = "c07_convert_base",
    diff_clues = "diff_clues.txt",
    readings = {"oracle_fn": "c07_convert_base_readings", "diff_clues": "diff_clues_readings.txt"},
)

# WHY ex04 AND ex05 CARRY NO EXACT-SIZE ASan PROBE, while ex00-ex03 do.
#
# The other four allocate a block whose size the subject fixes exactly -- a
# string of known length, a range of known width -- so a probe can hand the
# function a heap block sized to fit precisely and a single byte past the end
# lands in a redzone rather than on a neighbouring allocation. That is a real
# check and it is why they have one.
#
# These two do not have that shape. ft_convert_base and ft_split BOTH decide
# their own allocation sizes from the input at runtime: how many symbols the
# output base needs, how many words the separators produce. There is no size the
# probe could assert that the function does not compute for itself, so an
# exact-size probe here would only be re-deriving the implementation and calling
# the agreement a test. What covers them instead is `c_diff`'s crash-fuzz twin,
# which runs the real allocation path under ASan across the whole corpus.
#
# (c-09 ex02 is the same function and the same reasoning; its BUILD file points
# back here rather than repeating this.)
c_function(
    num = "05",
    fn = "ft_split",
    test = "test_split.c",
    malloc = True,
    labeled = True,
    clues = "clues.tsv",
)

# perf_length: the length series grows one string, word by word, and reports
# what doubling the word count does to one split -- a count that rescans the
# string for every word is invisible over the corpus's short strings.
# Reported, never gated: for a split, that exponent is the algorithm.
c_diff(
    num = "05",
    fn = "ft_split",
    harness = "diff_split.c",
    oracle_fn = "c07_split",
    diff_clues = "diff_clues.txt",
    perf_length = {"oracle_fn": "c07_split_len", "harness": "len_split.c"},
)

c_levels()

c_cycles(
    num = "00",
    fn = "ft_strdup",
    oracle_fn = "c07_strdup",
    harness = "diff_strdup.c",
    unit_expr = "length($1)/2",
    unit_name = "byte",
    # copy archetype; budget measured from the implemented c-00..c-04 exercises.
    budget = 6,
    syscall_budget = 0,
)

c_cycles(
    num = "03",
    fn = "ft_strjoin",
    oracle_fn = "c07_strjoin",
    harness = "diff_strjoin.c",
    # The bytes of the joined result, which every answer must write: the
    # corpus line's last field (diff_strjoin.c's "Line:" comment; the first
    # field is the decimal size, and length($1)/2 counted half a byte a call,
    # finding 081).
    unit_expr = "length($NF)/2",
    unit_name = "byte",
    # The corpus's joins of 600 and 1500 strings test capacity (finding 041;
    # the diff layers judge them) and are left out here, as C 07 ex05's long
    # strings are: the budget below was measured on the usual case.
    max_unit = 1000,
    # MEASURED at -O2, without the allocator, on two correct answers written
    # apart: 25.9 and 19.4 instructions per joined byte. The 6 this replaced
    # was carried over from the copying exercises of C 02 and C 03, never
    # measured here, and no correct answer came near it. 34 is the usual ~30%
    # over the higher of the two.
    budget = 34,
    syscall_budget = 0,
)

c_cycles(
    num = "04",
    fn = "ft_convert_base",
    oracle_fn = "c07_convert_base",
    harness = "diff_convert_base.c",
    # Every input byte the function must read at least once: nbr and both
    # bases. A floor every technique shares, so the figure measures the axis
    # without choosing one.
    unit_expr = "(length($1)+length($2)+length($3))/2",
    unit_name = "byte",
    # NO BUDGET, on purpose: what one byte costs here follows how the student
    # looks a digit up in a base, so a budget would recommend the lookup it
    # was measured from (c-12 ex14's rule). The figure is printed alone.
    syscall_budget = 0,
)

c_cycles(
    num = "05",
    fn = "ft_split",
    oracle_fn = "c07_split",
    harness = "diff_split.c",
    # Every input byte the function must read at least once: str and charset.
    unit_expr = "(length($1)+length($2))/2",
    unit_name = "byte",
    # The corpus's two strings of 300 and 5000 words test capacity (finding
    # 041; the diff layers judge them) and are left out here: kept in, they
    # were half the bytes profiled, and the figure per byte measured their
    # mix of short words rather than the usual cost of one.
    max_unit = 1000,
    # NO BUDGET, on purpose: what one byte costs here follows how the student
    # tests a byte against the charset, so a budget would recommend the lookup
    # it was measured from (c-12 ex14's rule). The figure is printed alone.
    syscall_budget = 0,
)
