        # and every spelling needs the 5 with words before and after it. A
        # program that prints the words it can find, or prints as it goes and
        # stops at the gap, prints more than the dictionary error.
        {
            "name": "dict_cannot_express_mid",
            "invalid_input": True,
            "args": [
                "$(location tests/ex00/fixtures/nofive.dict)",
                "4542",
            ],
            "fixtures": ["tests/ex00/fixtures/nofive.dict"],
            "expected": "dicterr.txt",
            "clues": "clues.tsv",
        },
    ],
)

