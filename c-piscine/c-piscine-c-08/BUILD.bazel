load("//tools:defs.bzl", "c_diff", "c_function", "c_header", "c_levels", "c_mem_check", "exercise", "subject")

# THE SUBJECT CONTRACT (tools/subject.bzl), from each exercise's header box.
subject(
    grader = "both",
    group = False,
    exercises = {
        "00": exercise(page = 5, dir = "ex00/", files = ["ft.h"], allowed = []),
        "01": exercise(page = 6, dir = "ex01/", files = ["ft_boolean.h"], allowed = []),
        "02": exercise(page = 8, dir = "ex02/", files = ["ft_abs.h"], allowed = []),
        "03": exercise(page = 9, dir = "ex03/", files = ["ft_point.h"], allowed = []),
        # ex04 and ex05: "The structure will be defined in the ft_stock_str.h
        # file that we will provide". 42 does not, in fact, hand that file over,
        # so the harness's copy under tests/ was written from the struct the
        # subject prints (see ex04 below).
        "04": exercise(page = 10, dir = "ex04/", files = ["ft_strs_to_tab.c"], allowed = ["malloc", "free"], provided = {"tests/ft_stock_str.h": "ft_stock_str.h"}),
        "05": exercise(page = 12, dir = "ex05/", files = ["ft_show_tab.c"], allowed = ["write"], provided = {"tests/ft_stock_str.h": "ft_stock_str.h"}),
    },
)

# ex00 and ex03 carry no `probe`, and so have no `forbidden` layer, on purpose:
# ft.h holds prototypes and ft_point.h a lone typedef, so neither has anything
# that can be expanded into a call. There is no surface for the check to inspect
# -- not an omission.
c_header(
    num = "00",
    main = "test_ft_h.c",
    # Spelled out rather than left to c_header's default case, because the
    # default carries no `clues` key and these two were the only exercise test
    # directories in the repo with no hints at all. Adding the key to the DEFAULT
    # would be worse: it fires for every future c_header caller, and a missing
    # clues.tsv would become a Bazel analysis error rather than a soft absence.
    cases = [{"name": "compile", "expected": "expected.txt", "args": [], "clues": "clues.tsv"}],
)

# ft_boolean.h / ft_abs.h define function-like macros (EVEN, ABS); the subject
# mandates norminette -R CheckDefine for these so those macros are permitted
# ("Norminette must be launched with the -R CheckDefine flag. Moulinette will
# use it too."). The norm log prints it as the rule that took effect, with the
# command that reproduces the verdict by hand.
#
# That permission is exactly what opens the hole the `probe` closes. A macro is
# free to expand into a libc call -- an ABS that hands the work to abs() -- and
# until this layer existed that header passed all thirteen of ex02's checks
# while the subject's "Allowed functions: None" made it a KO. Norm cannot see it
# (the macro is legal), output cannot see it (the answer is right), and the
# header itself has no object file to inspect. The probe supplies one.
c_header(
    num = "01",
    main = "test_boolean.c",
    norm_flags = ["-R", "CheckDefine"],
    probe = "probe_boolean.c",
    cases = [
        {"name": "even", "args": [], "expected": "even.txt", "clues": "clues.tsv"},
        {"name": "odd", "args": ["x"], "expected": "odd.txt", "clues": "clues.tsv"},
        # SUCCESS is 0 -- asserted here, and nowhere else, because it needs its
        # own case rather than a flag on one of the two above: a `level`
        # applies to the whole test, and the printing is this exercise's actual
        # requirement.
        #
        # And it is an addition, not a quotation. The subject's main ends
        # `return (SUCCESS);` and the fixture copies it, which is the only way a
        # header's numeric value becomes observable at all -- a returned value
        # is invisible to a stdout diff. But the subject never states the value:
        # re-read 2026-08-10 to check precisely that, and ex01 names t_bool,
        # TRUE, FALSE, EVEN_MSG, ODD_MSG and SUCCESS while giving a number for
        # none of them. So this encodes the C convention (EXIT_SUCCESS == 0).
        #
        # Wired anyway, as the owner's call: the lesson -- that a header's
        # constants are part of its contract -- has no other reachable home in
        # this module. A status the subject does not name is checked at robust
        # by the Run contract (docs/reference.md), which c_header enforces: no
        # "exit_quote", so level 3, and a failure says the rule is this repo's.
        # Turning it off is deleting this dict.
        #
        # Its own clues file: clues.tsv's one hint is about EVEN and macro
        # precedence, which says nothing about the value main returned, and it
        # is what a failure of this case alone used to show.
        {
            "name": "success",
            "args": [],
            "expected": "even.txt",
            "clues": "clues_success.tsv",
            "exit": 0,
            "level": 3,
        },
        # EVEN applied to an EXPRESSION rather than to an int parameter. Held at
        # level 2 because the subject's own main never does it, so a header that
        # is correct against everything ex01 actually asks for must not go red at
        # the gate a beginner meets first. The lesson is real and worth keeping —
        # it is simply not this subject's requirement. See the file's own comment.
        {
            "name": "expr",
            "main": "test_boolean_expr.c",
            "args": [],
            "expected": "expr.txt",
            "clues": "clues.tsv",
            "level": 2,
        },
    ],
)

# The first hint of clues.tsv used to ask which operators choose between two
# values in one expression -- the conditional operator, which the pinned
# norminette (3.3.58, the campus version, tools/requirements.txt) reports as
# TERNARY_FBIDDEN inside a #define even with -R CheckDefine (finding 083,
# checked 2026-09-30): the flag permits the macro, not the rest of the Norm
# inside it. 3.3.59 and later exempt a define line, so re-read this if the
# pin moves. The hint names no construction now; keep it that way.
c_header(
    num = "02",
    main = "test_abs.c",
    norm_flags = ["-R", "CheckDefine"],
    probe = "probe_abs.c",
    cases = [
        {"name": "run", "args": [], "expected": "expected.txt", "labeled": True, "clues": "clues.tsv"},
        # "replaces its argument with its absolute value" names no type, so an
        # argument wider than int, or floating-point, is a case the subject
        # leaves open: strict (finding 087). Each has its own main, so a
        # header that cannot take one fails that case alone. Expected files by
        # hand, from the definition of absolute value.
        {
            "name": "long_arg",
            "main": "test_abs_long.c",
            "args": [],
            "expected": "long.txt",
            "labeled": True,
            "clues": "clues_types.tsv",
            "level": 2,
        },
        {
            "name": "double_arg",
            "main": "test_abs_double.c",
            "args": [],
            "expected": "double.txt",
            "labeled": True,
            "clues": "clues_types.tsv",
            "level": 2,
        },
    ],
)

# Two cases. `compile` is the subject's own main, exactly as printed -- the
# exercise. `int_fields` goes further than the subject, which never names the
# fields' type: it asks, through _Generic, whether they are int.
#
# Level 4 (complete), not 3. The subject's main only stores 42 and 21, so a
# t_point with long or double fields follows it to the letter, and robust is
# "rigour this repo adds" -- a header is not less correct for choosing another
# number type. What this case reports is a convention this repo chose, not the
# subject's, which is what complete's "informative more often than not" is for. It compiles whatever the type, so
# the basic compile layers never judge it either.
#
# No tests/layout/ft_point.h. That folder holds a structure the subject
# PRINTS -- C 12's t_list, C 13's t_btree -- checked at basic where the
# grader builds its own nodes on it, and at strict otherwise (its
# _layout_prototype twin). This subject prints no structure, only a main
# that must compile, which is `compile` below; a layout file would write
# down a structure of this repo's choosing and check it at strict, above
# the complete this convention was moved to (finding 088, WP-21).
c_header(
    num = "03",
    main = "test_point.c",
    cases = [
        {"name": "compile", "expected": "expected.txt", "args": [], "clues": "clues.tsv"},
        {
            "name": "int_fields",
            "main": "test_point_int.c",
            "expected": "expected_int.txt",
            "args": [],
            "labeled": True,
            "level": 4,
            "clues": "clues_int.tsv",
        },
    ],
)

# The exercise whose subject states the allocfail requirement in its OWN words,
# quoted below (allocfail_rule), and so the sentence its report quotes.
# Every other malloc exercise of this module says nothing about a failed
# allocation, and enabling the layer there would fail correct work against a
# rule the harness made up -- the same thing the subject() contract above
# refuses to do.
#
# allocfail_leaks: ex04_allocfail_leaks, at robust, asks what the basic sweep
# does not -- whether a call that reported the error left any block it had
# obtained before the refusal still allocated (finding 084). The subject asks
# only for the NULL pointer, and no grader at 42 refuses an allocation, so this
# is the repo's own rigour, which is what robust is for; ex04_allocfail's basic
# verdict is unchanged. It is on here because this subject allows free (the
# contract above: malloc, free); C 07 ex05 and C 09 ex02 allow malloc alone and
# must stay out.
c_function(
    num = "04",
    fn = "ft_strs_to_tab",
    test = "test_strs_to_tab.c",
    malloc = True,
    allocfail = "af_ft_strs_to_tab.c",
    allocfail_rule = "C 08, p.11: \"It should return a NULL pointer if an error occurs.\"",
    allocfail_leaks = True,
    labeled = True,
    clues = "clues.tsv",
)

# ft_strs_to_tab carries a SAFETY bound on av: from ac strings it must read only
# av[0..ac-1], never av[ac]. This runs it under ASan on an av heap block sized
# EXACTLY ac char* (plus ac 0/1) — a stray read past the bound is caught here
# (output diffing can't see it, since the returned tab can still be correct).
# ft_stock_str.h is the provided t_stock_str header, staged from tests/.
#
# IT CARRIES A 42 HEADER, AND IT HAS TO.
#
# The subject says "the structure will be defined in the ft_stock_str.h file
# that we will provide" -- but 42 does not, in fact, hand that file over, so
# this one was written here from the struct the subject prints. It is ours.
#
# This block used to claim the header had been REMOVED, so that the file would
# match every other file under tests/ (none of which has one). That was never
# achievable and the claim was false on the tree: the file is normed at level 4
# as ex04_norm_provided / ex05_norm_provided, and norminette rejects a source
# file with no 42 header -- INVALID_HEADER at line 1 -- whatever else it is
# passed. `-R CheckForbiddenSourceHeader`, which the norm runner passes, does
# not waive it either: the pinned norminette (tools/requirements.txt; true of
# 3.3.58, re-check when the pin moves) reads no -R value but CheckDefine, so
# that flag changes no rule at all. Measured by deleting the block and
# watching both targets go red.
#
# The old text also named a risk that is not real: that an identity change
# would "red the norm layer over a file nobody had touched". Norminette checks
# that a valid header EXISTS, not whose name is in it, so a stale login here
# fails nothing.
#
# What IS true, and worth keeping: tools/reset_headers.sh walks deliverable/
# only, so this file is not kept in step by it and its stamp will age. That
# costs nothing on the template -- the template build re-stamps every 42
# header it finds, this one included, so the published copy reads
# marvin <marvin@42.fr>. Verified on the 2026-08-11 build.
#
# IT IS NORMED, BUT NOT AS THE STUDENT'S RED. It is the contract's `provided`
# rather than a turned-in header, which stages it into every layer that has to
# compile against it and keeps it out of exactly one: ex04_norm / ex05_norm.
#
# Both halves of that matter. It is ours, so it should meet the standard the
# exercise is graded against -- that is `ex04_norm_provided`, at level 4. But it
# is not turned in: the Moulinette supplies its own copy and never norms this
# one, so a failure here is a failure the grade does not have. Reported inside
# the student's norm layer it would be a false red on a file they did not write
# and cannot fix, which is the defect class this repo ranks second worst.

c_mem_check(
    num = "04",
    fn = "ft_strs_to_tab",
    probe = "mem_ft_strs_to_tab.c",
)

# Live differential fuzz against the Rust reference (//oracle).
#
# WHY THIS EXERCISE AND NOT THE OTHERS HERE. The subject says `size` is "the
# length of the string", so the STUDENT computes a string length -- and that is
# where this repo's most-documented trap lives: a scan that treats any byte
# comparing as negative as the end stops dead at the first byte >= 0x80, because
# a plain `char` is signed.
# c-01 and c-02 pin exactly those corners for their own length and traversal
# exercises. tests/ex04/test_strs_to_tab.c drives "zero", "", "a" and
# "fortytwo!" -- printable ASCII throughout -- so the bug is red one module
# earlier and green here. The corpus opens with 0xff, 0x80, a run of five 0xff,
# and high bytes placed AFTER ordinary text so a loop that gets the first
# character right still stops early.
#
# The harness prints a RENDERING (`size/alias/hex-of-copy` per entry, then
# `;term=1`) rather than the array, because rust_diff.sh reports by LINE and a
# case that spans lines makes every one of its messages wrong. Each part is a
# sentence of the subject: the length, "str being the string" (the pointer
# handed in, not a copy of it), the copy's bytes, and "the last element's str
# set to 0".
#
# Lower count than the 400k default: every case mallocs an array plus one copy
# per string, so this is allocator-bound rather than compute-bound. The corners
# are emitted FIRST and only the seeded random tail shrinks, so nothing is lost.
#
# No arm for ex05 (ft_show_tab), assessed rather than overlooked: ft_show_tab
# computes nothing, so the trap that justifies this arm cannot reach it, and
# what is left is structural and identical in every case.
c_diff(
    num = "04",
    fn = "ft_strs_to_tab",
    harness = "diff_strs_to_tab.c",
    oracle_fn = "c08_strs_to_tab",
    count = 50000,
    asan_count = 20000,
    diff_clues = "diff_clues.txt",
)

c_function(
    num = "05",
    fn = "ft_show_tab",
    test = "test_show_tab.c",
    clues = "clues.tsv",
)

c_levels()
