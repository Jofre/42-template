    "audit-case-gate-stdin": contract_problem("audit", {
        "exercises": ["ex00"],
        "package": "c-piscine/c-piscine-toy",
        "tests": {
            "ex00_beside_output": dict(_CASE_OUTPUT, args = _CASE_OUTPUT["args"][:8] + ["--stdin", "$(location tests/ex00/in.txt)", "--", "42"]),
            "ex00_beside_valgrind": {
                "args": ["--bin", "$(location :ex00_bin)"] + _CASE_SWEEP["args"][2:] + ["--stdin", "$(location tests/ex00/in.txt)", "--", "42"],
                "srcs": ["//tools:valgrind_test.sh"],
                "tags": ["valgrind", "ex00"] + LEVELS[1:],
