c_mem_check(num = "08", fn = "ft_sort_int_tab", probe = "mem_sort_int_tab.c")

c_diff(num = "08", fn = "ft_sort_int_tab", harness = "diff_sort_int_tab.c", oracle_fn = "c01_sort_int_tab", diff_clues = "diff_clues.txt")


