# EVERY KNOB NO PROJECT TURNS. A macro's parameter, or a key of a case dict,
# that no call site in a module passes is still a promise: its docstring says
# what it does, and the first project that needs it will believe that. With no
# caller, nothing ever ran the branch -- a knob broken by a refactor stayed
# green everywhere, and a fixture that only checked the macro ACCEPTED the key
# (starlark_selftest's "every documented key is accepted") never emitted a
# target from it.
#
# So this package calls the macros on invented exercises with each such knob
# set to something other than its default, and :knobs below lists, per knob,
# what the targets it shapes were given: an argument and the value after it,
# whether a flag is there, which files an attribute holds, whether a target
# was declared at all. //tools/tests:macro_fixtures_test compares that with
# knobs.expected beside this file, so a knob whose branch stops emitting what
# its docstring says is a red test.
#
# Every test here is tagged manual (tools/defs.bzl's _test, as everywhere
# under tools/tests/macro_fixtures), and none is ever RUN: the toys name an
# //oracle arm that does not exist, and a verdict is not what this package is
# about. That every target it emits analyses -- each label it names is there
# -- is :toys_analysed's, at the end, which depends on every manual target
# here and builds none of them, so `bazel test //...` and
# macro_fixtures_test analyse each toy (V139).
#
# A knob that SOME call site passes is proven by that call site's tests and
# is not listed; one only another fixture passes is proven there (c_function's
# hdrs and exports, c_program's malloc, no_missing_file_case and refusals,
# rush_common's num and clues, a case's "valgrind": tools/tests/macro_fixtures
# and its ./root). `name`, which every macro takes for buildifier's sake and
# none reads, controls nothing and is not a knob.
#
# The toy project. subject(strict = False) and exercise(strict = True) are
# knobs of the contract itself: see the files layers below.
subject(
    grader = "moulinette",
    group = False,
    exercises = {
        # A function, with a file the subject allows and a header beside it:
        # the srcs/hdrs overrides leave toy_extra.c out, where the default
        # would compile it.
        "00": exercise(
            page = 1,
            dir = "ex00/",
            files = ["toy_twice.c"],
            optional = ["toy_extra.c", "toy_knob.h"],
            allowed = ["malloc", "free"],
        ),
        # The same function, for the other side of each knob ex00 turns.
        "01": exercise(page = 1, dir = "ex01/", files = ["toy_twice.c"], allowed = None),
        # A program, with the same two extras as ex00. No "Allowed functions"
        # line, so it may allocate and its case gets a valgrind arm; strict,
        # where the project is not.
        "02": exercise(
            page = 1,
            dir = "ex02/",
            files = ["toy_prog.c"],
            optional = ["toy_extra.c", "toy_prog.h"],
            allowed = None,
            strict = True,
        ),
        # A header exercise whose subject names two headers.
        "03": exercise(page = 1, dir = "ex03/", files = ["toy_a.h", "toy_b.h"], allowed = None),
        # A program whose runs are an argument table (C 06's shape).
        "04": exercise(page = 1, dir = "ex04/", files = ["toy_args.c"], allowed = None),
        # A library a script of the student's builds (C 09 ex00's shape), its
        # header in a folder of its own.
        "05": exercise(
            page = 1,
            dir = "ex05/",
            files = ["toy_creator.sh", "toy_a.c"],
            optional = ["inc/toy_lib.h"],
            allowed = ["write"],
        ),
        # A unit no exercise macro declares (student_lib), its header in a
        # folder only the unit's include directory reaches.
        "06": exercise(page = 1, dir = "ex06/", files = ["toy_six.c"], optional = ["inc/toy_six.h"], allowed = None),
        # Shell turn-ins: one of two scripts, compared by diff; one checked.
        "07": exercise(page = 1, dir = "ex07/", files = ["toy_a.sh", "toy_b.sh"], allowed = None),
        "08": exercise(page = 1, dir = "ex08/", files = ["toy.sh"], allowed = None),
        # Rush 00's shape: two shared files and a variant.
        "09": exercise(page = 1, dir = "ex09/", files = ["main.c", "ft_putchar.c"], optional = ["rush03.c"], allowed = ["write"]),
    },
    strict = False,
)

