    # no rc file names one. Exported for the selftest, which runs it with a
    # fake BAZEL_REAL that records what it was handed.
    "bazel",
])

# Bazel-run entry points. These intentionally mutate the source tree / talk to the
# network, so they are run-only (`bazel run`), never build/test dependencies. They
# locate the repo via BUILD_WORKSPACE_DIRECTORY.

# bazel run //tools:init  [-- --login L --email E]
#
# Not data: the campus warning about where this checkout's Bazel state is reads
# tools/drives.sh from the workspace (BUILD_WORKSPACE_DIRECTORY), as every
# script that asks it does. Beside the script is not a place under `bazel run`.
sh_binary(name = "init", srcs = ["init.sh"])

# bazel run //tools:42 -- [command]   (`42 help` lists the commands)
#
# The student front-end: tools/42.sh hands over to tools/fortytwo/main.py,
# and tools/fortytwo/commands.tsv says which target each command runs. This
# target is for a checkout where setup.sh has not installed the `42` shim yet.
# The Python is read from the workspace (BUILD_WORKSPACE_DIRECTORY), as init's
# drives.sh is, so it is not data.
sh_binary(name = "42", srcs = ["42.sh"])

# For the selftest's arms, which run the entry and the installer on a toy
# checkout with a stand-in python3 (tools/tests/selftest.sh, "42's entry").
exports_files([
        "42.sh",
        "fortytwo/install.sh",
])

# 42's modules, for //tools/tests:fortytwo_test. `imports` puts the folder on
# sys.path, as tools/fortytwo/main.py does for itself.
py_library(
    name = "fortytwo",
    srcs = glob(["fortytwo/*.py"]),
    data = ["fortytwo/commands.tsv"],
    imports = ["fortytwo"],
    visibility = ["//tools/tests:__pkg__"],
)

# Its tests and their fixtures, run by //tools/tests:fortytwo_test.
filegroup(
    name = "fortytwo_tests",
    srcs = glob(["fortytwo/tests/**"]),
    visibility = ["//tools/tests:__pkg__"],
)

# bazel run //tools:reset_headers  [-- -n]
sh_binary(name = "reset_headers", srcs = ["reset_headers.sh"])

# bazel run //tools:submit  [-- options/modules]
sh_binary(name = "submit", srcs = ["submit.sh"])

# bazel run //tools:generate   (regenerate every generated exercise: Shell 00,
# Shell 01 and Piscine Reloaded ex00-ex05; one module is //<module>:generate)
sh_binary(
    name = "generate",
    srcs = ["generate.sh"],
    args = [
        "c-piscine/c-piscine-shell-00",
        "c-piscine/c-piscine-shell-01",
        "c-piscine-reloaded/c-piscine-reloaded",
    ],
)

# bazel run //tools:gen_header -- ft_foo.c   (or Makefile, *.mk, *.sh)
#
# It PRINTS the header; paste it at the top of the file. Never redirect it onto
# the file it is for: `> ft_foo.c` empties the file before the header is written.
sh_binary(name = "gen_header", srcs = ["gen_header.sh"])

# bazel run //tools:prime
#
# Do the slow once-per-machine work now rather than during the first test:
# fetch every external repo (~2.1 GB), build the oracle, build every test
# binary. See the script's header for why this is not just `bazel test //...`.
sh_binary(name = "prime", srcs = ["prime.sh"])

# setup.sh is NOT a target, and cannot be: it is what installs the launcher that
# would run it. `sh tools/setup.sh`, before Bazel exists on the machine.
exports_files(["setup.sh"])

# bazel run //tools:stub_check  [-- c-piscine/c-piscine-c-02]
#
# The gate. Per file KIND it accepts an explicit whitelist and
# calls everything else an answer: inside a C body only `(void)x;` and a trivial
# return; in a deliverable header only include guards, unless the header's
# CONTENT hash is one of the two approved in the script; in a Makefile only
# recipes that echo; in a shell deliverable or generator no command at all. A
# shape-matching heuristic cannot do this — one waved through three real c-01
# answers whose solutions are a single line.
#
# It covers every kind because it once covered only `.c`, said "OK — all 123
# deliverable(s) are stubs", and published c-08's four finished header answers
# along with rush-00's rush.h and all 18 shell generators. //tools/tests:selftest
# now drives one green and one red per kind so a whole kind cannot fall out of
# scope again unnoticed.
sh_binary(name = "stub_check", srcs = ["stub_check.sh"])

# bazel run //tools:answer_scan   (on a tree WITH answers: is one copied out of the zone?)
sh_binary(name = "answer_scan", srcs = ["answer_scan.sh"])

# bazel run //tools:conventions
#
# The style gate. selftest.sh asks "can a layer report OK having checked
# nothing"; this asks whether the harness is worth copying. A student reads these
# runners, BUILD files and test mains to learn how tests are written here, so a
# rule followed 94 times and broken 3 times teaches that the rule is optional.
#
# The binary is the form you RUN by hand, over the real workspace, and it is the
# authoritative one: it sees every file on disk, including the handful nobody
# declares to Bazel at all. //tools/tests:conventions is the same script driven
# as a TEST over declared runfiles, so `bazel test //...` fails on a broken
# convention instead of waiting for someone to remember this command. That was
# possible once the file list stopped being hand-written: c_levels() emits each
# module's :conventions_srcs from a glob, and the script refuses to run if a
# module in submit.sh's table is missing from what it can see.
sh_binary(
    name = "conventions",
    srcs = ["conventions.sh"],
    args = [
        "--shellcheck",
        "$(location @shellcheck_linux_x86_64//:shellcheck)",
        "--buildifier",
        "$(location @buildifier_prebuilt//:buildifier)",
    ],
    data = [
        "@buildifier_prebuilt//:buildifier",
        "@shellcheck_linux_x86_64//:shellcheck",
    ],
)


# The hermetic norminette. The norm layer runs THIS, never the host's copy.
#
# Its version decides which rules exist, so a host copy makes the verdict depend
# on the machine -- and the verdict is supposed to be the one the Moulinette
# would give. Pinned in tools/requirements.txt (3.3.58, what the 2026-08-09 campus audit
# matched, and what .devcontainer/Dockerfile installs for running by hand).
#
# No empty __init__.py is made in its runfiles: .bazelrc's
# --incompatible_default_to_explicit_init_py says why, for every Python target
# of the repo (finding 047).
py_binary(
    name = "norminette",
    srcs = ["norminette_main.py"],
    main = "norminette_main.py",
    visibility = ["//visibility:public"],
    deps = ["@pip_tools//norminette"],
)

# bazel run //tools:env_audit [-- --commit --push]
#
# CAPTURE what this machine has, into tools/env-reports/<hostname>.txt. The
# script is also runnable bare -- `sh tools/env-audit.sh` -- and that is the
# form its own header leads with, because it is meant to run on a box where
# nothing is set up yet. This target exists so that "is it a bazel target or a
# script?" stops being a question anyone has to ask.
#
# Not to be confused with env_drift below: this one records what a machine has,
# env_drift compares a machine against tools/pins.tsv.
sh_binary(name = "env_audit", srcs = ["env-audit.sh"])

# For //tools/tests:selftest, which runs it in a sandbox repository.
exports_files(["env-audit.sh"])

# bazel run //tools:env_drift [-- --strict] [-- --report]
#
# Has this machine drifted from tools/pins.tsv? Run on a CAMPUS box it answers
# the only question that matters: have they upgraded anything the Moulinette
# compiles with?
#
# It warns and exits 0 by default. A student at an upgraded campus machine has
# done nothing wrong and can do nothing about it, so failing their build would
# punish them for 42's package update; --strict is for a maintainer deciding
# whether to re-pin. It never re-pins itself -- that would be a change to what
# the whole suite tests, made by nobody.
#
# The fetched binaries are data, and their paths reach the script through the
# env vars pins.tsv names in its last column. That is the third comparison: for
# any tool the layers no longer take from the box, "the pin matches the box"
# stops implying "the pin matches what our checks run", and only this says so.
# Add the binary here and name its variable in pins.tsv as each further tool
# stops coming from the host.
sh_binary(
    name = "env_drift",
    srcs = ["env_drift.sh"],
    # tools/drives.sh, which says which machine this is, is read from the
    # workspace like init's, so it is not listed here.
    data = [
        "norminette",
        "pins.tsv",
        "@binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-nm",
        "@buildifier_prebuilt//:buildifier",
        "@clang_12_ubuntu//:runtime",
        "@clang_12_ubuntu//:usr/lib/llvm-12/bin/clang-12",
        "@clang_12_ubuntu//:usr/lib/llvm-12/bin/llvm-symbolizer",
        "@clang_12_ubuntu//:usr/lib/llvm-12/lib/libclang-cpp.so.12",
        "@clang_12_ubuntu//:usr/lib/x86_64-linux-gnu/libLLVM-12.so.1",
        "@diffutils_ubuntu//:usr/bin/diff",
        "@gcc_10_ubuntu//:runtime",
        "@make_ubuntu//:usr/bin/make",
        "@shellcheck_linux_x86_64//:shellcheck",
        "@zig_linux_x86_64//:zig",
        "@gcc_10_ubuntu//:usr/bin/x86_64-linux-gnu-gcc-10",
        "@valgrind_ubuntu//:usr/bin/valgrind.bin",
    ],
    env = {
        "HERMETIC_BUILDIFIER": "$(rootpath @buildifier_prebuilt//:buildifier)",
        "HERMETIC_CLANG": "$(rootpath @clang_12_ubuntu//:usr/lib/llvm-12/bin/clang-12)",
        # <VAR>_LIBS is the convention for a fetched binary that carries its own
        # shared libraries. Without it the driver would load the box's copies
        # and this would report on a compiler other than the pinned one -- the
        # comparison failing in exactly the way it exists to catch.
        "HERMETIC_CLANG_LIBS": "$(rootpath @clang_12_ubuntu//:usr/lib/llvm-12/lib/libclang-cpp.so.12):$(rootpath @clang_12_ubuntu//:usr/lib/x86_64-linux-gnu/libLLVM-12.so.1)",
        "HERMETIC_DIFF": "$(rootpath @diffutils_ubuntu//:usr/bin/diff)",
        "HERMETIC_GCC": "$(rootpath @gcc_10_ubuntu//:usr/bin/x86_64-linux-gnu-gcc-10)",
        "HERMETIC_MAKE": "$(rootpath @make_ubuntu//:usr/bin/make)",
        "HERMETIC_NM": "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-nm)",
        "HERMETIC_NORMINETTE": "$(rootpath :norminette)",
        "HERMETIC_SHELLCHECK": "$(rootpath @shellcheck_linux_x86_64//:shellcheck)",
        # Loads libLLVM-12.so.1 by bare soname, as the driver above does.
        "HERMETIC_SYMBOLIZER": "$(rootpath @clang_12_ubuntu//:usr/lib/llvm-12/bin/llvm-symbolizer)",
        "HERMETIC_SYMBOLIZER_LIBS": "$(rootpath @clang_12_ubuntu//:usr/lib/x86_64-linux-gnu/libLLVM-12.so.1)",
        # valgrind.bin, not the /usr/bin/valgrind wrapper -- the wrapper execs
        # "$0.bin" and that derived path does not resolve from a runfiles tree.
        # No _LIBS entry: --version answers before valgrind needs its tool
        # directory, so this reports the fetched binary's own version without
        # $VALGRIND_LIB. The layers that actually RUN it do set it.
        "HERMETIC_VALGRIND": "$(rootpath @valgrind_ubuntu//:usr/bin/valgrind.bin)",
        "HERMETIC_ZIG": "$(rootpath @zig_linux_x86_64//:zig)",
    },
)

# Every shell script and Starlark file in this package, for //tools/tests:conventions.
# A glob, not a list: the objection to grading the style gate was always that a
# hand-written file list drifts, and this is the answer to it. The .patch is
# the doc passages the template build takes out, which checks read (see the
# second glob for why it is not in the first).
filegroup(
    name = "conventions_srcs",
    srcs = [
        "BUILD.bazel",
        # The wrapper bazelisk runs: shellchecked, and checked executable.
        "bazel",
        # The registry of 42's own files, whose wording checks read it.
        "resources.tsv",
        # The pinned Python requirements, each held to its files' hashes.
        "requirements.txt",
        # The 42 command's registry, held to the run targets of this file.
        "fortytwo/commands.tsv",
    ] + glob(
        [
            "*.sh",
            "*.bzl",
            # 42: its entry is *.sh above; these are what it hands over to,
            # and its tests, which the template ships too (one named the
            # private build script, and only `bazel run` saw it).
            "fortytwo/*.sh",
            "fortytwo/*.py",
            "fortytwo/tests/*.py",
            # The harness's own C, for the check that none defines a function
            # the grader brings (grader_lib.bzl).
            "*.c",
            "*.h",
        ],
        allow_empty = False,
    ) + glob(
        # The template-only doc passages, which name those files too. A glob
        # of its own, allowed to match nothing, because the template build
        # removes the patch: a label naming a missing file, or a pattern
        # matching nothing under allow_empty = False -- which applies to EACH
        # pattern, not to the list -- takes the whole package down there.
        # And any rc file kept here, which conventions checks for a shared
        # path like the root's.
        [
            "template_docs.pat*",
            "*.bazelrc",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/tests:__pkg__"],
)
