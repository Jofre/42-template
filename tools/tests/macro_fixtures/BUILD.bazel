# Its programs are the data of //tools/tests:macro_fixtures_test.
package(default_visibility = ["//tools/tests:__pkg__"])

# What a macro called BEFORE subject() fails with -- asked here, above the
# contract, on purpose; read with the other contract checks in
# :contract_problems below.
_BEFORE_SUBJECT = contract_problem("no_contract", {"macro": "c_function", "num": "00"})

# A toy project's subject contract, as every project opens with one
# (tools/subject.bzl): the macros take every turn-in path, file name and
# grader file from here. Only ex15 and ex18 name an "Allowed functions" line
# (every other toy has allowed = None), so only ex15 has a forbidden layer:
# ex18's every call is refused while loading (see A REFUSAL, WATCHED), so it
# emits nothing, and ex21's rush_common reads the missing line as no layer,
# as c_function does, never as "None" (an empty list, which fails any call).
# A toy turning in at the root of
# deliverable/, with its sources in srcs/ and includes/, is its own package,
# ./root: a root turn-in is a whole repository, so it is a project's only
# exercise. c_levels(), which this package does not call, has a toy module
# of its own, ./levels: what it finds, and the audit it runs on the whole.
subject(
    grader = "moulinette",
    group = False,
    exercises = {
        "00": exercise(page = 1, dir = "ex00/", files = ["toy_twice.c"], allowed = None),
        "01": exercise(page = 1, dir = "ex01/", files = ["toy_twice.c"], allowed = None),
        "02": exercise(page = 1, dir = "ex02/", files = ["toy_twice.c"], allowed = None),
        "03": exercise(page = 1, dir = "ex03/", files = ["toy_twice.c"], optional = ["toy.h"], allowed = None),
        "04": exercise(page = 1, dir = "ex04/", files = ["toy_twice.c"], allowed = None),
        "05": exercise(page = 1, dir = "ex05/", files = ["toy_twice.c"], allowed = None),
        "06": exercise(page = 1, dir = "ex06/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        "07": exercise(page = 1, dir = "ex07/", files = ["toy.h"], allowed = None),
        "08": exercise(page = 1, dir = "ex08/", files = ["Makefile"], allowed = None),
        "09": exercise(page = 1, dir = "ex09/", files = ["toy.sh"], allowed = None),
        "10": exercise(page = 1, dir = "ex10/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        "11": exercise(page = 1, dir = "ex11/", files = ["toy.c"], allowed = None),
        # Rush 01's shape: the .c files flat ("cc *.c"), a header anywhere.
        "12": exercise(page = 1, dir = "ex12/", files = [], optional = ["*.c", "**/*.h"], allowed = None),
        "13": exercise(page = 1, dir = "ex13/", files = [], optional = ["*.c", "**/*.h"], allowed = None),
        # C 09 ex01's shape: a Makefile alone, and the grader brings a file in
        # a subfolder of the turn-in.
        "14": exercise(
            page = 1,
            # A comment is not the contract: first_red read this line's
            # dir = None and took the root for this exercise's folder.
            dir = "ex14/",
            files = ["Makefile"],
            provided = {"tests/ex14/grader/srcs/toy.c": "srcs/toy.c"},
            allowed = None,
        ),
        # C 12's shape: the grader links a function of its own, compiled from
        # Rust (tools/grader_lib.bzl), which the harness calls. "None" allowed,
        # as C 12 ex02 says, so that it has a forbidden layer: that layer and
        # the symbols layer are told the grader brings toy_base (--provided).
        "15": exercise(
            page = 1,
            dir = "ex15/",
            files = ["toy_twice.c"],
            linked = {"toy_base": "//tools/tests/macro_fixtures:toy_grader"},
            allowed = [],
        ),
        # C 12's and C 13's other shape: a header the student turns in, whose
        # structure the subject prints (tests/layout/toy.h, and its names in
        # tests/layout/tag/toy.h). ex16 from ex01 on, where the grader links a
        # function of its own; ex17 as ex00, where it does not.
        "16": exercise(
            page = 1,
            dir = "ex16/",
            files = ["toy_twice.c", "toy.h"],
            linked = {"toy_base": "//tools/tests/macro_fixtures:toy_grader"},
            allowed = None,
        ),
        "17": exercise(page = 1, dir = "ex17/", files = ["toy_twice.c", "toy.h"], allowed = None),
        # A program that may open files: what c_program asks of its cases.
        "18": exercise(page = 1, dir = "ex18/", files = ["toy_reader.c"], allowed = ["open", "read", "write", "close"]),
        # BSQ's and Rush 02's shape: "Makefile and all the necessary files".
        "19": exercise(page = 1, dir = "ex19/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        # C 10's shape: the same file list, and a program built from its
        # sources directly, beside a c_make for the Makefile.
        "20": exercise(page = 1, dir = "ex20/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        # Rush 00's shape: two files every variant shares, a variant, and
        # any other .c a team writes for a bonus of its own.
        "21": exercise(page = 1, dir = "ex21/", files = ["main.c", "ft_putchar.c"], optional = ["rush03.c", "*.c"], allowed = None),
        # A Makefile the contract only allows: what c_make and c_program
        # refuse to build from (contract_problem("make_anchor"), and
        # c_program's refusal below; finding 124). Nothing is declared for it.
        "22": exercise(page = 1, dir = "ex22/", files = [], optional = ["Makefile", "**/*.c"], allowed = None),
        # A script turn-in that reads a file at a path its toy subject fixes,
        # the shape of Shell 01 ex07: shell_exercise's redirect.
        "23": exercise(page = 1, dir = "ex23/", files = ["toy.sh"], allowed = None),
        # A program built by its Makefile whose runs are an argument table
        # (C 06's shape, with a Makefile): c_argv_table's guarded replay is
        # built through the same Makefile.
        "24": exercise(page = 1, dir = "ex24/", files = ["Makefile"], optional = ["**/*.c"], allowed = None),
        # Functions whose subject names malloc, and free: what c_function's
        # `malloc` may not turn off (contract_problem("function_malloc")).
        # No macro is called on them.
        "25": exercise(page = 1, dir = "ex25/", files = ["toy_dup.c"], allowed = ["malloc"]),
        "26": exercise(page = 1, dir = "ex26/", files = ["toy_drop.c"], allowed = ["free"]),
        # C 10's shape again, its program c_program(makefile =
        # "once_written"): the Makefile decides once it compiles anything,
        # and until then the folder's sources are the program.
        "27": exercise(page = 1, dir = "ex27/", files = ["Makefile"], optional = ["**/*.c", "**/*.h"], allowed = None),
        "28": exercise(page = 1, dir = "ex28/", files = ["Makefile"], optional = ["**/*.c", "**/*.h"], allowed = None),
        # ex27's shape again, run through an argument table (C 06's runs):
        # the guarded-argv replay builds what the graded program builds.
        "29": exercise(page = 1, dir = "ex29/", files = ["Makefile"], optional = ["**/*.c", "**/*.h"], allowed = None),
    },
)

# ex15's grader function: invented, as every exercise here is.
grader_library(
    name = "toy_grader",
    src = "grader/toy.rs",
    exports = ["toy_base"],
)

# TOY EXERCISES IN EVERY BROKEN STATE A STUDENT'S TREE CAN BE IN.
#
# The harness used to be proven on two trees only: the stubs and one set of
# answers. Both compile, both hold every file, so neither ever showed what a
# syntax error, a leftover main() or a missing file did to the BUILD GRAPH --
# and each of those failed it: FAILED TO BUILD with no log, or a package that
# would not load, with every other exercise of the module unreported beside it
# (findings 034, 108, 128, 172). docs/design.md: "prove a check on more than
# two trees".
#
# So this package declares invented exercises -- never a Piscine one, and every
# file under deliverable/ is a stub by tools/stub_check.sh's rules (the broken
# ones are broken outside any function body, where a stub may hold anything) --
# through the same macros every module uses, one broken state each:
#
#   ex00  builds and passes                  the control: nothing here may change
#   ex01  a syntax error                     its programs are stand-ins
#   ex02  a main() beside the function       it does not link
#   ex03  nothing turned in, and a literal   its layers are "not turned in"
#         path to a header that is not there   tests; the package still loads
#   ex04  two files the subject never asked  only ex04_files is red, naming
#         for: toy_extra.c, and a main.c       both: every other layer --
#         that defines a second main()         the fixture, the memory probe,
#                                              ASan, the 32-bit build, norm,
#                                              symbols -- compiles the files
#                                              the contract names and no
#                                              other (:stray_reads)
#   ex05  two copies a desktop would name    only ex05_files is red, and names
#         "toy_twice copy.c" and "toy_twice    both; every other layer leaves
#         (1).c" beside the function           them out (defs.bzl's _safe())
#   ex06  a Makefile program, no Makefile    its programs are stand-ins
#   ex07  a header exercise, no header       "not turned in"
#   ex08  a Makefile exercise, no Makefile   "not turned in"
#   ex09  a shell exercise, no generator     "not turned in"
#   ex10  a Makefile program NOT STARTED:    its programs are EMPTY stand-ins,
#         the stub Makefile only echoes        which first_red files as "not
#                                              written yet", never as broken
#   ex11  a program (no Makefile) with a     its program and ASan twin are
#         syntax error, on a line saying       stand-ins: the compiler quotes
#         "internal compiler error"            that line, and it is no crash
#   ex12  a program compiled as `cc *.c`,    its program is a stand-in, and its
#         its header moved to includes/ and    compile layers are red: the
#         included as "toy12.h"                grader's include path has no
#                                              includes/ on it
#   ex13  the same, included as              a real program, compile layers
#         "includes/toy13.h"                   green
#   ex14  a Makefile turned in alone, with   ex14_files is red, naming
#         a copy of the file the grader        srcs/toy.c among the files the
#         brings in srcs/                      grader brings
#   ex15  a function the GRADER links        its program is real: the macros
#         (`linked`, from Rust), called        link the library everywhere,
#         by the harness; and a reading        and hand its archives to the
#         (c_function's `readings`)            ilp32 layer (" grader-lib");
#                                              its forbidden and symbols
#                                              layers are told the grader
#                                              brings toy_base (" provided");
#                                              the reading has its own program
#                                              and output test, at strict
#   ex16  a header in `files` whose          ex16_prototype checks the layout
#         structure the subject prints,        (" layout"), at basic; the twin
#         and a function the grader links      ex16_layout_prototype checks
#                                              the names alone (" layout-tag"),
#                                              at strict
#   ex17  the same header, and no            ex17_prototype checks no layout;
#         function the grader links            the twin checks both (" layout
#                                              layout-tag"), at strict
#   ex19  a Makefile program, and a .c its   ex19_files is red, naming
#         Makefile never compiles; c_make      toy19_unused.c among the sources
#         checks the Makefile too, called      the Makefile does not build, from
#         before c_program as BSQ's is         the program's own list: no second
#                                              build of it is declared
#   ex20  the same files, and no program     ex20_files is red, naming
#         declared: the Makefile is            toy20_unused.c the same way: the
#         c_make's alone                       list is a build for it alone
#                                              (ex20_make_bin)
#   ex21  a rush (rush_common), with a       ex21_extra_norm norms toy_switch.c
#         variant and a .c of a bonus of       alone (:ex21_extra_norm_files);
#         its own beside the shared files      main.c, ft_putchar.c and the
#                                              variant are normed elsewhere
#   ex27  C 10's shape, makefile =           its program is REAL, built from
#         "once_written", and the stub         toy27.c: an exercise whose
#         Makefile only echoes                 Makefile is not written yet is
#                                              tested on its program
#   ex28  the same, its Makefile written:    its program is real, built from
#         toy28.c with -I includes, its        toy28.c alone with -I includes:
#         header in includes/ included by      the Makefile decides, and the
#         name, and a second main() in         second main is never linked
#         toy28_unused.c
#   ex29  ex27's shape, run through an       its guarded-argv program is
#         argument table (c_argv_table)        REAL, built from toy29.c as its
#                                              graded one is: the guard takes
#                                              the sources a stub Makefile
#                                              leaves to be built too
#
# ex04 also keeps a copy of its function in backup/: the files layer walks
# the whole turn-in, so ex04_files names backup/toy_twice.c as well, by path.
#
# Every test here is tagged manual (tools/defs.bzl's _test does it for this
# package): most are red by design, and `bazel test //...` must stay about the
# modules. What is checked on every run is //tools/tests:macro_fixtures_test:
# that this package loads and its programs build (they are its data), that each
# program is a real one or a stand-in of the right kind, and that the tests
# emitted here are the ones layers.expected lists (see :layers at the end).
#
# What no test can check is each layer's VERDICT. Measured by hand on
# 2026-10-04 (after ex29, the guarded build over a stub Makefile) with
#
#     bazel test $(bazel query 'tests(//tools/tests/macro_fixtures:*)')
#
# 214 tests, 54 red; with --test_env=NO_SKIP=1, 84 red (the 30 skips below).
# "skips" below means green, and red under NO_SKIP=1. Every test here is
# manual, so a runfile one of them names and nothing writes breaks only
# these runs: macro_fixtures_test builds three of them whole for that.
#
#   ex00  all green, its memory probe's pair (asan, probe_memcheck) too.
#   ex01  red: norm, compile_clang, compile_gcc, output, prototype, symbols.
#         green: files, norm_notice (skips). ilp32 and memcheck skip.
#   ex02  red: output, symbols (the second main is exported). green: norm,
#         norm_notice, both compiles, files, prototype. ilp32, memcheck skip.
#   ex03  red, NOT TURNED IN: norm, both compiles, prototype, symbols; red:
#         files, output. norm_notice and ilp32 (NOT TURNED IN, gated) skip,
#         and so does memcheck.
#   ex04  red: files (main.c, toy_extra.c and backup/toy_twice.c). The
#         rest green, its memory probe's pair (asan, probe_memcheck) too: no
#         layer compiles a file the contract does not name (2026-10-03; the
#         probe, ASan and 32-bit builds failed on main.c's second main()
#         before, the fixture linked out of an archive did not).
#   ex05  red: files, naming 'toy_twice copy.c' and 'toy_twice (1).c'. The
#         rest green: no other layer sees either file.
#   ex06  red, NOT TURNED IN: norm, both compiles; red: output, exit.
#         norm_notice (gated), asan, valgrind and program_allocfail skip.
#   ex07  red, NOT TURNED IN: norm, both compiles, output. norm_notice skips.
#   ex08  red, NOT TURNED IN: build. build_exit and build_rules (gated:
#         its call quotes no sentence for clean, fclean or re, so what they
#         do is this repo's convention, at robust) skip.
#   ex09  red, NOT TURNED IN: files, norm, output. lint (gated) skips.
#   ex10  red: output and exit, "NOTHING TO BUILD YET". green: norm,
#         norm_notice, both compiles. asan and valgrind skip.
#   ex11  red: norm, both compiles, output, exit. norm_notice, asan, valgrind
#         and program_allocfail skip.
#   ex12  red: both compiles (saying the header is in a subfolder no -I
#         reaches), output, exit. green: norm, norm_notice. asan and
#         valgrind skip.
#   ex13  all green; program_allocfail says the toy asks for no memory.
#   ex14  red: files, naming srcs/toy.c under FILES THE GRADER BRINGS.
#   ex15  all green: its fixture, and its reading's, are what the stub and
#         the grader's function print. ilp32 builds at 32 bits with the
#         library's i686 archive (measured 2026-09-28, with NO_SKIP=1 too);
#         forbidden, whose stub calls nothing (2026-09-30).
#   ex16  red: prototype and layout_prototype, "the structure in your toy.h
#         is not the one", "does not name its structure": the stub toy.h
#         holds no t_toy. The rest green, as ex15 (2026-10-01).
#   ex17  red: layout_prototype, the same way. The rest green (2026-10-01).
#   ex19  red: files, naming toy19_unused.c under SOURCES YOUR MAKEFILE DOES
#         NOT BUILD; build (the stub Makefile only echoes). green: output,
#         exit, norm, norm_notice, both compiles, asan, valgrind. build_exit
#         and build_rules skip.
#   ex20  red: files, naming toy20_unused.c under SOURCES YOUR MAKEFILE DOES
#         NOT BUILD; build (the stub Makefile only echoes). build_exit and
#         build_rules skip. (Measured with its c_program, since refused:
#         2026-10-03, ex20_files and ex20_build alone.)
#   ex21  red: putchar_output (the stub puts nothing out). green: shared_norm,
#         extra_norm and their notices, both shared compiles, symbols. No
#         forbidden layer: its contract has no "Allowed functions" line.
#   ex23  red: output and regular, "toy.sh exists" (the stub generator
#         writes none). green: files, norm. lint and posix skip.
#   ex24  red: output (the stub prints nothing for ["x"]). green: norm,
#         norm_notice, both compiles, exit, asan, argv_asan.
#   ex27  all green: output, exit, asan and valgrind on the program its
#         sources make, norm, norm_notice, both compiles.
#   ex28  all green: the same, built from toy28.c with -I includes; both
#         compiles find toy28.h through the Makefile's -I (" make-includes").
#   ex29  red: output (the stub prints nothing for ["x"]). green: norm,
#         norm_notice, both compiles, exit, asan, and argv_asan on the
#         guarded program its sources make, as its graded one is (the guard
#         took the stub Makefile alone, and argv_asan skipped on an empty
#         stand-in: 2026-10-04).
#
# Re-measure after changing a macro or a runner, and update this list.

# `fn` names each exercise's unit, so it is unique per exercise; the function
# they all turn in is toy_twice.
[
    c_function(
        num = num,
        fn = "toy_twice_" + num,
        test = "test_toy.c",
        exports = ["toy_twice"],
    )
    for num in ["00", "01", "02", "04", "05"]
]

# ex16 and ex17: a header in `files`, read against tests/layout/ (see the
# contract above).
[
    c_function(
        num = num,
        fn = "toy_twice_" + num,
        test = "test_toy.c",
        exports = ["toy_twice"],
    )
    for num in ["16", "17"]
]

# ex15 also takes a reading (c_function's `readings`): a harness of its own
# over the same unit, raised to strict, whose program links the grader's
# function like the fixture's.
c_function(
    num = "15",
    fn = "toy_twice_15",
    test = "test_toy.c",
    exports = ["toy_twice"],
    readings = [{
        "name": "reading",
        "main": "test_reading.c",
        "expected": "reading.txt",
        "level": 2,
    }],
)

# A header named by hand that is not there: before _zone(), a declared input
# Bazel failed to find ("missing input file") for every layer that named it.
# Named through turnin_file(), as a module's BUILD file must name one.
c_function(
    num = "03",
    fn = "toy_twice_03",
    test = "test_toy.c",
    hdrs = [turnin_file("03", "toy.h")],
    exports = ["toy_twice"],
)

[
    c_files(num = num)
    for num in ["00", "01", "02", "03", "04", "05", "15"]
]

# A harness that is no output fixture: the memory probe's program. It names
# ex00_prototype as every harness over a student's files must (_student_bin's
# `prototype`), and :harnesses below lists it with the output fixtures.
c_mem_check(
    num = "00",
    fn = "toy_twice",
    probe = "mem_toy.c",
)

# ex04's, beside its stray main.c: the probe and its ASan twin link every
# source they are given directly, so they are where a second main() in a
# file the contract does not name used to break the build (:stray_reads).
c_mem_check(
    num = "04",
    fn = "toy_twice",
    probe = "mem_toy.c",
)

# Its case also hands the program a file and feeds it one on stdin, so the
# files a case reads (the case_reads tag :layers lists) are seen to hold all
# three kinds.
# The rule an allocfail target prints under its verdict: a toy's, since these
# are no subject's exercises.
TOY_RULE = "A toy rule, for the macro fixtures: errors are handled."

# ex06, ex11 and ex13 also build the allocation-failure twin
# (exNN_bin_allocfail, c_program's `allocfail`): from no Makefile, from a
# syntax error, and from a real program -- a stand-in of each kind where the
# others' programs are, and a program where theirs is.
c_program(
    num = "06",
    name = "toy",
    makefile = True,
    allocfail = "run",
    allocfail_rule = TOY_RULE,
    cases = [{
        "name": "run",
        "expected": "empty.txt",
        "fixtures": ["tests/ex06/fixtures/arg.txt"],
        "stdin": "tests/ex06/stdin.txt",
    }],
)

c_header(
    num = "07",
    main = "test_toy.c",
)

c_make(
    num = "08",
    artifact = "libtoy.a",
    not_checked = {
        "recipe": "the toy subject says nothing about how its library compiles",
        "wildcards": "the toy subject does not bind the Norm",
    },
)

# tags and run_tags: "env" on every test that judges the turn-in, and
# "no-sandbox" only on the ones that run it -- never on the files layer, which
# runs the generator alone (:shell_tags below).
shell_exercise(
    num = "09",
    mode = "diff",
    tags = ["env"],
    run_tags = ["no-sandbox"],
)

# A Makefile program driven by an argument table: the guarded-argv replay
# (exNN_argv_asan) is built from the program's own Makefile, as its graded
# program is (:argvguard_builds), where it used to be refused while loading.
c_program(num = "24", name = "toy_args", makefile = True)

c_argv_table(num = "24")

# The same table over a program whose Makefile is not written yet
# (makefile = "once_written", ex27's stub): the graded program is the
# folder's sources, and so is its guarded-argv build, which used to take the
# Makefile alone and be an empty stand-in beside a real program (V35).
c_program(num = "29", name = "toy29", makefile = "once_written")

c_argv_table(num = "29")

# A check-mode toy whose runs read a fixture in place of a path the subject
# fixes (redirect): every target that runs the turn-in -- the output test and
# each reading -- is handed the fixture and the preload library, and no
# other is (:redirect_args). Its generator is a stub, so its tests are red;
# what the redirect does to a run is proven by the selftest's --redirect
# arms on a turn-in that reads the path.
shell_exercise(
    num = "23",
    mode = "check",
    readings = {"regular": "regular.sh"},
    redirect = {"/etc/toy.conf": "toy.conf"},
    script = "sh",
    stable = False,
)

c_program(
    num = "10",
    name = "toy_stub",
    makefile = True,
    cases = [{
        "name": "run",
        "expected": "empty.txt",
    }],
)

c_program(
    num = "11",
    name = "toy_syntax",
    allocfail = "run",
    allocfail_rule = TOY_RULE,
    cases = [{
        "name": "run",
        "expected": "empty.txt",
    }],
)

# THE INCLUDE PATH IS THE GRADER'S. Both toys hold main.c and a header in
# includes/, and the grader compiles them as Rush 01's does: `cc *.c` in the
# turn-in directory, with no -I. ex12 includes "toy12.h", which no compiler
# run that way finds; ex13 includes "includes/toy13.h", which one does. The
# program built for the run layers, and every static layer, must agree.
[
    c_program(
        num = num,
        name = "toy" + num,
        allocfail = "run" if num == "13" else None,
        allocfail_rule = TOY_RULE if num == "13" else None,
        cases = [{
            "name": "run",
            "expected": "empty.txt",
        }],
    )
    for num in ["12", "13"]
