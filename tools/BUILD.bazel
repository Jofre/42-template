    "reset_headers.sh",
    "init.sh",
    # Sourced, never run: which machine this is, and where Bazel's state may
    # go on it. setup.sh, prime.sh, init.sh, env_drift.sh, env-audit.sh and the
    # wrapper below all ask it, so they cannot disagree (finding 001).
    "drives.sh",
    # Sourced, never run: the trace prime.sh writes of what the machine did
    # while it primed, and env-audit.sh reads back. Exported for the selftest,
    # which plants traces and kills a prime under it.
    "prime_trace.sh",
