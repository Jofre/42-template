{
  // Editor-agnostic test runner: works in VS Code AND Antigravity (and the
  // terminal). Bazel caches results, so re-runs are instant and show cached
  // PASSED/FAILED per target, with failing test output inlined. Run via:
  // Terminal > Run Task…, or Run Test Task for the default.
  //
  // The default is ONE module at its basic level: the module of the file open
  // in the editor, which is the nearest folder above the file whose
  // BUILD.bazel calls c_levels(, at any depth: <course>/<project>, or a
  // project inside a folder that groups several. The whole repo is the second
  // task, and it needs memory to spare: on a campus box, about 2.5 GB free,
  // it is more than the machine has (docs/environment.md).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel: test this module (basic)",
      "type": "process",
      "command": "sh",
      "args": [
        "-c",
        "d=$1; while :; do case $d in ''|.|..|../*|/*) break ;; esac; if grep -qs '^c_levels(' \"$d/BUILD.bazel\"; then exec bazel test \"//$d:basic\" --test_output=errors; fi; d=$(dirname \"$d\"); done; echo 'Open a file of the module to test first: one under its deliverable/ or tests/.' >&2; exit 2",
        "sh",
        "${relativeFileDirname}"
      ],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Bazel: test all (the whole repo: needs memory to spare)",
      "type": "shell",
      "command": "bazel test //... --test_output=errors",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
