# ---------------------------------------------------------------------------
# THE DIFFERENTIAL LAYER, against //oracle's c10 reference.
#
# WHY, given that every exercise above already has fixtures. The subject's own
# sentence is the reason: "You must complete this exercise by declaring a
# fixed-size array." All four of these are a READ LOOP around a buffer, and a
# read loop is wrong at exactly the sizes nobody commits a fixture for. The
# corpus walks the boundaries around every buffer size people choose -- 4, 8,
# 16, 32, 64, 128, 256, 512, 1024, 4096, and the ~30 000 ex01's subject names --
# testing size-1, size and size+1 at each, and carries content a text fixture
# cannot: NUL bytes, runs of 0xff, a file with no trailing newline, and a file
# that is one enormous line.
#
# Measured against deliberately broken programs: a loop that reads ONCE fails 4
# of 60, and one that writes `strlen(buf)` instead of the byte count fails 22 of
# 60. Neither is visible in a committed text fixture.
#
# The reference itself was cross-checked against the system tools -- 340 cases
# through the real `hexdump -C`, `tail -c` and `cat`, zero mismatches -- and the
# runner was then driven with those same tools standing in for a correct
# student, so the escape, the file materialisation and the comparison are all
# proven end to end rather than assumed.
#
# WHAT IS NOT HERE, and it is deliberate:
#
#   * error messages for ex01, ex02 and ex03. Those are "the same function as
#     the system's tool" and their allowed list adds strerror and basename, but
#     no line of the subject fixes the message FORMAT. ex00's three messages ARE
#     quoted in the subject, and its hand-written cases assert them.
#   * ft_tail with two or more files, which prints `==> path <==` headers. The
#     path is chosen by the runner at run time, so a corpus carrying one would
#     be testing the runner.
#
# `--expect-transform` refuses a corpus whose output never differs from its
# input (which `cat` would pass); `--expect-substring '*'` refuses a hexdump
# corpus that never produces the squeeze line.
#
# The lvl_* tags are written out because _test() is private to defs.bzl and
# these are hand-written sh_tests. `diff` is level 3, so lvl_robust and
# lvl_complete are the cumulative pair.
[
    sh_test(
        name = "ex%s_file_diff" % num,
        size = "medium",
        srcs = ["//tools:file_check.sh"],
        args = [
            "--bin",
            "$(location :ex%s_bin)" % num,
            "--oracle",
            "$(location //oracle:oracle)",
            "--fn",
            fn,
            "--count",
            count,
        ] + extra,
        data = [
            ":ex%s_bin" % num,
            "//oracle:oracle",
            "//tools:file_check.sh",
        ],
        tags = [
            "diff",
            "lvl_complete",
            "lvl_robust",
        ],
    )
    for num, fn, count, extra in [
        ("00", "c10_display_file", "60", []),
        ("01", "c10_cat", "60", []),
        ("02", "c10_tail", "90", ["--expect-transform"]),
        ("03", "c10_hexdump", "90", ["--expect-transform", "--expect-substring", "*"]),
    ]
]
