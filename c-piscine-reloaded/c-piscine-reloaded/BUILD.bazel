# relink, for the reason ex24 has it: the Norm covers this Makefile too. (C 10
# ex00 leaves it off, since its subject does not ask; this project's Makefiles
# are held to the Norm's rule the same way, so both of them are.)
c_make(
    num = "27",
    anchor = "deliverable/ex27/Makefile",
    artifact = "ft_display_file",
    rules = [
        "all",
        "clean",
        "fclean",
    ],
    symbols = ["main"],
    relink = True,
    relink_source = "norm",
)
# strict: "You cannot leave any additional file in your directory" is this
# subject's general rule, and nothing here is reviewed by a person, so an extra
# file is a fail, not a warning -- the binary a hand-run of make leaves behind
# included, which //tools:submit would otherwise push. `make fclean` first.
c_files(
    num = "27",
    required = ["Makefile"],
    strict = True,
    # The subject fixes no source filenames ("files needed for your program"),
    # so every .c and .h here is optional, from the glob the build uses.
    optional = [
        f[len("deliverable/ex27/"):]
        for f in glob(
            [
                "deliverable/ex27/*.c",
                "deliverable/ex27/*.h",
            ],
            allow_empty = True,
        )
    ],
)

# The Piscine's read-loop differential for the same program (see
# c-piscine/c-piscine-c-10/BUILD.bazel for what the corpus walks and why).
sh_test(
    name = "ex27_file_diff",
    size = "medium",
    srcs = ["//tools:file_check.sh"],
    args = [
        "--bin",
        "$(location :ex27_bin)",
        "--oracle",
        "$(location //oracle:oracle)",
        "--fn",
        "c10_display_file",
        "--count",
        "60",
    ],
    data = [
        ":ex27_bin",
        "//oracle:oracle",
        "//tools:file_check.sh",
    ],
    tags = lvl_tags("diff"),
)

c_levels()
