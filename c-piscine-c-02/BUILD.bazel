c_function(num = "09", fn = "ft_strcapitalize", test = "test_strcapitalize.c", allowed = [], labeled = True, clues = "clues.tsv")

# ft_strcapitalize edits its string IN PLACE up to the NUL, inspecting the
# PREVIOUS byte for word boundaries — so it must read no earlier than str[0] nor
# write past the NUL. Under ASan on an EXACTLY strlen+1 heap buffer, any
# off-by-one overflows and is caught here (output diffing can't see it).
c_mem_check(num = "09", fn = "ft_strcapitalize", probe = "mem_strcapitalize.c")

# No libc equivalent: the reference encodes the documented word-capitalize
# contract, cross-checked against a correct standalone impl and guarded by
# in-reference properties (idempotent, length- and alnum-preserving, case-only).
c_diff(num = "09", fn = "ft_strcapitalize", harness = "diff_strcapitalize.c", oracle_fn = "c02_strcapitalize", diff_clues = "diff_clues.txt")

c_function(num = "10", fn = "ft_strlcpy", test = "test_strlcpy.c", allowed = [], labeled = True, clues = "clues.tsv")

c_mem_check(num = "10", fn = "ft_strlcpy", probe = "mem_strlcpy.c")

# glibc lacks strlcpy: the reference is cross-checked vs a correct BSD impl and
# the property ret == strlen(src). Dest prefilled with 0xff to catch a missing
# terminator.
c_diff(num = "10", fn = "ft_strlcpy", harness = "diff_strlcpy.c", oracle_fn = "c02_strlcpy", diff_clues = "diff_clues.txt")

c_function(num = "11", fn = "ft_putstr_non_printable", test = "test_putstr_non_printable.c", allowed = ["write"], labeled = True, clues = "clues.tsv")

# Differential on stdout: the escaped output (printable bytes verbatim, others as
# '\'+2 lowercase hex) is fully deterministic and contains no TAB/NL, so it rides
# as the final field. Cross-checked vs a correct standalone impl.
c_diff(
    num = "11",
    fn = "ft_putstr_non_printable",
    harness = "diff_putstr_non_printable.c",
    oracle_fn = "c02_putstr_non_printable",
    # Lower count: this function write()s one CHARACTER at a time, which is what
    # the subject asks for, so its replay is syscall-bound and dominates the
    # layer's wall time (measured 52s of a 60s budget at 400k under full-suite
    # contention). Each generator emits its pinned contract corners FIRST and
    # only the seeded random tail shrinks, so no boundary case is lost.
    count = 100000,    diff_clues = "diff_clues.txt",
)

c_function(num = "12", fn = "ft_print_memory", test = "test_print_memory.c", allowed = ["write"], sanitize = True, clues = "clues.tsv")

c_mem_check(num = "12", fn = "ft_print_memory", probe = "mem_print_memory.c")

# The layer TODO item 2 was really about. ~83 lines of format -- sixteen bytes a
# row, hex in pairs, a short final row padded to width, non-printables replaced
# -- and its whole correctness evidence was one fixture. A row that pads by one
# space too few, or that treats 0x7f as printable, is invisible in an example
# and immediate here.
#
# The address column is normalised to the row's offset on BOTH sides: the
# subject prints the real address, which no reference can predict and which
# changes between runs. That is the same thing `sanitize` does to this
# exercise's own fixture.
c_diff(
    num = "12",
    fn = "ft_print_memory",
    harness = "diff_print_memory.c",
    oracle_fn = "c02_print_memory",
    diff_clues = "diff_clues.txt",
    # MUST match this exercise's c_function(sanitize = True) above. Without it
    # the gate ran the fixture WITHOUT --sanitize, compared a real address
    # against a fixture written in offsets, and concluded the exercise was red
    # -- so this layer, ex12_diff_asan and ex12_perf all skipped green on a
    # finished, correct ft_print_memory. Reproduced: ex12_output PASSED while
    # ex12_diff printed "SKIP -- this exercise's own output fixture is not
    # passing yet". //tools:conventions now checks the pair repo-wide.
    gate_sanitize = True,
    # The corpus is small blocks, and each case pays for a pipe, a fork-free
    # capture and a read; 100k is what the neighbouring write()-per-character
    # exercise settled on for the same reason.
    count = 100000,
)


