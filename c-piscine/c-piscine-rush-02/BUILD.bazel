load("//tools:defs.bzl", "NORM_NO_WILDCARDS", "c_issued", "c_levels", "c_make", "c_program", "corpus_memory", "exercise", "hand_test", "stderr_ignored", "subject")

# THE SUBJECT CONTRACT (tools/subject.bzl), from the header box on page 6:
# "Turn-in directory: ex00/", "Files to turn in: Makefile and all the necessary
# files". The Makefile is named, everything else is the team's choice -- p.9,
# "You are free to organize your files as you wish, provided you submit the
# mandatory files" -- so every .c and .h is allowed wherever the Makefile says
# (srcs/ and includes/ too): pinning source names here would invent a
# requirement the subject explicitly declines to make. numbers.dict by name:
# it is 42's issued resource, the program's data, and "all the necessary
# files" plainly covers it. It is stripped from the shareable template, which
# `optional` tolerates -- optional means "may be here", not "must be"; that it
# must be is c_issued's test, below, which is red while it is missing and so
# stays out of the files layer, green on a fresh clone.
#
# Strict (the default), because p.9 also says "Submit only the files requested
# by the subject of this project": anything else FAILS -- a rush-02 binary
# left by a hand-run of make is the usual one -- and so does a .c the Makefile
# never compiles, which is not one of "the necessary files": the program's
# build writes the list `make -Bn` gives (c_program below), and ex00_files
# reads it (finding 164). While make cannot plan a build, or the Makefile
# compiles nothing yet, no .c is judged that way. Headers stay allowed
# wherever they are: whether one is necessary cannot be seen without a
# dependency scan.
#
# Graded at a defense: "This assignment is not verified by a program", and
# "The group will be automatically registered for the defense".
subject(
    grader = "defense",
    group = True,
    exercises = {
        "00": exercise(
            page = 6,
            dir = "ex00/",
            files = ["Makefile"],
            optional = ["numbers.dict", "**/*.c", "**/*.h"],
            allowed = ["write", "malloc", "free", "open", "read", "close"],
        ),
    },
)

# ---------------------------------------------------------------------------
# rush-02 — convert a number to its written letter value.
#
# Two independent halves, the same split c-10 uses:
#
#   c_make    proves the TEAM'S Makefile works: `make fclean` then `make`
#             produces ./rush-02, the rules the subject lists are there, and
#             every compile runs cc with the subject's flags.
#   c_program builds the program with Bazel from the sources and -I
#             directories `make -Bn` names, with the harness's own flags, and
#             runs the argv cases. The recipes are read, never run, so a broken
#             Makefile cannot hide behind green output tests, and a wrong
#             program cannot hide behind a working Makefile.
#
# rules = ["rush-02", "clean", "fclean"] is deliberate. p.4 of the subject says
# "a Makefile, which will compile your project using the rules $NAME, clean and
# fclean" -- $NAME being the program, so `make rush-02` has to build it -- and
# p.7 says it is built with `make fclean` then `make`. It never mentions `re` or
# `all`, so requiring either would fail a correct Makefile over a rule nobody
# asked for. graph is left off for the same reason: the incremental-build and
# object-placement checks come from c-09 ex01's subject alone. What clean and
# fclean DO the subject does not say, so that is this repo's convention, at
# robust (ex00_build_rules); that each is there is basic.
#
# recipe: "Your program must compile using cc with the following flags" binds
# the build, and the subject names the Makefile as the build, so every compile
# command it runs is held to it at basic. The Norm's "no *.c, no *.o" is not
# in the subject: ex00_build_wildcards, strict.
# ---------------------------------------------------------------------------

c_make(
    num = "00",
    artifact = "rush-02",
    symbols = ["main"],
    rules = [
        "rush-02",
        "clean",
        "fclean",
    ],
    quotes = {
        "cc": "Rush 02, p.3: \"Your program must compile using cc with the following flags: -Wall -Wextra -Werror.\"",
        "wildcards": NORM_NO_WILDCARDS,
    },
    recipe = "any",
    wildcards = True,
)

# ---------------------------------------------------------------------------
# WHAT THE CASES ASSERT, AND AT WHICH LEVEL. The subject pins four outputs and
# no composition rule: whether 101 reads "one hundred one" or "one hundred
# and one", whether a leading group of one is spelled out and which of
# several decompositions is used are all unstated, and bonus 1 legalises
# "-", "," and "and" on top. So basic asserts what every reading agrees on
# (docs/design.md, "An open question is not an untested one"):
#
#   * The subject's four transcripts ("forty two", "zero", "Error", "one
#     hundred thousand") and its replaced 20, against the harness's own
#     dictionaries.
#   * What the subject states in words, on numbers every reading spells
#     alike: a teen (a key of its own); round numbers in the "<group>
#     <scale>" shape of "one hundred thousand", the group one word other
#     than one -- a million, ten digits past unsigned int ("Your program
#     should handle numbers beyond the range of unsigned int", p.6), forty
#     digits at ref.dict's largest scale; a dictionary whose every value is
#     made up, on the transcripts' numbers ("The values inside it must be
#     used to print the result", p.7).
#   * Both argument forms of p.6. The one-argument form runs as the
#     subject's transcript does -- `./rush-02 42`, from a folder holding
#     numbers.dict, which p.7 greps right there first -- with the harness's
#     own dictionary staged as that numbers.dict, so it never depends on
#     42's copy. A program that opens numbers.dict where it runs and one
#     that opens it beside itself both pass. The two-argument cases name
#     their dictionary, which is what that form is for.
#   * "Error" for a number that is not a valid and positive integer (p.6):
#     the subject's 10.4, an empty argument, a sign, a letter inside.
#   * "Dict Error" for a dictionary that breaks its grammar -- no colon, a
#     key that is no number, a tab inside a value, which is not one of "any
#     printable characters" -- or lacks a unit the number needs (p.7), the
#     whole number's or one in the middle of it, which no other split of
#     the number can stand in for.
#   * What a dictionary may hold (p.7): values holding colons and runs of
#     spaces, trimmed at their ends only, and extra keys shaped like the
#     ones a number needs, before the real ones ("more entries can be
#     added").
#   * Zero and three arguments. The subject names no answer for them
#     ("You must handle errors coherently. You may either print an error
#     message or simply return control to the user"), so these `survive`
#     cases assert only that the program ends by itself: no signal, no
#     hang, no runaway output, whatever it prints.
#
# Where the subject leaves the answer open, a case accepts either (any_of,
# or survive) at basic, and a strict case takes one reading, stated in its
# hints and its row of docs/reference.md: a dictionary with CR LF line
# endings (is a CR one of "the spaces" to trim, or a byte that is not
# printable? dict_crlf_strict); a number past the dictionary's largest scale
# (Dict Error, or a spelling that combines scale words?
# past_dictionary_strict). A zero-padded number ("0042", "00": is it a valid
# and positive integer?) is accepted either way and read at no level.
#
# Past the named cases, two corpora (below) hold every program, at strict,
# to what no reading explains: Error for a valid number, Dict Error from a
# dictionary that can spell it, words that are not the dictionary's.
#
# Every dictionary, argument file and expected output under tests/ex00/ is
# written by //oracle (`rush02_fixtures`), each output as the reference's
# answer to the dictionary and number of the cases that name it, and
# ex00_oracle_fixtures (below) fails when a file differs. Which run a case
# makes is written here alone, so reference = True runs every case as written
# with the reference program in place of the team's (ex00_reference_cases,
# complete): a case whose number, dictionary or run folder no longer gives
# the file it expects fails there, on any tree.
#
# NOT TESTED: the exit status at basic. The subject never states one, for
# any path, so by the Run contract (docs/reference.md) a status is judged
# only at robust: a case the subject answers with an error message it names
# ("Error", "Dict Error") is marked "invalid_input" and its status is judged
# at no level, an any_of or survive case gets none either, and every other
# case gets a robust twin, ex00_<case>_exit, which fails a non-zero return.
# Nor which stream carries "Error" and "Dict Error": every transcript pipes
# stdout through `cat -e`, so stdout is what the subject shows; stderr is
# never mentioned either way.
# ---------------------------------------------------------------------------

# The sources the file-by-file layers read -- norm, both compile layers,
# forbidden symbols -- are the contract's: every .c and .h the team turned in.
# Which of them the program is made of only the Makefile says, so everything
# that has to LINK asks `make -Bn` -- their file list and -I directories, our
# flags -- and a .c it never compiles is not one of "the necessary files":
# ex00_files reports it (the build writes the list it reads). Hard-coding the
# list would move that decision into this file, where it goes stale silently
# the first time anyone renames anything.
#
# `name` is the subject's "Executable name: rush-02": the one-argument cases
# run the program under it, as ./rush-02.
#
# allocfail: ex00_program_allocfail, at robust, replays one_arg_42 with one of
# the program's malloc() calls refused per run -- as that case runs, as
# ./rush-02 beside numbers.dict, which its gate does too (an earlier sweep ran
# it from a folder with no dictionary, so its gate was red on every correct
# program and it SKIPped). The sentence allocfail_rule
# quotes allows any message or none, so it asks only that the run end by
# itself, within its time, with bounded output; no text, no status.
# allocfail_leaks adds ex00_program_allocfail_leaks, because this subject
# states a freeing rule, the one allocfail_leaks_rule quotes (and the valgrind
# arms, as memory_rule): a run that ended by itself must hold nothing at exit,
# as the valgrind arm asks of the plain run. Both at robust: the evaluation's
# memory check never sees a refused allocation, so on this path the rule is
# the repo's to apply (TODO.md §23, WP-92).
_FREE_RULE = ("Rush 02, p.7: \"Any memory allocated on the heap (with malloc(3)) " +
              "must be freed correctly. This will be verified during the evaluation.\"")

c_program(
    num = "00",
    name = "rush-02",
    makefile = True,
    reference = True,
    # The one memory rule a Piscine subject states in its own words: the
