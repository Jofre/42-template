        },
    }),
    # A memcheck twin left out says why (corpus_memory()'s no_valgrind, a tag
    # of its ASan twin), and only for its own corpus.
    "audit-corpus-no-valgrind": contract_problem("audit", {
        "exercises": ["ex00"],
