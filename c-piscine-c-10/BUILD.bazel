c_files(
    num = "00",
    required = ["Makefile"],
    # Every .c and .h in the directory is `optional`, from the same glob the
    # build uses. Without it this layer reports the exercise's own source as
    # "a file the subject did not ask for" -- on a fully conformant turn-in,
    # at level 1, inside the submit gate at every level, so it is printed on
    # every submit. It also destroys the signal the warning exists for: a
    # stray binary left in deliverable/ by a hand-run of `cc -o` is what
    # //tools:submit would push to Vogsphere, and it was indistinguishable
    # from the required source. Same construction as rush-01 ex00, which had
    # this right from the start.
    optional = [
        f[len("deliverable/ex00/"):]
        for f in glob(
            [
                "deliverable/ex00/*.c",
                "deliverable/ex00/*.h",
            ],
            allow_empty = True,
        )
    ],
)
