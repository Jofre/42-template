c_function(num = "06", fn = "ft_str_is_printable", test = "test_str_is_printable.c", labeled = True, clues = "clues.tsv")

c_diff(num = "06", fn = "ft_str_is_printable", harness = "diff_str_is_printable.c", oracle_fn = "c02_str_is_printable", diff_clues = "diff_clues.txt")

c_function(num = "07", fn = "ft_strupcase", test = "test_strupcase.c", labeled = True, clues = "clues.tsv")

# ft_strupcase edits its string IN PLACE up to the NUL. Under ASan on an EXACTLY
# strlen+1 heap buffer, any off-by-one that scans, writes, or re-terminates one
# slot past the NUL overflows and is caught here (the cased text can still look
# right to output diffing).
c_mem_check(num = "07", fn = "ft_strupcase", probe = "mem_strupcase.c")

c_diff(num = "07", fn = "ft_strupcase", harness = "diff_strupcase.c", oracle_fn = "c02_strupcase", diff_clues = "diff_clues.txt")

c_function(num = "08", fn = "ft_strlowcase", test = "test_strlowcase.c", labeled = True, clues = "clues.tsv")

# ft_strlowcase edits its string IN PLACE up to the NUL. Under ASan on an
# EXACTLY strlen+1 heap buffer, any off-by-one that scans, writes, or
# re-terminates one slot past the NUL overflows and is caught here (output
# diffing can't see it).
c_mem_check(num = "08", fn = "ft_strlowcase", probe = "mem_strlowcase.c")

c_diff(num = "08", fn = "ft_strlowcase", harness = "diff_strlowcase.c", oracle_fn = "c02_strlowcase", diff_clues = "diff_clues.txt")

c_function(num = "09", fn = "ft_strcapitalize", test = "test_strcapitalize.c", labeled = True, clues = "clues.tsv")

# ft_strcapitalize edits its string IN PLACE up to the NUL, inspecting the
# PREVIOUS byte for word boundaries — so it must read no earlier than str[0] nor
# write past the NUL. Under ASan on an EXACTLY strlen+1 heap buffer, any
# off-by-one overflows and is caught here (output diffing can't see it).
c_mem_check(num = "09", fn = "ft_strcapitalize", probe = "mem_strcapitalize.c")

# No libc equivalent: the reference encodes the documented word-capitalize
# contract, cross-checked against a correct standalone impl and guarded by
# in-reference properties (idempotent, length- and alnum-preserving, case-only).
#
# readings: a word is "a sequence of alphanumeric characters" (p.17), and the
# subject names no byte above 0x7f. The diff corpus holds only strings both
# readings capitalize alike (bytes above 0x7f among them, where they decide
# nothing), and the strings they part on -- a letter right after such a
# byte -- are ex09_readings', at strict, whose own hints state the reading
# it tests. Its ASan twin keeps them under the sanitizer.
c_diff(
    num = "09",
    fn = "ft_strcapitalize",
    harness = "diff_strcapitalize.c",
    oracle_fn = "c02_strcapitalize",
    diff_clues = "diff_clues.txt",
    readings = {"oracle_fn": "c02_strcapitalize_readings", "diff_clues": "diff_clues_readings.txt"},
)

c_function(num = "10", fn = "ft_strlcpy", test = "test_strlcpy.c", labeled = True, escaped_values = True, clues = "clues.tsv")

c_mem_check(num = "10", fn = "ft_strlcpy", probe = "mem_strlcpy.c")

# glibc lacks strlcpy: the reference is cross-checked vs a correct BSD impl and
# against the return value man strlcpy defines. Dest prefilled with 0xff to
# catch a missing terminator.
c_diff(num = "10", fn = "ft_strlcpy", harness = "diff_strlcpy.c", oracle_fn = "c02_strlcpy", diff_clues = "diff_clues.txt")

c_function(num = "11", fn = "ft_putstr_non_printable", test = "test_putstr_non_printable.c", labeled = True, clues = "clues.tsv")

# Differential on stdout: the escaped output (printable bytes verbatim, others as
# '\'+2 lowercase hex) is fully deterministic and contains no TAB/NL, so it rides
# as the final field. Cross-checked vs a correct standalone impl.
c_diff(
    num = "11",
    fn = "ft_putstr_non_printable",
    harness = "diff_putstr_non_printable.c",
    oracle_fn = "c02_putstr_non_printable",
    # Lower count: this function write()s one CHARACTER at a time, which is what
    # the subject asks for, so its replay is syscall-bound and dominates the
    # layer's wall time (measured 52s of a 60s budget at 400k under full-suite
    # contention). Each generator emits its pinned contract corners FIRST and
    # only the seeded random tail shrinks, so no boundary case is lost.
    # 200000, not 100000: as many as the ASan twin replays, so each case it
    # checks for memory is value-checked here too (V34, the owner's choice,
    # 2026-10-04); c_diff refuses a twin larger than its plain replay.
    count = 200000,    diff_clues = "diff_clues.txt",
)

# sanitize: the address column moves with ASLR, so test_print_memory.c
# publishes each address it passes ("@addr" and 16 hex digits, on a line of its
# own) and the runner holds every row of that dump to it before showing it as
# an offset: "The hexadecimal address of the first character in the line"
# (C 02 p.20) is checked at basic, like "It should return addr." (p.21), whose
# flag the size-0 call prints too (findings 048, 050).
c_function(num = "12", fn = "ft_print_memory", test = "test_print_memory.c", sanitize = True, clues = "clues.tsv")

c_mem_check(num = "12", fn = "ft_print_memory", probe = "mem_print_memory.c")

# The layer TODO item 2 was really about. ~83 lines of format -- sixteen bytes a
# row, hex in pairs, a short final row padded to width, non-printables replaced
# -- and its whole correctness evidence was one fixture. A row that pads by one
# space too few, or that treats 0x7f as printable, is invisible in an example
# and immediate here.
#
# The address column is normalised to the row's offset on BOTH sides: the
# subject prints the real address, which no reference can predict and which
# changes between runs. Both sides check it first: the harness knows the
# address it passed and keeps a wrong one as printed, as `sanitize` does with
# the addresses this exercise's own fixture publishes (finding 048). The last
# column is whether the function returned addr (finding 050).
#
# Where the harness puts the block decides whether a narrowed address shows:
# below 4 GiB, an address cut to 32 bits is the real one. So the block is
# moved above 4 GiB before each call (the harness says how), and
# //tools/tests's selftest builds the harness as this one is built, over a toy
# that prints its argument cut to 32 bits, so the file is visible to it.
exports_files(
    ["tests/ex12/diff_print_memory.c"],
    visibility = ["//tools/tests:__pkg__"],
)

c_diff(
    num = "12",
    fn = "ft_print_memory",
    harness = "diff_print_memory.c",
    oracle_fn = "c02_print_memory",
    diff_clues = "diff_clues.txt",
    # MUST match this exercise's c_function(sanitize = True) above. Without it
    # the gate ran the fixture WITHOUT --sanitize, compared a real address
    # against a fixture written in offsets, and concluded the exercise was red
    # -- so this layer, ex12_diff_asan and ex12_perf all skipped green on a
    # finished, correct ft_print_memory. Reproduced: ex12_output PASSED while
    # ex12_diff printed "SKIP -- this exercise's own output fixture is not
    # passing yet". //tools:conventions now checks the pair repo-wide.
    gate_sanitize = True,
    # The corpus is small blocks, and each case pays for a pipe, a fork-free
    # capture and a read; 100k is what the neighbouring write()-per-character
    # exercise settled on for the same reason.
    # 200000, not 100000: as many as the ASan twin replays, so each case it
    # checks for memory is value-checked here too (V34, the owner's choice,
    # 2026-10-04); c_diff refuses a twin larger than its plain replay.
    count = 200000,
    # medium (300 s), not small (60 s): ex12_diff_asan replays 200000 cases
    # under the sanitizer, and on one correct answer it took 23 s alone, 36 s
    # in a full suite and 53 s on a loaded machine (2026-10-02/03); with two
    # suites on the machine, 22.5 s (diff) and 40.1 s (diff_asan), two thirds
    # of small's 60 (finding 066) -- a correct program a few seconds from a
    # red timeout. The runner's own budget still stops a loop that never
    # ends, and says so.
    size = "medium",
)

