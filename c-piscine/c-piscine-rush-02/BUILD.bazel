    # And a dictionary that breaks its grammar, the Dict Error path:
    # ex00_dict_nocolon_program_allocfail(_leaks), held to the same rules
    # as the run that converts.
    allocfail = [
        "one_arg_42",
        "dict_nocolon",
    ],
    allocfail_rule = "The subject: \"You must handle errors coherently. You may either " +
                     "print an error message or simply return control to the user.\"",
    allocfail_leaks = True,
    allocfail_leaks_rule = _FREE_RULE,
    cases = [
