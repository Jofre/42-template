        "--nm-lib",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/lib/x86_64-linux-gnu/libbfd-2.38-system.so)",
        # The pinned valgrind. The two cycles runners require it now, so without
        # it every arm here would exit 2 on the wiring instead of reaching the
        # skip or the refusal it was written to check.
        "--valgrind",
        "$(rootpath @valgrind_ubuntu//:usr/bin/valgrind.bin)",
        "--valgrind-callgrind-tools",
        "$(rootpath @valgrind_ubuntu//:usr/libexec/valgrind/callgrind-amd64-linux)",
        # The pinned shellcheck. Two runners take one now: shell_test.sh's norm
        # mode, which grades the shell modules, and conventions.sh. Both refuse
        # to fall back to a host copy, so the selftest has to hand one over the
        # same way Bazel does or those arms would only ever exercise the refusal.
        "--shellcheck",
        "$(rootpath @shellcheck_linux_x86_64//:shellcheck)",
        # The pinned clang and the libraries it loads. prototype_check.sh's
        # --names mode reads clang's AST dump, and the compiler on PATH may be
        # a gcc (it is on some campus boxes), so its arms take the one every
        # layer is built with, as Bazel hands it over.
        "--clang",
        "$(rootpath @clang_12_ubuntu//:usr/lib/llvm-12/bin/clang-12)",
        "--clang-lib",
        "$(rootpath @clang_12_ubuntu//:usr/lib/llvm-12/lib/libclang-cpp.so.12)",
        "--clang-lib",
        "$(rootpath @clang_12_ubuntu//:usr/lib/x86_64-linux-gnu/libLLVM-12.so.1)",
        # The pinned gcc, for the method layer's --fixed-array arms: only gcc
        # names an object by its size (-Wlarger-than=), and the arms prove the
        # runner on the compiler every exNN_fixed_array target is handed.
        "--gcc",
        "$(rootpath @gcc_10_ubuntu//:usr/bin/x86_64-linux-gnu-gcc-10)",
        # The pinned llvm-symbolizer and the library it loads, handed to the
        # sanitizer runners' arms as defs_toolchain.bzl hands them to every layer.
        "--symbolizer",
        "$(rootpath @clang_12_ubuntu//:usr/lib/llvm-12/bin/llvm-symbolizer)",
        "--symbolizer-lib",
        "$(rootpath @clang_12_ubuntu//:usr/lib/x86_64-linux-gnu/libLLVM-12.so.1)",
        # The pinned ld.bfd and a library beside the libbfd it loads, for the
        # runners that link what they compile (asan_check, allocfail_check,
        # cycles_check, ref_compare, header_check, method_check --expect), as
        # tools/defs_toolchain.bzl hands them over (_pinned_ld_args).
        "--ld",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-ld.bfd)",
        "--ld-lib",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/lib/x86_64-linux-gnu/libbfd-2.38-system.so)",
        # The pinned objdump, for forbidden_symbols.sh --function, which takes
        # one with no PATH fallback, as it takes nm. Its libraries are nm's.
        "--objdump",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-objdump)",
        # The pinned assembler gcc shells out to, for compile_check.sh's
        # --cc-progs arms: that it loads its libbfd and libopcodes from the
        # fetched tree, and that one which cannot start is the harness's
        # refusal and never the student's FAIL (TO VERIFY V228). Its
        # libraries are --nm-lib's.
        "--as",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-as)",
        # The pinned ar and ranlib, for make_test.sh's pinned arms: with the
        # build above, gcc-10 and as, what tools/defs_toolchain.bzl hands every
        # make_test.sh test (_pinned_make_args, TO VERIFY V60). Their
        # libraries are --ld-lib's.
        "--ar",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-ar)",
        "--ranlib",
        "$(rootpath @binutils_x86_64_linux_gnu//:usr/bin/x86_64-linux-gnu-ranlib)",
        # The fetched python3, which //tools:env_drift's launcher runs
        # tools/env_drift.py on, handed to its arms as that target hands it.
        "--python",
        "$(rootpath @python_3_13_1//:python3)",
]

