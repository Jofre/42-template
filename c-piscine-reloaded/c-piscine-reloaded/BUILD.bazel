# Piscine Reloaded: ONE project, ONE Vogsphere repository, ex00 ... ex27 at its
# root. It is a best-of of the Piscine, and its tests are the Piscine's own.
# The shell and file exercises (ex00-ex05) ask what a Piscine exercise asks,
# so they READ that exercise's tests, named by twin_of on each call: one
# copy, and a fix to it reaches both projects. The copies they replaced drifted
# -- a fix reached one of two check scripts, the other kept the bug. The C
# exercises' tests are still copied from the exercise each one repeats (named
# beside every call), because they differ where the subject does: ft_putchar
# in place of write, a header of the exercise's own.
#
# It mixes three kinds of exercise, each handled the way the Piscine already
# handles it:
#   ex00-ex05  shell and file turn-ins. The answer is generators/exNN.sh, and
#              deliverable/exNN/ is generated from it and gitignored PER
#              EXERCISE (.gitignore here) -- an archive's permissions and
#              timestamps, and ex05's file name, cannot live in git.
#   ex06-ex23, ex25-ex27  C, headers and programs, written in deliverable/exNN.
#   ex24, ex27 a Makefile.
#
# ft_putchar. The subject: "If ft_putchar() is an authorized function, we will
# compile your code with our ft_putchar.c." Six exercises authorise it (ex06,
# 07, 08, 15, 18, 19). Their stubs declare it -- `void ft_putchar(char c);` --
# and never define it, and every build of their code here links
# tests/ft_putchar.c (the contract's `provided`), as the Moulinette links its own.
# Layers that judge the student's file alone (norm, compile, forbidden,
# prototype, symbols) never see it, so a call to ft_putchar is an authorised
# undefined symbol there, and `write` is not authorised at all. An ft_putchar.c
# turned in by mistake is an extra file, which the files layer fails.
#
# Layers the Piscine runs that are NOT here: c_reference_cost and c_cycles for
# the ft_putchar exercises. Their budgets were measured on answers that call
# write() directly, and a correct answer here pays for one ft_putchar call per
# character; a budget it cannot meet would red correct work.

# Rebuild the generated shell deliverables (ex00-ex05) from the generators:
#   bazel run //c-piscine-reloaded/c-piscine-reloaded:generate
sh_binary(
    name = "generate",
    srcs = ["//tools:generate.sh"],
    args = [package_name()],
)

PUTCHAR = {"tests/ft_putchar.c": "ft_putchar.c"}

# THE SUBJECT CONTRACT (tools/subject.bzl), from each exercise's header box.
# "Your exercises will only be checked and graded by a program called
# Moulinette", and "You cannot leave any additional file in your directory
# than those specified in the subject": strict, the default.
subject(
    grader = "moulinette",
    group = False,
    exercises = {
        "00": exercise(page = 9, dir = "ex00/", files = ["exo.tar"], allowed = []),
        "01": exercise(page = 10, dir = "ex01/", files = ["z"], allowed = []),
        "02": exercise(page = 11, dir = "ex02/", files = ["clean"], allowed = []),
        "03": exercise(page = 12, dir = "ex03/", files = ["find_sh.sh"], allowed = []),
        "04": exercise(page = 13, dir = "ex04/", files = ["MAC.sh"], allowed = []),
        # files = None: the file's NAME is the exercise (Shell 01 ex05's), so
        # writing it down here would hand it over; see shell_exercise.
        "05": exercise(page = 14, dir = "ex05/", files = None, allowed = []),
        "06": exercise(page = 15, dir = "ex06/", files = ["ft_print_alphabet.c"], allowed = ["ft_putchar"], provided = PUTCHAR),
        "07": exercise(page = 16, dir = "ex07/", files = ["ft_print_numbers.c"], allowed = ["ft_putchar"], provided = PUTCHAR),
        "08": exercise(page = 17, dir = "ex08/", files = ["ft_is_negative.c"], allowed = ["ft_putchar"], provided = PUTCHAR),
        "09": exercise(page = 18, dir = "ex09/", files = ["ft_ft.c"], allowed = []),
        "10": exercise(page = 19, dir = "ex10/", files = ["ft_swap.c"], allowed = []),
        "11": exercise(page = 20, dir = "ex11/", files = ["ft_div_mod.c"], allowed = []),
        "12": exercise(page = 21, dir = "ex12/", files = ["ft_iterative_factorial.c"], allowed = []),
        "13": exercise(page = 22, dir = "ex13/", files = ["ft_recursive_factorial.c"], allowed = []),
        "14": exercise(page = 23, dir = "ex14/", files = ["ft_sqrt.c"], allowed = []),
        "15": exercise(page = 24, dir = "ex15/", files = ["ft_putstr.c"], allowed = ["ft_putchar"], provided = PUTCHAR),
        "16": exercise(page = 25, dir = "ex16/", files = ["ft_strlen.c"], allowed = []),
        "17": exercise(page = 26, dir = "ex17/", files = ["ft_strcmp.c"], allowed = []),
        "18": exercise(page = 27, dir = "ex18/", files = ["ft_print_params.c"], allowed = ["ft_putchar"], provided = PUTCHAR),
        "19": exercise(page = 28, dir = "ex19/", files = ["ft_sort_params.c"], allowed = ["ft_putchar"], provided = PUTCHAR),
        "20": exercise(page = 29, dir = "ex20/", files = ["ft_strdup.c"], allowed = ["malloc"]),
        "21": exercise(page = 30, dir = "ex21/", files = ["ft_range.c"], allowed = ["malloc"]),
        "22": exercise(page = 31, dir = "ex22/", files = ["ft_abs.h"], allowed = []),
        "23": exercise(page = 32, dir = "ex23/", files = ["ft_point.h"], allowed = []),
        # ex24 -- the Makefile, and nothing else: "We'll only fetch your Makefile
        # and test it with our files." The grader's files are tests/ex24/grader/:
        # the five sources the subject names (PLACEHOLDERS that compile -- this
        # exercise grades the Makefile, and a real body would be another
        # exercise's answer), their header, and a decoy source a Makefile must
        # never compile, because the Norm says every source is named explicitly
        # ("no *.c").
        "24": exercise(
            page = 33,
            dir = "ex24/",
            files = ["Makefile"],
            allowed = [],
            provided = {
                "tests/ex24/grader/includes/ft.h": "includes/ft.h",
                "tests/ex24/grader/srcs/ft_not_listed.c": "srcs/ft_not_listed.c",
                "tests/ex24/grader/srcs/ft_putchar.c": "srcs/ft_putchar.c",
                "tests/ex24/grader/srcs/ft_putstr.c": "srcs/ft_putstr.c",
                "tests/ex24/grader/srcs/ft_strcmp.c": "srcs/ft_strcmp.c",
                "tests/ex24/grader/srcs/ft_strlen.c": "srcs/ft_strlen.c",
                "tests/ex24/grader/srcs/ft_swap.c": "srcs/ft_swap.c",
            },
        ),
        "25": exercise(page = 34, dir = "ex25/", files = ["ft_foreach.c"], allowed = []),
        "26": exercise(page = 35, dir = "ex26/", files = ["ft_count_if.c"], allowed = []),
        # ex27 fixes no source filenames ("Makefile, and files needed for your
        # program"), so every .c and .h here is optional, in a subfolder too
        # (the Makefile says where its sources lie), less a .c it never
        # compiles. strict all the same: "You cannot leave any additional
        # file in your directory" is this subject's general rule, and nothing
        # here is reviewed by a person, so an extra file is a fail, not a
        # warning -- the binary a hand-run of make leaves behind included,
        # which //tools:submit would otherwise push. `make fclean` first.
        "27": exercise(
            page = 36,
            dir = "ex27/",
            files = ["Makefile"],
            optional = ["**/*.c", "**/*.h"],
            allowed = ["close", "open", "read", "write"],
        ),
    },
)

# ---------------------------------------------------------------- shell / file
# Each call below names the exercise it repeats in twin_of, and its tests are
# read from there (see shell_exercise in //tools:defs.bzl). The rest of the
# call is the twin's own call again -- mode, readings, oracle, stable, tags --
# and only the deliverable's name and the subject's own words (wording) may
# differ; //tools:conventions compares the two. tests/exNN/ here holds only a
# README pointing at them, and exNN_twin fails on anything else put there.

# ex00 = Shell 00 ex02. The archive is exo.tar here, not exo2.tar -- the one
# difference, and the check reads the name from the contract's `files`. The subject's
# sentence about the year is worded differently and says the same thing. Its
# literal reading at strict, as there.
shell_exercise(
    num = "00",
    mode = "check",
    readings = {"literal": "literal.sh"},
    stable = False,
    twin_of = "//c-piscine/c-piscine-shell-00:ex02",
)

# ex01 = Shell 00 ex00
shell_exercise(
    num = "01",
    mode = "diff",
    twin_of = "//c-piscine/c-piscine-shell-00:ex00",
)

# ex02 = Shell 00 ex08, with its two readings at strict as there, of "no ';'"
# and of "all files".
shell_exercise(
    num = "02",
    mode = "check",
    readings = {
        "literal": "literal.sh",
        "regular": "regular.sh",
    },
    script = "sh",
    stable = False,
    twin_of = "//c-piscine/c-piscine-shell-00:ex08",
)

# ex03 = Shell 01 ex02, with its reading at strict as there. This subject says
# "all file names that end with ".sh"" where Shell 01's says "all files
# ending with .sh". Whether a directory's name is one of those file names is
# as open as whether a directory is one of those files, so the one reading
# serves both. The words differ, so they are this call's own (wording), and
# regular.sh quotes this subject's.
shell_exercise(
    num = "03",
    mode = "check",
    readings = {"regular": "regular.sh"},
    script = "./name",
    stable = False,
    twin_of = "//c-piscine/c-piscine-shell-01:ex02",
    wording = {"files": "all file names that end with \".sh\""},
)

# ex04 = Shell 01 ex04, called the way its twin is: checked at basic on every
# machine, with a SKIP for what MAC.sh prints where the machine has nothing
# to show (see Shell 01's BUILD file); the output layer and the literal
# reading run outside the sandbox (run_tags), the files layer does not need to.
#
# oracle = True: whether each printed line is one of this machine's hardware
# addresses is asked of //oracle (shell01_hwaddr), as in Shell 01 ex04 -- the
# text pattern a check could use instead is a piece of a common answer. Its
# reading of the loopback's all-zero address at strict, as there.
shell_exercise(
    num = "04",
    mode = "check",
    oracle = True,
    readings = {"literal": "literal.sh"},
    script = "sh",
    stable = False,
    tags = ["env"],
    run_tags = ["no-sandbox"],
    twin_of = "//c-piscine/c-piscine-shell-01:ex04",
)

# ex05 = Shell 01 ex05: no files layer, since the deliverable's NAME is the
# answer (its contract entry has files = None).
shell_exercise(
    num = "05",
    mode = "check",
    stable = False,
    twin_of = "//c-piscine/c-piscine-shell-01:ex05",
)

