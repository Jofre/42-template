c_program(
    num = "02",
    name = "ft_tail",
    malloc = True,
    allowed = [
        "open",
        "read",
        "write",
        "close",
        "malloc",
        "free",
        "strerror",
        "basename",
    ],
    cases = [
        {
            "name": "cbytes",
            "args": ["-c", "20", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "cbytes.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "cbig",
            "args": ["-c", "100000", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "cbig.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "czero",
            "args": ["-c", "0", "$(location tests/ex02/fixtures/sample.txt)"],
            "fixtures": ["tests/ex02/fixtures/sample.txt"],
            "expected": "czero.txt",
            "clues": "clues.tsv",
        },
        {
            "name": "cbin",
            "args": ["-c", "10", "$(location tests/ex02/fixtures/bin.dat)"],
            "fixtures": ["tests/ex02/fixtures/bin.dat"],
            "expected": "cbin.txt",
            "clues": "clues.tsv",
        },
        # Multiple FILEs: tail prints a "==> name <==" header per file, with a
        # blank line before the second and later headers.
        {
            "name": "cmulti",
            "args": [
                "-c",
                "15",
                "$(location tests/ex02/fixtures/multi_a.txt)",
                "$(location tests/ex02/fixtures/multi_b.txt)",
            ],
            "fixtures": [
                "tests/ex02/fixtures/multi_a.txt",
                "tests/ex02/fixtures/multi_b.txt",
            ],
            "expected": "cmulti.txt",
            "clues": "clues.tsv",
        },
        # A file larger than one read buffer (~148 KiB). This catches the
        # program that calls read() exactly ONCE and stops: it tails the wrong
        # bytes because it never saw the end of the file. It does NOT catch the
        # program that loops correctly but keeps no state -- see `ccarry`.
        {
            "name": "clarge",
            "args": ["-c", "20", "$(location tests/ex02/fixtures/big.txt)"],
            "fixtures": ["tests/ex02/fixtures/big.txt"],
            "expected": "clarge.txt",
            "clues": "clues.tsv",
        },
        # The count that cannot be answered out of ONE chunk.
        #
        # Why this case exists: `clarge` above is blind to the most natural way
        # to get ft_tail wrong -- loop over read() but, on each iteration, throw
        # away everything except the last N bytes of the chunk you just read.
        # That is arithmetic, not luck. big.txt is 151552 bytes = 37 * 4096, so
        # 1024/2048/4096 divide it exactly and the final chunk is a full buffer;
        # the awkward sizes leave remainders (6552 at 29000, 20480 at 65536)
        # that are still far larger than 20. Either way the last 20 bytes of the
        # file lie WHOLLY INSIDE the final chunk, so the state-less program and
        # the correct one print the same bytes. Verified: a model of exactly
        # that bug is byte-identical to clarge.txt at BUF = 1024, 4096, 8192,
        # 29000 and 65536.
        #
        # 40000 is above every one of those final-chunk sizes, so the answer
        # provably spans a read boundary: no single chunk contains it, and
        # `allowed` holds no lseek to go back for it, so the program can only
        # get it right if it kept something from the reads it had already done.
        # That is the single question tests/ex02/clues.tsv asks, and until now
        # no layer could tell whether the student had answered it or dodged it.
        # (Deliberately not spelled out here: HOW to keep it. The fixture does
        # not reveal the method and neither should the harness -- AGENTS.md §0.)
        #
        # Known limit, so nobody mistakes this for a total test. The bug hides
        # again whenever the file's LAST chunk is on its own >= 40000 bytes,
        # i.e. whenever (151552 % BUF, or BUF when it divides) >= 40000. That
        # is not a "buffer bigger than half the file" rule -- the escaping
        # sizes are scattered, because they depend on the remainder. Brute
        # forced over every buffer size against this fixture: nothing below
        # 50518 bytes escapes, and every power-of-two buffer from 512 B to
        # 128 KiB is caught (their final chunks run 512..20480). So the case
        # covers the whole range a read loop is realistically written in;
        # closing the rest would need a bigger fixture and buy very little.
        # Keep this paragraph honest if the fixture or the count ever changes,
        # and re-derive it -- the numbers above are specific to both.
        #
        # ccarry.txt was cut from the fixture already in the tree with the tool
        # the exercise imitates: `tail -c 40000 tests/ex02/fixtures/big.txt`
        # (GNU coreutils 8.32), the same generator that reproduces all six
        # other fixtures in this exercise byte-for-byte, cmulti included.
        {
            "name": "ccarry",
            "args": ["-c", "40000", "$(location tests/ex02/fixtures/big.txt)"],
            "fixtures": ["tests/ex02/fixtures/big.txt"],
            "expected": "ccarry.txt",
            "clues": "clues.tsv",
        },
    ],
)

