# ex24 — the Makefile, and nothing else: "We'll only fetch your Makefile and
# test it with our files." The grader's files are tests/ex24/grader/: the five
# sources the subject names (PLACEHOLDERS that compile -- this layer grades the
# Makefile, and a real body would be another exercise's answer), their header,
# and a decoy source a Makefile must never compile, because the Norm says every
# source is named explicitly ("no *.c"). relink: the Norm again -- a Makefile
# that relinks when it has nothing to do makes the project non-functional.
c_make(
    num = "24",
    anchor = "deliverable/ex24/Makefile",
    artifact = "libft.a",
    rules = ["all", "clean", "fclean", "re"],
    symbols = ["ft_putchar", "ft_putstr", "ft_strcmp", "ft_strlen", "ft_swap"],
    relink = True,
    relink_source = "norm",
    overlay = {
        "tests/ex24/grader/includes/ft.h": "includes/ft.h",
        "tests/ex24/grader/srcs/ft_not_listed.c": "srcs/ft_not_listed.c",
        "tests/ex24/grader/srcs/ft_putchar.c": "srcs/ft_putchar.c",
        "tests/ex24/grader/srcs/ft_putstr.c": "srcs/ft_putstr.c",
