NAME = libtoyfmt.a

all: $(NAME)

$(NAME):
	@echo "TODO: build $(NAME) from toy_fmt.c"

bonus:
	@echo "TODO: build the bonus into $(NAME)"

clean:
	@echo "TODO: remove the object files"

fclean: clean
	@echo "TODO: remove $(NAME)"

re: fclean all

.PHONY: all bonus clean fclean re
